# AutoRepairOS standalone Windows executable settings.
# Edit the .env file beside start.cmd, then double-click start.cmd.

# Listen port; open http://localhost:<PORT>/login in your browser.
PORT=8080

# First run only: set a strong password below, then disable seed after login.
RUN_SEED=true
DEFAULT_OWNER_USERNAME=owner
DEFAULT_OWNER_PASSWORD=

# Optional display name.
APP_NAME=AutoRepair OS

# Keep the default SQLite file in the install folder's data directory.
DB_PATH=file:data/autorepair.db?_busy_timeout=5000
DB_ENABLE_WAL=false

# Optional integrations; leave empty to keep them disabled.
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_TOKEN=
LINE_BASE_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BASE_URL=
