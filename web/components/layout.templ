package components

import (
	"autorepairos/internal/nav"
	"autorepairos/internal/session"
)

// Layout 全站共用版面：header + nav + main。
templ Layout(title, active, username, role, appName string) {
	<!DOCTYPE html>
	<html lang="zh-Hant">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } - { appName }</title>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/htmx.min.js"></script>
			<script src="/static/html5-qrcode.min.js"></script>
		</head>
		<body hx-headers={ `{"X-CSRF-Token":"` + session.CSRFTokenFromContext(ctx) + `"}` }>
			<header>
				<h1>🔧 { appName }</h1>
				<div class="user">
					登入中：<code>{ username }</code>
					<span class="badge">{ role }</span>
					<form method="POST" action="/logout" style="display:inline">
						@CSRFInput()
						<button class="logout" type="submit">登出</button>
					</form>
				</div>
			</header>
			<div class="shell">
				<main>
					{ children... }
				</main>
				<nav>
					@NavItems(active)
				</nav>
			</div>
		</body>
	</html>
}

templ CSRFInput() {
	<input type="hidden" name="_csrf" value={ session.CSRFTokenFromContext(ctx) }/>
}

// NavItems 側邊導覽列。
//
// 選單的單一定義來源是 internal/nav（Routes + Render），renderPage（首頁等
// 字串拼接頁）與這裡都呼叫它，兩邊不會再走音。新增/調整選單只改 internal/nav。
templ NavItems(active string) {
	@templ.Raw(nav.Render(active))
}
