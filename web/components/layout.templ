package components

// Layout 全站共用版面：header + nav + main。
templ Layout(title, active, username, role, appName string) {
	<!DOCTYPE html>
	<html lang="zh-Hant">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } - { appName }</title>
			<script src="https://unpkg.com/htmx.org@2.0.4"></script>
			@PageStyle()
		</head>
		<body>
			<header>
				<h1>🔧 { appName }</h1>
				<div class="user">
					登入中：<code>{ username }</code>
					<span class="badge">{ role }</span>
					<a href="/logout" class="logout">登出</a>
				</div>
			</header>
			<nav>
				@NavItems(active)
			</nav>
			<main>
				{ children... }
			</main>
		</body>
	</html>
}

// NavItems 側邊導覽列。
templ NavItems(active string) {
	<a href="/" class={ templ.KV("on", active == "/") }>總覽</a>
	<a href="/customers" class={ templ.KV("on", active == "/customers") }>客戶</a>
	<a href="/vehicles" class={ templ.KV("on", active == "/vehicles") }>車輛</a>
	<a href="/work-orders" class={ templ.KV("on", active == "/work-orders") }>工單</a>
	<a href="/insurance-companies" class={ templ.KV("on", active == "/insurance-companies") }>保險公司</a>
	<a href="/receivables" class={ templ.KV("on", active == "/receivables") }>收款</a>
	<a href="/inventory" class={ templ.KV("on", active == "/inventory") }>庫存</a>
	<a href="/suppliers" class={ templ.KV("on", active == "/suppliers") }>廠商</a>
	<a href="/staff" class={ templ.KV("on", active == "/staff") }>員工</a>
	<a href="/insurances" class={ templ.KV("on", active == "/insurances") }>投保</a>
	<a href="/inspections" class={ templ.KV("on", active == "/inspections") }>定檢</a>
	<a href="/maintenance-templates" class={ templ.KV("on", active == "/maintenance-templates") }>保養套餐</a>
	<a href="/technicians/commissions" class={ templ.KV("on", active == "/technicians/commissions") }>技師佣金</a>
	<a href="/expenses" class={ templ.KV("on", active == "/expenses") }>支出</a>
	<a href="/reports" class={ templ.KV("on", active == "/reports") }>報表</a>
	<a href="/lookup" class={ templ.KV("on", active == "/lookup") }>代碼對照</a>
	<a href="/scheduled-tasks" class={ templ.KV("on", active == "/scheduled-tasks") }>排程</a>
	<a href="/appointments" class={ templ.KV("on", active == "/appointments") }>預約</a>
	<a href="/subcontracts" class={ templ.KV("on", active == "/subcontracts") }>外包</a>
	<a href="/equipment" class={ templ.KV("on", active == "/equipment") }>設備</a>
}

// PageStyle 全站 CSS（含 responsive）。
templ PageStyle() {
	<style>
		* { box-sizing: border-box; }
		body { margin: 0; font-family: "Segoe UI", "Microsoft JhengHei", sans-serif; background: #0f172a; color: #e2e8f0; }
		a { color: #38bdf8; }
		header { background: #1e293b; padding: 14px 28px; border-bottom: 2px solid #334155; display: flex; align-items: center; justify-content: space-between; }
		header h1 { margin: 0; font-size: 20px; }
		.user { font-size: 13px; color: #cbd5e1; }
		.badge { background: #38bdf8; color: #0f172a; padding: 2px 10px; border-radius: 999px; font-weight: 700; font-size: 11px; }
		.logout { margin-left: 14px; padding: 6px 14px; background: #ef4444; color: #fff; border-radius: 8px; text-decoration: none; font-weight: 700; font-size: 12px; }
		nav { background: #111c33; padding: 0 28px; display: flex; gap: 4px; border-bottom: 1px solid #334155; overflow-x: auto; }
		nav a { padding: 11px 16px; color: #94a3b8; text-decoration: none; font-size: 14px; border-bottom: 2px solid transparent; white-space: nowrap; }
		nav a:hover { color: #e2e8f0; }
		nav a.on { color: #38bdf8; border-bottom-color: #38bdf8; font-weight: 700; }
		main { padding: 24px 28px; }
		.card { background: #1e293b; border: 1px solid #334155; border-radius: 12px; padding: 20px; margin-bottom: 18px; }
		.card h2 { margin: 0 0 14px 0; color: #38bdf8; font-size: 17px; }
		table { width: 100%; border-collapse: collapse; }
		th, td { text-align: left; padding: 9px 10px; border-bottom: 1px solid #334155; font-size: 13.5px; }
		th { color: #94a3b8; font-weight: 600; }
		tr:hover td { background: #263449; }
		.stat { display: inline-block; margin: 0 32px 12px 0; text-decoration: none; }
		.stat b { font-size: 26px; color: #f8fafc; display: block; }
		.stat span { color: #94a3b8; font-size: 12px; }
		.pill { padding: 2px 9px; border-radius: 999px; font-size: 11.5px; font-weight: 700; }
		.btn { display: inline-block; padding: 6px 13px; border-radius: 7px; font-size: 12.5px; text-decoration: none; font-weight: 600; border: 0; cursor: pointer; }
		.btn-p { background: #38bdf8; color: #0f172a; }
		.btn-s { background: #334155; color: #e2e8f0; }
		.btn-d { background: #7f1d1d; color: #fecaca; }
		.btn-o { background: #92400e; color: #fde68a; }
		@media (max-width: 768px) {
			header { padding: 10px 14px; }
			header h1 { font-size: 16px; }
			nav { padding: 0 8px; }
			nav a { padding: 9px 10px; font-size: 12px; }
			main { padding: 14px 10px; }
			.card { padding: 14px; margin-bottom: 12px; }
			table { font-size: 12px; }
			th, td { padding: 6px 4px; font-size: 12px; }
			.stat { display: block; margin: 0 0 12px 0; }
		}
	</style>
}
