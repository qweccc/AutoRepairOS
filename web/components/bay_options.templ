package components

import (
	"strings"

	"autorepairos/internal/i18n"
)

type BayOption struct {
	Code  string
	Label string
}

templ BayOptions(selected string, options []BayOption, legacy bool) {
	<option value="">{ i18n.T(ctx, "appointment.bay_empty_option") }</option>
	{{ normalized := strings.ToUpper(selected) }}
	for _, option := range options {
		<option value={ option.Code } selected?={ normalized == option.Code }>{ option.Label }（{ option.Code }）</option>
	}
	if legacy {
		<option value={ selected } selected>{ selected }（{ i18n.T(ctx, "appointment.bay_nonstandard") }）</option>
	}
}
