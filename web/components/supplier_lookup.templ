package components

import "strconv"

type SupplierLookupOption struct {
	ID   int64
	Name string
}

templ SupplierLookupOptions(list []SupplierLookupOption) {
	for _, s := range list {
		<option value={ strconv.FormatInt(s.ID, 10) } data-supplier-name={ s.Name }>{ s.Name }</option>
	}
}

templ SupplierQuickCreateResult(id, name, note, color string) {
	<div id="supplierQuickCreateResult" data-id={ id } data-name={ name } data-note={ note } data-color={ color }>{ note }</div>
}
