package pages

import (
	"autorepairos/internal/i18n"
)

type QuotationItem struct {
	Description string
	Quantity    string
	UnitPrice   string
	Subtotal    string
	Category    string
}

type QuotationGroup struct {
	Label    string
	Subtotal string
	Items    []QuotationItem
}

type QuotationPageData struct {
	AppName      string
	WorkOrderID  string
	Paper        string
	QuoteDate    string
	Expiry       string
	CustomerName string
	CustomerPhone string
	PlateNumber  string
	BrandModel   string
	Mileage      string
	Complaint    string
	Groups       []QuotationGroup
	ThermalItems []QuotationItem
	ItemTotal    string
	Discount     string
	Total        string
	Warranty     bool
	Terms        string
	Username     string
	PrintTime    string
	Style        string
}

templ QuotationPage(data QuotationPageData) {
	<!DOCTYPE html>
	<html lang="zh-Hant">
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<title>{ i18n.T(ctx, "quotation.title_prefix") }{ data.WorkOrderID } - AutoRepair OS</title>
		<style>@templ.Raw(data.Style)</style>
	</head>
	<body>
		<div class={ "sheet" + ifThen(data.Paper == "thermal", " sheet-thermal", "") }>
			<div class="q-head">
				<div>
					<h1>🔧 { data.AppName }</h1>
					<p class="q-subtitle">{ i18n.T(ctx, "quotation.subtitle") }
						if data.Warranty {
							<span class="pill p-completed">{ i18n.T(ctx, "quotation.warranty") }</span>
						}
					</p>
				</div>
				<div class="q-head-meta">
					<div><span>{ i18n.T(ctx, "quotation.number") }</span><b>#{ data.WorkOrderID }</b></div>
					<div><span>{ i18n.T(ctx, "quotation.date") }</span><b>{ data.QuoteDate }</b></div>
					<div><span>{ i18n.T(ctx, "quotation.expiry") }</span><b>{ data.Expiry }</b></div>
				</div>
			</div>
			<div class="q-parties">
				<div class="q-party"><span class="q-lbl">{ i18n.T(ctx, "quotation.customer") }</span><b>{ data.CustomerName }</b><span class="q-val">{ data.CustomerPhone }</span></div>
				<div class="q-party"><span class="q-lbl">{ i18n.T(ctx, "quotation.vehicle") }</span><b>{ data.PlateNumber }</b><span class="q-val">{ data.BrandModel } / { data.Mileage } km</span></div>
			</div>
			<div class="q-complaint"><span class="q-lbl">{ i18n.T(ctx, "quotation.complaint") }</span>{ data.Complaint }</div>
			<div class="q-detail">
				<h2>{ i18n.T(ctx, "quotation.items_title") }</h2>
				if data.Paper == "thermal" {
					<table class="q-thermal">
						for _, item := range data.ThermalItems {
							<tr><td>{ item.Description }<span class="q-sub">{ item.Category } × { item.Quantity }</span></td><td class="num">{ item.Subtotal }</td></tr>
						}
					</table>
				} else {
					for _, group := range data.Groups {
						if len(group.Items) > 0 {
							<div class="q-group">
								<div class="q-group-head"><span>{ group.Label }</span><b>{ group.Subtotal }</b></div>
								<table class="q-items">
									<tr><th>{ i18n.T(ctx, "quotation.field.item") }</th><th class="num">{ i18n.T(ctx, "quotation.field.qty") }</th><th class="num">{ i18n.T(ctx, "quotation.field.unit_price") }</th><th class="num">{ i18n.T(ctx, "quotation.field.subtotal") }</th></tr>
									for _, item := range group.Items {
										<tr><td>{ item.Description }</td><td class="num">{ item.Quantity }</td><td class="num">{ item.UnitPrice }</td><td class="num">{ item.Subtotal }</td></tr>
									}
								</table>
							</div>
						}
					}
				}
			</div>
			<div class="q-total">
				<div class="q-line"><span>{ i18n.T(ctx, "quotation.subtotal") }</span><b>{ data.ItemTotal }</b></div>
				if data.Discount != "" {
					<div class="q-line"><span>{ i18n.T(ctx, "quotation.discount") }</span><b style="color:#b91c1c">-{ data.Discount }</b></div>
				}
				<div class="q-grand"><span>{ i18n.T(ctx, "quotation.total") }</span><b>{ data.Total }</b></div>
			</div>
			<div class="q-terms"><b>{ i18n.T(ctx, "quotation.terms_title") }</b><p>{ data.Terms }</p></div>
			<div class="q-sign">
				<div class="q-sign-box"><span>{ i18n.T(ctx, "quotation.customer_sign") }</span><div class="q-sign-line"></div></div>
				<div class="q-sign-box"><span>{ i18n.T(ctx, "quotation.handler") }</span><div class="q-sign-line"></div><span class="q-sign-name">{ data.Username }</span></div>
			</div>
			<div class="q-foot"><p class="tiny">{ i18n.T(ctx, "quotation.print_time") }{ data.PrintTime } { i18n.T(ctx, "quotation.counter_sep") }{ data.Username }</p></div>
		</div>
		<div class="no-print">
			<button class="btn btn-p" onclick="window.print()">{ i18n.T(ctx, "quotation.print") }</button>
			<a class="btn btn-s" href={ "/work-orders/" + data.WorkOrderID + "/quotation?paper=a4" }>{ i18n.T(ctx, "quotation.a4") }</a>
			<a class="btn btn-s" href={ "/work-orders/" + data.WorkOrderID + "/quotation?paper=thermal" }>{ i18n.T(ctx, "quotation.thermal") }</a>
			<a class="btn btn-s" href={ "/work-orders/" + data.WorkOrderID }>{ i18n.T(ctx, "quotation.back") }</a>
		</div>
		<script>window.addEventListener('load', function(){ if (location.hash === '#print') window.print(); });</script>
	</body>
	</html>
}

func ifThen(condition bool, yes, no string) string {
	if condition {
		return yes
	}
	return no
}
