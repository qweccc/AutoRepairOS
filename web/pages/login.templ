package pages

import (
	"autorepairos/internal/i18n"
)

// LoginPage 登入頁。
// 獨立版面（無 nav），置中表單。與全站共用 /static/app.css 深色主題。
templ LoginPage(appName, errMsg, returnTo string) {
	<!DOCTYPE html>
	<html lang="zh-Hant">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ i18n.T(ctx, "login.title") } - { appName }</title>
			<link rel="stylesheet" href="/static/app.css"/>
			<style>
				.wrap { display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 20px; }
				form.login { background: var(--surface); border: 1px solid var(--border); border-radius: 12px;
				             padding: 32px; width: 340px; max-width: 100%; }
				form.login input { width: 100%; padding: 10px; margin: 6px 0 16px; border-radius: 8px;
				                   border: 1px solid var(--border); background: var(--surface); color: var(--text); font-size: 14px; }
				form.login button { width: 100%; padding: 11px; background: #38bdf8; color: var(--surface);
				                    border: 0; border-radius: 8px; font-weight: 700; cursor: pointer; font-size: 15px; }
				form.login button:hover { background: #0ea5e9; }
				.login-err { background: var(--danger-bg); color: #fecaca; padding: 10px 12px; border-radius: 8px;
				             font-size: 13px; margin-bottom: 16px; }
			</style>
		</head>
		<body>
			<div class="wrap">
				<form class="login" method="POST" action="/login">
					<h2 style="text-align:center;margin:0 0 24px;color:#38bdf8">🔧 { appName }</h2>
					if errMsg != "" {
						<div class="login-err">{ errMsg }</div>
					}
					<label style="font-size:13px;color:var(--text-sub)">{ i18n.T(ctx, "login.username") }
						<input type="text" name="username" required autofocus autocomplete="username"/>
					</label>
					<label style="font-size:13px;color:var(--text-sub)">{ i18n.T(ctx, "login.password") }
						<input type="password" name="password" required autocomplete="current-password"/>
					</label>
					<button type="submit">{ i18n.T(ctx, "login.title") }</button>
					<input type="hidden" name="return_to" value={ returnTo }/>
				</form>
			</div>
		</body>
	</html>
}
