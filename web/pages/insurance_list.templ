package pages

import (
	"autorepairos/internal/i18n"
	"autorepairos/internal/model"
	"fmt"
	"strconv"

	"autorepairos/web/components"
)

type VehicleInsuranceRow struct {
	ID        int64
	VehicleID int64
	Plate     string
	Customer  string
	Company   string
	ClassName string
	Class     string
	Date      string
	CardNo    string
	Amount    string
	PolicyNumber string
	ExpiryDate string
}

type VehicleInsuranceFormData struct {
	ID              int64
	Title           string
	Action          string
	ErrMsg          string
	VehicleID       int64
	VehicleOptions  []components.SelectOption
	CompanyID       int64
	CompanyOptions   []components.SelectOption
	CompanyNo       string
	Class           string
	ClassName       string
	LicenseDate     string
	PolicyNumber    string
	ExpiryDate      string
	CardNo          string
	AmountRaw       string
	Notes           string
}

templ VehicleInsuranceForm(data VehicleInsuranceFormData) {
	<div class="card">
		<h2>{ data.Title }</h2>
		if data.ErrMsg != "" {
			<div class="msg msg-err">{ data.ErrMsg }</div>
		}
		<form class="frm" method="POST" action={ data.Action }>
			@components.CSRFInput()
			if data.ID == 0 {
				<label>{ i18n.T(ctx, "estimates.field.vehicle2") }<select name="vehicle_id" required>
					for _, opt := range data.VehicleOptions {
						<option value={ opt.Value } selected?={ opt.Selected }>{ opt.Label }</option>
					}
				</select></label>
			}
			<label>{ i18n.T(ctx, "insurancelist.field.company") }<select name="insurance_company_id">
				<option value="0">{ i18n.T(ctx, "common.unspecified") }</option>
				for _, opt := range data.CompanyOptions {
					<option value={ opt.Value } selected?={ opt.Selected }>{ opt.Label }</option>
				}
			</select></label>
			<label>{ i18n.T(ctx, "insurancelist.field.company_no") }<input name="company_no" value={ data.CompanyNo }></label>
			<label>{ i18n.T(ctx, "insurancelist.field.class") }<input name="insurance_class" value={ data.Class }></label>
			<label>{ i18n.T(ctx, "insurancelist.field.class_name") }<input name="insurance_class_name" value={ data.ClassName }></label>
			<label>{ i18n.T(ctx, "insurancelist.field.license_date") }<input type="date" name="license_date" value={ data.LicenseDate }></label>
			<label>{ i18n.T(ctx, "insurancelist.field.policy_number") }<input name="policy_number" value={ data.PolicyNumber }></label>
			<label>{ i18n.T(ctx, "insurancelist.field.expiry") }<input type="date" name="expiry_date" value={ data.ExpiryDate }></label>
			<label>{ i18n.T(ctx, "insurancelist.field.card_no") }<input name="card_no" value={ data.CardNo }></label>
			<label>{ i18n.T(ctx, "insurancelist.field.amount") }<input name="amount_raw" value={ data.AmountRaw }></label>
			<label class="full">{ i18n.T(ctx, "common.notes") }<textarea name="notes">{ data.Notes }</textarea></label>
			<div class="full">
				if data.ID == 0 {
					<button class="btn btn-p" type="submit">{ i18n.T(ctx, "common.create") }</button>
				} else {
					<button class="btn btn-p" type="submit">{ i18n.T(ctx, "common.save") }</button>
				}
				<a class="btn btn-s" href="/insurances">{ i18n.T(ctx, "common.cancel") }</a>
			</div>
		</form>
	</div>
}

templ VehicleInsuranceFormPage(data VehicleInsuranceFormData, user model.User) {
	@components.Layout(data.Title, "/insurances", user, AppName) {
		@VehicleInsuranceForm(data)
	}
}

// ListVehicleInsurancesPage 車輛投保紀錄頁（HTMX 即時搜尋）。
templ ListVehicleInsurancesPage(rows []VehicleInsuranceRow, total, page, size int, q, company string, expiring bool, compTabsHTML string, user model.User) {
	{{ searchURL := "/api/insurances/search" }}
	{{ pagerURL := "/insurances" }}
	if expiring {
		{{ searchURL = "/api/insurances/search?expiring=30" }}
		{{ pagerURL = "/insurances/expiring" }}
	}
	@components.Layout(i18n.T(ctx, "insurancelist.title"), "/insurances", user, AppName) {
		<div class="card">
			<h2>{ fmt.Sprintf(i18n.T(ctx, "insurancelist.list_heading"), total) }</h2>
			<p style="color:#94a3b8;font-size:13.5px;margin:0 0 14px">
				{ i18n.T(ctx, "insurancelist.intro") }
			</p>
			<div style="margin-bottom:12px;display:flex;gap:6px;flex-wrap:wrap;align-items:center">
				@templ.Raw(compTabsHTML)
			</div>
			<input type="search" name="q" value={ q }
				placeholder={ i18n.T(ctx, "insurancelist.search_ph") }
				hx-get={ searchURL }
				hx-trigger="keyup changed delay:300ms, search"
				hx-target="#insurance-list-rows"
				hx-swap="innerHTML"
				style="padding:8px 10px;border-radius:7px;border:1px solid #334155;background:#0f172a;color:#e2e8f0;width:280px;margin-bottom:12px">
			<a class="btn btn-p" href="/insurances/new">{ i18n.T(ctx, "insurancelist.new") }</a>
			<a class="btn btn-s" href="/insurances/expiring">{ i18n.T(ctx, "insurancelist.expiring") }</a>
			<a class="btn btn-s" href="/inspections">{ i18n.T(ctx, "insurancelist.inspections") }</a>
			<table>
				<tr>
					<th>{ i18n.T(ctx, "insurancelist.field.plate") }</th><th>{ i18n.T(ctx, "insurancelist.field.owner") }</th><th>{ i18n.T(ctx, "insurancelist.field.company") }</th><th>{ i18n.T(ctx, "insurancelist.field.class_th") }</th>
					<th>{ i18n.T(ctx, "insurancelist.field.license_date") }</th><th>{ i18n.T(ctx, "insurancelist.field.policy_number") }</th><th>{ i18n.T(ctx, "insurancelist.field.expiry_th") }</th><th>{ i18n.T(ctx, "insurancelist.field.card_no") }</th><th>{ i18n.T(ctx, "insurancelist.field.amount_th") }</th><th>{ i18n.T(ctx, "insurancelist.field.actions") }</th>
				</tr>
				<tbody id="insurance-list-rows">
					for _, r := range rows {
						@VehicleInsuranceRowContent(r)
					}
				</tbody>
			</table>
			if len(rows) == 0 {
				<div class="empty">{ i18n.T(ctx, "insurancelist.empty") }</div>
			}
			@components.Pager(pagerURL, page, calcPages(total, size), total)
		</div>
	}
}

templ VehicleInsuranceRowContent(r VehicleInsuranceRow) {
	<tr>
		<td><a href={ "/vehicles/" + strconv.FormatInt(r.VehicleID, 10) }><b>{ r.Plate }</b></a></td>
		<td style="font-size:12.5px">{ r.Customer }</td>
		<td>{ orEmpty(r.Company) }</td>
		<td>
			if r.ClassName != "" {
				<span class="pill" style="background:#1e3a5f;color:#bae6fd">{ r.ClassName }</span>
			}
			if r.ClassName == "" {
				{ orEmpty(r.Class) }
			}
		</td>
		<td style="font-size:12.5px">{ r.Date }</td>
		<td><code style="font-size:12px">{ r.PolicyNumber }</code></td>
		<td style="font-size:12.5px">{ r.ExpiryDate }</td>
		<td><code style="font-size:12px">{ r.CardNo }</code></td>
		<td style="font-size:12px;color:#94a3b8">{ r.Amount }</td>
		<td>
			<a class="btn btn-s" href={ "/insurances/" + strconv.FormatInt(r.ID, 10) + "/edit" }>{ i18n.T(ctx, "common.edit") }</a>
			<a class="btn btn-d" href={ "/insurances/" + strconv.FormatInt(r.ID, 10) + "/delete" }
				hx-post={ "/insurances/" + strconv.FormatInt(r.ID, 10) + "/delete" }
				data-confirm={ i18n.T(ctx, "insurancelist.delete_confirm") }>{ i18n.T(ctx, "common.delete") }</a>
		</td>
	</tr>
}

type InspectionRow struct {
	ID        int64
	VehicleID int64
	Plate     string
	Customer  string
	OrderDate string
	CheckDate string
	StatusPill string
	StatusLabel string
}

// ListVehicleInspectionsPage 車輛定檢排程頁（HTMX 即時搜尋）。
templ ListVehicleInspectionsPage(rows []InspectionRow, total, page, size int, q string, pendingOnly bool, pendingCount int, user model.User) {
	@components.Layout(i18n.T(ctx, "insurancelist.inspection_title"), "/inspections", user, AppName) {
		<div class="card">
			<h2>{ fmt.Sprintf(i18n.T(ctx, "insurancelist.inspection_heading"), total, pendingCount) }</h2>
			<p style="color:#94a3b8;font-size:13.5px;margin:0 0 14px">
				{ i18n.T(ctx, "insurancelist.inspection_intro") }
			</p>
			<input type="search" name="q" value={ q }
				placeholder={ i18n.T(ctx, "insurancelist.inspection_search_ph") }
				hx-get="/api/inspections/search"
				hx-trigger="keyup changed delay:300ms, search"
				hx-target="#inspection-rows"
				hx-swap="innerHTML"
				style="padding:8px 10px;border-radius:7px;border:1px solid #334155;background:#0f172a;color:#e2e8f0;width:280px;margin-bottom:12px">
			<a class="btn btn-p" href="/inspections/new">{ i18n.T(ctx, "insurancelist.inspection_new") }</a>
			<a class="btn btn-s" href="/insurances">{ i18n.T(ctx, "insurancelist.back_insurances") }</a>
			<table>
				<tr><th>{ i18n.T(ctx, "insurancelist.field.plate") }</th><th>{ i18n.T(ctx, "insurancelist.field.owner") }</th><th>{ i18n.T(ctx, "insurancelist.field.order_date") }</th><th>{ i18n.T(ctx, "insurancelist.field.check_date") }</th><th>{ i18n.T(ctx, "estimates.field.status") }</th><th>{ i18n.T(ctx, "insurancelist.field.actions") }</th></tr>
				<tbody id="inspection-rows">
					for _, r := range rows {
						@VehicleInspectionRowContent(r)
					}
				</tbody>
			</table>
			if len(rows) == 0 {
				<div class="empty">{ i18n.T(ctx, "insurancelist.inspection_empty") }</div>
			}
			@components.Pager("/inspections", page, calcPages(total, size), total)
		</div>
	}
}

templ VehicleInspectionRowContent(r InspectionRow) {
	<tr>
		<td><a href={ "/vehicles/" + strconv.FormatInt(r.VehicleID, 10) }><b>{ r.Plate }</b></a></td>
		<td style="font-size:12.5px">{ r.Customer }</td>
		<td style="font-size:12.5px">{ r.OrderDate }</td>
		<td style="font-size:12.5px">{ r.CheckDate }</td>
		<td><span class={ "pill " + r.StatusPill }>{ r.StatusLabel }</span></td>
		<td>
			<a class="btn btn-s" href={ "/inspections/" + strconv.FormatInt(r.ID, 10) + "/edit" }>{ i18n.T(ctx, "common.edit") }</a>
			<a class="btn btn-d" href={ "/inspections/" + strconv.FormatInt(r.ID, 10) + "/delete" }
				hx-post={ "/inspections/" + strconv.FormatInt(r.ID, 10) + "/delete" }
				data-confirm={ i18n.T(ctx, "insurancelist.inspection_delete_confirm") }>{ i18n.T(ctx, "common.delete") }</a>
		</td>
	</tr>
}

// VehicleInsuranceSearchRows 投保即時搜尋回傳的純列。
templ VehicleInsuranceSearchRows(rows []VehicleInsuranceRow) {
	if len(rows) == 0 {
		<tr><td colspan="10" style="color:#64748b;text-align:center;padding:20px">{ i18n.T(ctx, "insurancelist.search_empty") }</td></tr>
	}
	for _, r := range rows {
		@VehicleInsuranceRowContent(r)
	}
}

// VehicleInspectionSearchRows 定檢即時搜尋回傳的純列。
templ VehicleInspectionSearchRows(rows []InspectionRow) {
	if len(rows) == 0 {
		<tr><td colspan="6" style="color:#64748b;text-align:center;padding:20px">{ i18n.T(ctx, "insurancelist.inspection_search_empty") }</td></tr>
	}
	for _, r := range rows {
		@VehicleInspectionRowContent(r)
	}
}
