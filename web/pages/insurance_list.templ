package pages

import (
	"strconv"

	"autorepairos/web/components"
)

type VehicleInsuranceRow struct {
	ID        int64
	VehicleID int64
	Plate     string
	Customer  string
	Company   string
	ClassName string
	Class     string
	Date      string
	CardNo    string
	Amount    string
}

// ListVehicleInsurancesPage 車輛投保紀錄頁（HTMX 即時搜尋）。
templ ListVehicleInsurancesPage(rows []VehicleInsuranceRow, total, page, size int, q, company string, compTabsHTML string) {
	@components.Layout("車輛投保紀錄", "/insurances", "owner", "owner", "AutoRepair OS") {
		<div class="card">
			<h2>車輛投保紀錄（符合條件 { strconv.Itoa(total) } 筆）</h2>
			<p style="color:#94a3b8;font-size:13.5px;margin:0 0 14px">
				舊系統「保險名單」表遷移而來。保險理賠是車行主要收入來源。
			</p>
			<div style="margin-bottom:12px;display:flex;gap:6px;flex-wrap:wrap;align-items:center">
				@templ.Raw(compTabsHTML)
			</div>
			<input type="search" name="q" value={ q }
				placeholder="搜尋車牌 / 車主 / 保險卡號"
				hx-get="/api/insurances/search"
				hx-trigger="keyup changed delay:300ms, search"
				hx-target="#insurance-list-rows"
				hx-swap="innerHTML"
				style="padding:8px 10px;border-radius:7px;border:1px solid #334155;background:#0f172a;color:#e2e8f0;width:280px;margin-bottom:12px">
			<a class="btn btn-p" href="/insurances/new">＋ 新增投保</a>
			<a class="btn btn-s" href="/inspections">定檢排程</a>
			<table>
				<tr>
					<th>車牌</th><th>車主</th><th>保險公司</th><th>險種</th>
					<th>發照日</th><th>保險卡號</th><th>保額／備註</th><th>操作</th>
				</tr>
				<tbody id="insurance-list-rows">
					for _, r := range rows {
						@VehicleInsuranceRowContent(r)
					}
				</tbody>
			</table>
			if len(rows) == 0 {
				<div class="empty">沒有符合條件的投保紀錄</div>
			}
			@components.Pager("/insurances", page, calcPages(total, size), total)
		</div>
	}
}

templ VehicleInsuranceRowContent(r VehicleInsuranceRow) {
	<tr>
		<td><a href={ "/vehicles/" + strconv.FormatInt(r.VehicleID, 10) }><b>{ r.Plate }</b></a></td>
		<td style="font-size:12.5px">{ r.Customer }</td>
		<td>{ orEmpty(r.Company) }</td>
		<td>
			if r.ClassName != "" {
				<span class="pill" style="background:#1e3a5f;color:#bae6fd">{ r.ClassName }</span>
			}
			if r.ClassName == "" {
				{ orEmpty(r.Class) }
			}
		</td>
		<td style="font-size:12.5px">{ r.Date }</td>
		<td><code style="font-size:12px">{ r.CardNo }</code></td>
		<td style="font-size:12px;color:#94a3b8">{ r.Amount }</td>
		<td>
			<a class="btn btn-s" href={ "/insurances/" + strconv.FormatInt(r.ID, 10) + "/edit" }>編輯</a>
			<a class="btn btn-d" href={ "/insurances/" + strconv.FormatInt(r.ID, 10) + "/delete" }
				data-confirm="確定刪除這筆投保紀錄？">刪除</a>
		</td>
	</tr>
}

type InspectionRow struct {
	ID        int64
	VehicleID int64
	Plate     string
	Customer  string
	OrderDate string
	CheckDate string
	StatusPill string
	StatusLabel string
}

// ListVehicleInspectionsPage 車輛定檢排程頁（HTMX 即時搜尋）。
templ ListVehicleInspectionsPage(rows []InspectionRow, total, page, size int, q string, pendingOnly bool, pendingCount int) {
	@components.Layout("車輛定檢排程", "/inspections", "owner", "owner", "AutoRepair OS") {
		<div class="card">
			<h2>車輛定檢排程（符合條件 { strconv.Itoa(total) } 筆，未完成 { strconv.Itoa(pendingCount) } 筆）</h2>
			<p style="color:#94a3b8;font-size:13.5px;margin:0 0 14px">
				舊系統「驗車名單」表遷移而來。實際完成幾乎沒回填，所以「完成日」為空代表尚未檢驗。
			</p>
			<input type="search" name="q" value={ q }
				placeholder="搜尋車牌 / 車主"
				hx-get="/api/inspections/search"
				hx-trigger="keyup changed delay:300ms, search"
				hx-target="#inspection-rows"
				hx-swap="innerHTML"
				style="padding:8px 10px;border-radius:7px;border:1px solid #334155;background:#0f172a;color:#e2e8f0;width:280px;margin-bottom:12px">
			<a class="btn btn-p" href="/inspections/new">＋ 新增排程</a>
			<a class="btn btn-s" href="/insurances">投保紀錄</a>
			<table>
				<tr><th>車牌</th><th>車主</th><th>排定日</th><th>完成日</th><th>狀態</th><th>操作</th></tr>
				<tbody id="inspection-rows">
					for _, r := range rows {
						@VehicleInspectionRowContent(r)
					}
				</tbody>
			</table>
			if len(rows) == 0 {
				<div class="empty">沒有符合條件的定檢排程</div>
			}
			@components.Pager("/inspections", page, calcPages(total, size), total)
		</div>
	}
}

templ VehicleInspectionRowContent(r InspectionRow) {
	<tr>
		<td><a href={ "/vehicles/" + strconv.FormatInt(r.VehicleID, 10) }><b>{ r.Plate }</b></a></td>
		<td style="font-size:12.5px">{ r.Customer }</td>
		<td style="font-size:12.5px">{ r.OrderDate }</td>
		<td style="font-size:12.5px">{ r.CheckDate }</td>
		<td><span class={ "pill " + r.StatusPill }>{ r.StatusLabel }</span></td>
		<td>
			<a class="btn btn-s" href={ "/inspections/" + strconv.FormatInt(r.ID, 10) + "/edit" }>編輯</a>
			<a class="btn btn-d" href={ "/inspections/" + strconv.FormatInt(r.ID, 10) + "/delete" }
				data-confirm="確定刪除這筆定檢排程？">刪除</a>
		</td>
	</tr>
}

// VehicleInsuranceSearchRows 投保即時搜尋回傳的純列。
templ VehicleInsuranceSearchRows(rows []VehicleInsuranceRow) {
	if len(rows) == 0 {
		<tr><td colspan="8" style="color:#64748b;text-align:center;padding:20px">查無投保紀錄</td></tr>
	}
	for _, r := range rows {
		@VehicleInsuranceRowContent(r)
	}
}

// VehicleInspectionSearchRows 定檢即時搜尋回傳的純列。
templ VehicleInspectionSearchRows(rows []InspectionRow) {
	if len(rows) == 0 {
		<tr><td colspan="6" style="color:#64748b;text-align:center;padding:20px">查無定檢排程</td></tr>
	}
	for _, r := range rows {
		@VehicleInspectionRowContent(r)
	}
}
