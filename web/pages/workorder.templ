package pages

import (
	"context"
	"strconv"
	"time"

	"autorepairos/internal/model"
	"autorepairos/internal/i18n"
	"autorepairos/web/components"
)

// ShowWorkOrderPage 工單詳情頁。
// 用 Templ 型別安全產生，HTMX 處理狀態切換與新增項目。
templ ShowWorkOrderPage(wo model.WorkOrder, items []model.WorkOrderItem, itemTotal float64,
	statusLabel string, statusPill map[string]string, approvalLabel string, approvalPill map[string]string,
	techNames map[int64]string, canEdit bool, flashMsg string,
	sopRecords []model.SOPRecord, sopTemplateOpts string, attachedTemplates []int64,
	canCreateApproval bool, pendingApprovals []PendingApproval, user model.User) {

	@components.Layout(i18n.T(ctx, "workorder.detail")+" #"+strconv.FormatInt(wo.ID, 10), "/work-orders", user, AppName) {
		if flashMsg != "" {
			<div class="msg msg-ok">{ flashMsg }</div>
		}
		<div class="card">
			<h2>{ i18n.T(ctx, "workorder.detail") } #{ strconv.FormatInt(wo.ID, 10) } — { wo.PlateNumber }</h2>
					<table>
				<tr>
					<th style="width:130px">{ i18n.T(ctx, "workorder.col.model") }</th><td>{ wo.BrandModel }</td>
					<th style="width:130px">{ i18n.T(ctx, "workorder.col.mileage") }</th><td>{ strconv.Itoa(wo.CurrentMileage) } km</td>
				</tr>
				<tr>
					<th>{ i18n.T(ctx, "workorder.col.customer") }</th><td>{ wo.CustomerName } / { wo.CustomerPhone }</td>
					<th>{ i18n.T(ctx, "workorder.col.technician") }</th><td>{ wo.TechnicianName }</td>
				</tr>
				<tr>
					<th>{ i18n.T(ctx, "workorder.col.status") }</th>
					<td><span class={ "pill " + statusPill[wo.Status] }>{ statusLabel }</span></td>
					<th>{ i18n.T(ctx, "workorder.col.approval_status") }</th>
					<td><span class={ "pill " + approvalPill[wo.ApprovalStatus] }>{ approvalLabel }</span></td>
				</tr>
				<tr><th>{ i18n.T(ctx, "workorder.col.complaint") }</th><td colspan="3">{ wo.CustomerComplaint }</td></tr>
				<tr>
					<th>SOP</th><td>{ sopStatusText(ctx, wo.SOPCompleted, len(sopRecords)) }</td>
					<th>{ i18n.T(ctx, "workorder.col.created_at") }</th><td>{ wo.CreatedAt.Format("2006-01-02 15:04") }</td>
				</tr>
				@InsuranceRow(wo, canEdit)
			</table>
			<div style="margin-top:16px">
				@StatusControls(wo, canEdit)
				<div style="margin-top:14px;padding-top:14px;border-top:1px solid var(--border)">
					<a class="btn btn-p" href={ "/work-orders/" + strconv.FormatInt(wo.ID, 10) + "/receipt" }>{ i18n.T(ctx, "workorder.action.receipt") }</a>
					<a class="btn btn-s" href={ "/work-orders/" + strconv.FormatInt(wo.ID, 10) + "/quotation?paper=a4" }>{ i18n.T(ctx, "workorder.action.quotation") }</a>
					<a class="btn btn-s" href={ "/work-orders/" + strconv.FormatInt(wo.ID, 10) + "/completion" }>{ i18n.T(ctx, "workorder.action.completion") }</a>
					<a class="btn btn-s" href={ "/work-orders/" + strconv.FormatInt(wo.ID, 10) + "/worklogs" }>{ i18n.T(ctx, "workorder.action.worklogs") }</a>
					<a class="btn btn-s" href={ "/work-orders/" + strconv.FormatInt(wo.ID, 10) + "/photos" }>{ i18n.T(ctx, "workorder.action.photos") }</a>
				</div>
			</div>
		</div>

		// T2.6：SOP 檢查表
		<div class="card">
			<h2>{ i18n.T(ctx, "workorder.section.sop") }</h2>
			if len(sopRecords) == 0 {
				<div class="empty">{ i18n.T(ctx, "workorder.sop.empty") }</div>
			}
			if len(sopRecords) > 0 {
				@SOPChecklistTable(wo.ID, sopRecords, canEdit)
			}
			if canEdit {
				if sopTemplateOpts != "" {
					<form method="POST" action={ "/work-orders/" + strconv.FormatInt(wo.ID, 10) + "/sop/attach" }
						style="margin-top:14px;display:flex;gap:8px;align-items:center">
						@components.CSRFInput()
						<select name="template_id"
							style="padding:6px 9px;border-radius:7px;border:1px solid var(--border);background:var(--surface);color:var(--text)">
							@templ.Raw(sopTemplateOpts)
						</select>
						<button class="btn btn-s" type="submit">{ i18n.T(ctx, "workorder.sop.attach") }</button>
					</form>
				}
			}
		</div>

		<div class="card">
			<h2>{ i18n.T(ctx, "workorder.section.items") }</h2>
			<div id="wo-items">
				@WorkOrderItemsTable(wo.ID, items, techNames, canEdit, itemTotal, user)
			</div>
			if canEdit {
				@AddItemForm(wo.ID)
			}
		</div>

		@ApprovalRequestBlock(wo.ID, canCreateApproval, pendingApprovals)

		<div class="card">
			<h2>{ i18n.T(ctx, "workorder.section.walkaround") }</h2>
			<p style="color:var(--muted);font-size:12.5px">{ i18n.T(ctx, "workorder.walkaround.hint") }</p>
			@WalkaroundCanvas(wo.ID, nil)
			<div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:10px">
				@WalkaroundMarkTypeSelect("scratch")
				<label>{ i18n.T(ctx, "workorder.walkaround.note_label") }<input id="walkaround-note" type="text" placeholder={ i18n.T(ctx, "workorder.walkaround.note_ph") }></label>
			</div>
			<div id="walkaround-status" role="status" style="margin-top:6px;color:var(--text-sub)"></div>
		</div>

				if user.Role == "owner" || user.Role == "counter" {
			<div class="card">
				<h2>{ i18n.T(ctx, "workorder.section.total") }</h2>
				<table>
					<tr><th>{ i18n.T(ctx, "workorder.total.subtotal") }</th><td class="num" id="item-total">{ money(itemTotal) }</td></tr>
					<tr>
						<th>{ i18n.T(ctx, "workorder.total.grand") }</th>
						<td class="num" id="wo-total" style="font-size:20px;font-weight:700;color:#38bdf8">{ money(wo.TotalAmount) }</td>
					</tr>
				</table>
			</div>
		}
}

}

// WorkOrderItemsTable 工單項目表格（HTMX 局部更新目標）。
templ WorkOrderItemsTable(woID int64, items []model.WorkOrderItem, techNames map[int64]string, canEdit bool, itemTotal float64, user model.User) {
	if len(items) == 0 {
		<div class="empty">{ i18n.T(ctx, "workorder.items.empty") }</div>
	}
	if len(items) > 0 {
	<table>
		<tr>
			<th>{ i18n.T(ctx, "workorder.col.type") }</th><th>{ i18n.T(ctx, "workorder.col.desc") }</th><th class="num">{ i18n.T(ctx, "workorder.col.qty") }</th>
			{{ showMoney := user.Role == "owner" || user.Role == "counter" }}
			if showMoney {
				<th class="num">{ i18n.T(ctx, "workorder.col.unit_price") }</th><th class="num">{ i18n.T(ctx, "workorder.col.subtotal") }</th>
			}
			<th>{ i18n.T(ctx, "workorder.col.primary_tech") }</th><th>{ i18n.T(ctx, "workorder.col.assistant_tech") }</th><th>{ i18n.T(ctx, "workorder.col.actions") }</th>
		</tr>
			for _, it := range items {
				<tr>
					<td>@components.Pill(itemTypeLabel(ctx, it.ItemType), "p-progress")</td>
					<td>{ it.Description }</td>
					<td class="num">{ strconv.Itoa(it.Quantity) }</td>
					if showMoney {
						<td class="num">{ money(it.UnitPrice) }</td>
						<td class="num">{ money(it.Subtotal) }</td>
					}
					<td>{ techNames[it.PrimaryTechnicianID] }</td>
					<td>{ techNames[it.AssistantTechID] }</td>
					if canEdit {
						<td>
							<a class="btn btn-d"
								hx-post={ "/work-orders/" + strconv.FormatInt(woID, 10) + "/items/" + strconv.FormatInt(it.ID, 10) + "/delete" }
								hx-target="#wo-items"
								hx-swap="innerHTML"
								hx-confirm={ i18n.T(ctx, "workorder.items.delete_confirm") }>{ i18n.T(ctx, "workorder.items.delete") }</a>
							</td>
							}
							if canEdit == false {
							<td style="color:var(--muted)">—</td>
							}
				</tr>
			}
		</table>
	}
}

// AddItemForm 新增工單項目表單（HTMX 無刷新送出）。
templ AddItemForm(woID int64) {
	<form
		hx-post={ "/work-orders/" + strconv.FormatInt(woID, 10) + "/items" }
		hx-target="#wo-items"
		hx-swap="innerHTML"
			hx-on::after-request="if(event.detail.successful && event.detail.elt === event.currentTarget) { document.getElementById('partSearch').value=''; document.getElementById('inventoryItemId').value='0'; document.getElementById('itemDesc').value=''; document.getElementById('phraseSearch').value=''; document.getElementById('phraseResults').innerHTML=''; document.getElementById('partResults').innerHTML=''; document.getElementById('addItemError').textContent=''; } if(!event.detail.successful){ document.getElementById('addItemError').textContent = event.detail.xhr.responseText || '加入失敗'; }">
			@components.CSRFInput()
		<label>{ i18n.T(ctx, "workorder.col.type") }
			<select name="item_type" id="itemType" hx-on:change="togglePartSearch(this)">
				<option value="labor">{ i18n.T(ctx, "workorder.item_type.labor") }</option>
				<option value="part">{ i18n.T(ctx, "workorder.item_type.part") }</option>
				<option value="subcontract">{ i18n.T(ctx, "workorder.item_type.subcontract") }</option>
			</select>
		</label>
		<label class="full" id="partSearchWrap">{ i18n.T(ctx, "workorder.form.part_search") }
			<div class="search-bar">
				<input type="search" id="partSearch" name="q" class="search-input" placeholder={ i18n.T(ctx, "workorder.form.part_search_ph") } autocomplete="off"
					hx-get="/api/parts" hx-trigger="keyup changed delay:300ms, search"
					hx-target="#partResults" hx-swap="innerHTML"
					hx-on::after-request="if(event.detail.successful) document.getElementById('partResults').style.display='block';">
				@components.BarcodeScanUI("partScanBtn", "partSearch", "partScanBox")
			</div>
			<div id="partResults" class="part-results"></div>
			<input type="hidden" name="inventory_item_id" id="inventoryItemId" value="0">
		</label>
		<label class="full">{ i18n.T(ctx, "workorder.col.desc") }
			<input name="description" id="itemDesc" placeholder={ i18n.T(ctx, "workorder.form.desc_ph") } required>
			<div style="margin-top:4px">
				<button type="button" class="btn btn-s" id="phraseBtn" onclick="togglePhrasePicker()">{ i18n.T(ctx, "workorder.form.phrases") }</button>
				<div id="phrasePicker" style="display:none;margin-top:8px;border:1px solid var(--border);border-radius:7px;padding:8px;background:var(--surface)">
					<input type="search" id="phraseSearch" name="phrase" class="search-input" placeholder={ i18n.T(ctx, "workorder.form.phrase_search_ph") } style="width:100%;margin-bottom:8px"
						hx-get="/api/phrases/search" hx-trigger="keyup changed delay:300ms, search"
						hx-target="#phraseResults" hx-swap="innerHTML">
					<div id="phraseResults" style="max-height:150px;overflow-y:auto"></div>
				</div>
			</div>
		</label>
		<label>{ i18n.T(ctx, "workorder.col.qty") }<input name="quantity" type="number" min="1" value="1" required></label>
		<label>{ i18n.T(ctx, "workorder.col.unit_price") }<input name="unit_price" type="number" min="0" step="1" value="0" required id="unitPrice"></label>
		<label>{ i18n.T(ctx, "workorder.col.primary_tech") }
			<div class="staff-picker">
				<input class="staff-picker-input" name="q" type="search" placeholder={ i18n.T(ctx, "workorder.form.staff_search_ph") } autocomplete="off"
					hx-get="/api/staff/search?format=picker&kind=employee" hx-trigger="keyup changed delay:250ms, search"
					hx-target="next .staff-picker-results" hx-swap="innerHTML">
				<input type="hidden" name="primary_technician_id" value="0">
				<div class="staff-picker-results"></div>
			</div>
		</label>
		<label>{ i18n.T(ctx, "workorder.col.assistant_tech") }
			<div class="staff-picker">
				<input class="staff-picker-input" name="q" type="search" placeholder={ i18n.T(ctx, "workorder.form.staff_search_ph") } autocomplete="off"
					hx-get="/api/staff/search?format=picker&kind=employee" hx-trigger="keyup changed delay:250ms, search"
					hx-target="next .staff-picker-results" hx-swap="innerHTML">
				<input type="hidden" name="assistant_technician_id" value="0">
				<div class="staff-picker-results"></div>
			</div>
		</label>
				<div id="addItemError" style="color:var(--danger);margin-top:6px;font-size:13px"></div>
				<div class="full"><button class="btn btn-p" type="submit">{ i18n.T(ctx, "workorder.form.add_item") }</button></div>
	</form>
	@PartSearchScript()
	@PhrasePickerScript()
}

// StatusControls 狀態切換控制（HTMX 無刷新）。
templ StatusControls(wo model.WorkOrder, canEdit bool) {
	if canEdit {
		<form hx-post={ "/work-orders/" + strconv.FormatInt(wo.ID, 10) + "/status" }
			hx-target="#wo-status"
			hx-swap="innerHTML"
			style="display:inline;margin:0 8px">
			@components.CSRFInput()
			<select name="status" onchange="htmx.trigger(this.closest('form'), 'submit')"
				style="padding:6px 9px;border-radius:7px;border:1px solid var(--border);background:var(--surface);color:var(--text)">
				<option value="pending" selected?={ wo.Status == "pending" }>{ i18n.T(ctx, "workorder.status.pending") }</option>
				<option value="in_progress" selected?={ wo.Status == "in_progress" }>{ i18n.T(ctx, "workorder.status.in_progress") }</option>
				<option value="waiting_parts" selected?={ wo.Status == "waiting_parts" }>{ i18n.T(ctx, "workorder.status.waiting_parts") }</option>
				<option value="completed" selected?={ wo.Status == "completed" }>{ i18n.T(ctx, "workorder.status.completed") }</option>
				<option value="paid" selected?={ wo.Status == "paid" }>{ i18n.T(ctx, "workorder.status.paid") }</option>
			</select>
		</form>
		<form hx-post={ "/work-orders/" + strconv.FormatInt(wo.ID, 10) + "/approval" }
			hx-target="#wo-approval"
			hx-swap="innerHTML"
			style="display:inline;margin:0 8px">
			@components.CSRFInput()
			<select name="approval_status" onchange="htmx.trigger(this.closest('form'), 'submit')"
				style="padding:6px 9px;border-radius:7px;border:1px solid var(--border);background:var(--surface);color:var(--text)">
				<option value="pending" selected?={ wo.ApprovalStatus == "pending" }>{ i18n.T(ctx, "workorder.approval.pending") }</option>
				<option value="approved" selected?={ wo.ApprovalStatus == "approved" }>{ i18n.T(ctx, "workorder.approval.approved") }</option>
				<option value="rejected" selected?={ wo.ApprovalStatus == "rejected" }>{ i18n.T(ctx, "workorder.approval.rejected") }</option>
			</select>
		</form>
		<form hx-post={ "/work-orders/" + strconv.FormatInt(wo.ID, 10) + "/sop" }
			hx-target="#wo-sop"
			hx-swap="innerHTML"
			style="display:inline;margin:0 8px">
			@components.CSRFInput()
			<button class="btn btn-s" type="submit">{ sopLabel(ctx, wo.SOPCompleted) }</button>
		</form>
	}
}

// InsuranceRow 保險理賠資訊列。
templ InsuranceRow(wo model.WorkOrder, canEdit bool) {
	if wo.IsInsurance || wo.InsuranceCompanyID > 0 {
		<tr><th>{ i18n.T(ctx, "workorder.claim.category") }</th><td><span class="pill p-progress">{ i18n.T(ctx, "workorder.claim.insurance") }</span></td>
		<th>{ i18n.T(ctx, "workorder.claim.company") }</th><td>{ wo.InsuranceName }</td></tr>
		<tr><th>{ i18n.T(ctx, "workorder.claim.no") }</th><td>{ wo.ClaimNo }</td>
		<th>{ i18n.T(ctx, "workorder.claim.accident_date") }</th><td>{ wo.AccidentDate }</td></tr>
		<tr><th>{ i18n.T(ctx, "workorder.claim.deductible") }</th><td>{ money(wo.DeductibleAmount) }</td><th></th><td></td></tr>
	}
	if wo.IsInsurance == false && wo.InsuranceCompanyID == 0 {
		<tr><th>{ i18n.T(ctx, "workorder.claim.category") }</th><td><span class="pill">{ i18n.T(ctx, "workorder.claim.self_pay") }</span></td>
		<th></th><td></td></tr>
	}
	<tr>
		<td colspan="4">
			if canEdit {
				<form class="frm" method="POST" action={ "/work-orders/" + strconv.FormatInt(wo.ID, 10) + "/claim" }>
					@components.CSRFInput()
					<label>{ i18n.T(ctx, "workorder.claim.date") }<input type="date" name="claim_date" value={ wo.ClaimDate }></label>
					<label>{ i18n.T(ctx, "workorder.claim.amount") }<input type="number" name="claim_amount" min="0" step="0.01" value={ strconv.FormatFloat(wo.ClaimAmount, 'f', 2, 64) }></label>
					<label class="full">{ i18n.T(ctx, "workorder.claim.note") }<textarea name="claim_note">{ wo.ClaimNote }</textarea></label>
					<div class="full"><button class="btn btn-s" type="submit">{ i18n.T(ctx, "workorder.claim.save") }</button></div>
				</form>
			}
			if !canEdit {
				<b>{ i18n.T(ctx, "workorder.claim.date") }</b> { wo.ClaimDate }
				<b>{ i18n.T(ctx, "workorder.claim.amount") }</b> { money(wo.ClaimAmount) }
			}
			if !canEdit && wo.ClaimNote != "" {
				<p>{ wo.ClaimNote }</p>
			}
		</td>
	</tr>
}

templ SOPChecklistTable(woID int64, records []model.SOPRecord, canEdit bool) {
	<table>
		<tr><th>{ i18n.T(ctx, "workorder.sop.col.item") }</th><th>{ i18n.T(ctx, "workorder.sop.col.required") }</th><th>{ i18n.T(ctx, "workorder.sop.col.status") }</th><th>{ i18n.T(ctx, "workorder.sop.col.by") }</th><th>{ i18n.T(ctx, "workorder.sop.col.at") }</th></tr>
		for _, r := range records {
			<tr>
				<td>{ r.Description }</td>
				<td>{ yesNo(ctx, r.Required) }</td>
				<td>
					if r.Completed {
						if canEdit {
							<form method="POST" action={ "/work-orders/" + strconv.FormatInt(woID, 10) + "/sop/records/" + strconv.FormatInt(r.ID, 10) + "/toggle" }>
								@components.CSRFInput()
								<button class="pill p-completed" type="submit">{ i18n.T(ctx, "workorder.sop.done") }</button>
							</form>
						} else {
							<span class="pill p-completed">{ i18n.T(ctx, "workorder.sop.done") }</span>
						}
					}
					if !r.Completed {
						if canEdit {
							<form method="POST" action={ "/work-orders/" + strconv.FormatInt(woID, 10) + "/sop/records/" + strconv.FormatInt(r.ID, 10) + "/toggle" }>
								@components.CSRFInput()
								<button class="pill p-pending" type="submit">{ i18n.T(ctx, "workorder.sop.todo") }</button>
							</form>
						} else {
							<span class="pill p-pending">{ i18n.T(ctx, "workorder.sop.todo") }</span>
						}
					}
				</td>
				<td>{ r.CompletedByName }</td>
				<td>{ r.CompletedAtText }</td>
			</tr>
		}
	</table>
}

// PartSearchScript 零件即時搜尋 JS。
templ PartSearchScript() {
	<script>
		function togglePartSearch(sel) {
			var wrap = document.getElementById('partSearchWrap');
			if (wrap) wrap.style.display = '';
			if (sel.value !== 'part') {
				document.getElementById('inventoryItemId').value = '0';
			}
		}
		(function(){
			var type = document.getElementById('itemType');
			if (type) togglePartSearch(type);
			var search = document.getElementById('partSearch');
			var results = document.getElementById('partResults');
			var hidden = document.getElementById('inventoryItemId');
			var desc = document.getElementById('itemDesc');
			var price = document.getElementById('unitPrice');
			if (!search || !results) return;
			results.addEventListener('click', function(e){
				var item = e.target.closest('.part-result-item');
				if (!item) return;
				var type = document.getElementById('itemType');
				if (type) type.value = 'part';
				hidden.value = item.dataset.partId;
				search.value = item.dataset.partName + ' / ' + item.dataset.partNumber;
				desc.value = item.dataset.partName;
				price.value = item.dataset.partPrice;
				results.innerHTML = '';
			});
			document.addEventListener('click', function(e){
				if (!results.contains(e.target) && e.target !== search) results.style.display = 'none';
			});
		})();
	</script>
}

// PhrasePickerScript 技師片語選擇 JS（T2.7）。
templ PhrasePickerScript() {
	<script>
		function togglePhrasePicker() {
			var picker = document.getElementById('phrasePicker');
			if (picker) picker.style.display = picker.style.display === 'none' ? 'block' : 'none';
		}
		(function(){
			var search = document.getElementById('phraseSearch');
			var results = document.getElementById('phraseResults');
			var desc = document.getElementById('itemDesc');
			if (!search || !results) return;
			results.addEventListener('click', function(e){
				var item = e.target.closest('.phrase-result-item');
				if (!item) return;
				desc.value = item.dataset.phrase;
				results.innerHTML = '';
				search.value = '';
			});
		})();
	</script>
}

// 以下為 templ 內使用的輔助函式（Go 邏輯部分）。
func statusIndex(s string) int {
	flow := []string{"pending", "in_progress", "waiting_parts", "completed", "paid"}
	for i, x := range flow {
		if x == s {
			return i
		}
	}
	return 0
}

func statusStepStyle(stepIdx, currentIdx int) string {
	if stepIdx < currentIdx {
		return "background:var(--primary-bg);color:var(--primary)"
	}
	if stepIdx == currentIdx {
		return "background:#1d4ed8;color:#fff"
	}
	return "background:var(--border);color:var(--muted)"
}

func itemTypeLabel(ctx context.Context, t string) string {
	switch t {
	case "labor":
		return i18n.T(ctx, "workorder.item_type.labor")
	case "part":
		return i18n.T(ctx, "workorder.item_type.part")
	case "subcontract":
		return i18n.T(ctx, "workorder.item_type.subcontract")
	}
	return t
}

func yesNo(ctx context.Context, b bool) string {
	if b {
		return i18n.T(ctx, "common.yes")
	}
	return i18n.T(ctx, "common.no")
}

func sopLabel(ctx context.Context, done bool) string {
	if done {
		return i18n.T(ctx, "workorder.sop.cancel")
	}
	return i18n.T(ctx, "workorder.sop.mark_done")
}

func sopStatusText(ctx context.Context, completed bool, total int) string {
	if total == 0 { return i18n.T(ctx, "workorder.sop.not_attached") }
	if completed { return i18n.T(ctx, "workorder.sop.done") }
	return i18n.T(ctx, "workorder.sop.in_progress")
}

func money(f float64) string {
	return "$" + strconv.FormatFloat(f, 'f', 0, 64)
}

var _ = time.Now
