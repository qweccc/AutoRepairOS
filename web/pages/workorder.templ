package pages

import (
	"strconv"
	"time"

	"autorepairos/internal/model"
	"autorepairos/web/components"
)

// ShowWorkOrderPage 工單詳情頁。
// 用 Templ 型別安全產生，HTMX 處理狀態切換與新增項目。
templ ShowWorkOrderPage(wo model.WorkOrder, items []model.WorkOrderItem, itemTotal float64,
	statusLabels map[string]string, statusPill map[string]string, approvalLabels map[string]string, approvalPill map[string]string,
	techNames map[int64]string, canEdit bool, flashMsg string,
	sopRecords []model.SOPRecord, sopTemplateOpts string, attachedTemplates []int64,
	canCreateApproval bool, pendingApprovals []PendingApproval, user model.User) {

	@components.Layout("工單 #"+strconv.FormatInt(wo.ID, 10), "/work-orders", user, AppName) {
		if flashMsg != "" {
			<div class="msg msg-ok">{ flashMsg }</div>
		}
		<div class="card">
			<h2>工單 #{ strconv.FormatInt(wo.ID, 10) } — { wo.PlateNumber }</h2>
			@StatusFlow(wo.Status, statusLabels)
			<table>
				<tr>
					<th style="width:130px">車型</th><td>{ wo.BrandModel }</td>
					<th style="width:130px">進廠里程</th><td>{ strconv.Itoa(wo.CurrentMileage) } km</td>
				</tr>
				<tr>
					<th>客戶</th><td>{ wo.CustomerName } / { wo.CustomerPhone }</td>
					<th>技師</th><td>{ wo.TechnicianName }</td>
				</tr>
				<tr>
					<th>狀態</th>
					<td><span class={ "pill " + statusPill[wo.Status] }>{ statusLabels[wo.Status] }</span></td>
					<th>核准狀態</th>
					<td><span class={ "pill " + approvalPill[wo.ApprovalStatus] }>{ approvalLabels[wo.ApprovalStatus] }</span></td>
				</tr>
				<tr><th>客戶反映</th><td colspan="3">{ wo.CustomerComplaint }</td></tr>
				<tr>
					<th>SOP</th><td>{ sopStatusText(wo.SOPCompleted, len(sopRecords)) }</td>
					<th>建立時間</th><td>{ wo.CreatedAt.Format("2006-01-02 15:04") }</td>
				</tr>
				@InsuranceRow(wo, canEdit)
			</table>
			<div style="margin-top:16px">
				@StatusControls(wo, canEdit)
				<div style="margin-top:14px;padding-top:14px;border-top:1px solid #334155">
					<a class="btn btn-p" href={ "/work-orders/" + strconv.FormatInt(wo.ID, 10) + "/receipt" }>🧾 收據列印</a>
					<a class="btn btn-s" href={ "/work-orders/" + strconv.FormatInt(wo.ID, 10) + "/quotation?paper=a4" }>📋 估價單列印</a>
					<a class="btn btn-s" href={ "/work-orders/" + strconv.FormatInt(wo.ID, 10) + "/completion" }>✅ 完工證明</a>
					<a class="btn btn-s" href={ "/work-orders/" + strconv.FormatInt(wo.ID, 10) + "/worklogs" }>⏱ 技師工時</a>
					<a class="btn btn-s" href={ "/work-orders/" + strconv.FormatInt(wo.ID, 10) + "/photos" }>📷 車損照片</a>
				</div>
			</div>
		</div>

		// T2.6：SOP 檢查表
		<div class="card">
			<h2>📋 SOP 檢查表</h2>
			if len(sopRecords) == 0 {
				<div class="empty">尚未掛入 SOP 模板</div>
			}
			if len(sopRecords) > 0 {
				@SOPChecklistTable(wo.ID, sopRecords, canEdit)
			}
			if canEdit {
				if sopTemplateOpts != "" {
					<form method="POST" action={ "/work-orders/" + strconv.FormatInt(wo.ID, 10) + "/sop/attach" }
						style="margin-top:14px;display:flex;gap:8px;align-items:center">
						@components.CSRFInput()
						<select name="template_id"
							style="padding:6px 9px;border-radius:7px;border:1px solid #334155;background:#0f172a;color:#e2e8f0">
							@templ.Raw(sopTemplateOpts)
						</select>
						<button class="btn btn-s" type="submit">掛入 SOP 模板</button>
					</form>
				}
			}
		</div>

		<div class="card">
			<h2>工單項目</h2>
			<div id="wo-items">
				@WorkOrderItemsTable(wo.ID, items, techNames, canEdit, itemTotal, user)
			</div>
			if canEdit {
				@AddItemForm(wo.ID)
			}
		</div>

		@ApprovalRequestBlock(wo.ID, canCreateApproval, pendingApprovals)

		<div class="card">
			<h2>舊傷預檢</h2>
			<p style="color:#64748b;font-size:12.5px">選擇舊傷類型後，點擊車身示意圖記錄位置；既有標記可於下方刪除。</p>
			@WalkaroundCanvas(wo.ID, nil)
			<div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:10px">
				@WalkaroundMarkTypeSelect("scratch")
				<label>備註<input id="walkaround-note" type="text" placeholder="例：左前葉子板凹痕"></label>
			</div>
			<div id="walkaround-status" role="status" style="margin-top:6px;color:#94a3b8"></div>
		</div>

				if user.Role == "owner" || user.Role == "counter" {
			<div class="card">
				<h2>合計</h2>
				<table>
					<tr><th>項目小計</th><td class="num" id="item-total">{ money(itemTotal) }</td></tr>
					<tr>
						<th>工單總額</th>
						<td class="num" id="wo-total" style="font-size:20px;font-weight:700;color:#38bdf8">{ money(wo.TotalAmount) }</td>
					</tr>
				</table>
			</div>
		}
	}
}

// StatusFlow 狀態進度條。
templ StatusFlow(current string, labels map[string]string) {
	{{ flow := []string{"pending", "in_progress", "waiting_parts", "completed", "paid"} }}
	<div style="display:flex;gap:4px;margin:10px 0">
		for i, s := range flow {
			@StatusStep(s, current, labels[s], i < len(flow)-1)
		}
	</div>
}

templ StatusStep(step, current, label string, showArrow bool) {
	{{ idx := statusIndex(current) }}
	{{ curIdx := statusIndex(step) }}
	<span class="pill" style={ statusStepStyle(curIdx, idx) }>{ label }</span>
	if showArrow {
		<span style="color:#475569;align-self:center">→</span>
	}
}

// WorkOrderItemsTable 工單項目表格（HTMX 局部更新目標）。
templ WorkOrderItemsTable(woID int64, items []model.WorkOrderItem, techNames map[int64]string, canEdit bool, itemTotal float64, user model.User) {
	{{ showMoney := user.Role == "owner" || user.Role == "counter" }}
	if len(items) == 0 {
		<div class="empty">尚未加入任何工資或零件</div>
	}
	if len(items) > 0 {
	<table>
		<tr>
			<th>類型</th><th>描述</th><th class="num">數量</th>
			if showMoney {
				<th class="num">單價</th><th class="num">小計</th>
			}
			<th>主技師</th><th>助手</th><th>操作</th>
		</tr>
			for _, it := range items {
				<tr>
					<td>@components.Pill(itemTypeLabel(it.ItemType), "p-progress")</td>
					<td>{ it.Description }</td>
					<td class="num">{ strconv.Itoa(it.Quantity) }</td>
					if showMoney {
						<td class="num">{ money(it.UnitPrice) }</td>
						<td class="num">{ money(it.Subtotal) }</td>
					}
					<td>{ techNames[it.PrimaryTechnicianID] }</td>
					<td>{ techNames[it.AssistantTechID] }</td>
					if canEdit {
						<td>
							<a class="btn btn-d"
								hx-post={ "/work-orders/" + strconv.FormatInt(woID, 10) + "/items/" + strconv.FormatInt(it.ID, 10) + "/delete" }
								hx-target="#wo-items"
								hx-swap="innerHTML"
								hx-confirm="刪除此項目？">刪除</a>
							</td>
							}
							if canEdit == false {
							<td style="color:#64748b">—</td>
							}
				</tr>
			}
		</table>
	}
}

// AddItemForm 新增工單項目表單（HTMX 無刷新送出）。
templ AddItemForm(woID int64) {
	<form
		hx-post={ "/work-orders/" + strconv.FormatInt(woID, 10) + "/items" }
		hx-target="#wo-items"
		hx-swap="innerHTML"
		hx-on::after-request="if(event.detail.successful && event.detail.elt === event.currentTarget) { document.getElementById('partSearch').value=''; document.getElementById('inventoryItemId').value='0'; document.getElementById('itemDesc').value=''; document.getElementById('phraseSearch').value=''; document.getElementById('phraseResults').innerHTML=''; document.getElementById('partResults').innerHTML=''; }">
		@components.CSRFInput()
		<label>類型
			<select name="item_type" id="itemType" hx-on:change="togglePartSearch(this)">
				<option value="labor">工資</option>
				<option value="part">零件</option>
				<option value="subcontract">外包</option>
			</select>
		</label>
		<label class="full" id="partSearchWrap">零件搜尋（輸入零件名稱或料號；點選結果會自動切換為零件）
			<div class="search-bar">
				<input type="search" id="partSearch" name="q" class="search-input" placeholder="例：機油、煞車片、BE071" autocomplete="off"
					hx-get="/api/parts" hx-trigger="keyup changed delay:300ms, search"
					hx-target="#partResults" hx-swap="innerHTML"
					hx-on::after-request="if(event.detail.successful) document.getElementById('partResults').style.display='block';">
				@components.BarcodeScanUI("partScanBtn", "partSearch", "partScanBox")
			</div>
			<div id="partResults" class="part-results"></div>
			<input type="hidden" name="inventory_item_id" id="inventoryItemId" value="0">
		</label>
		<label class="full">描述
			<input name="description" id="itemDesc" placeholder="例：更換煞車油、補胎" required>
			<div style="margin-top:4px">
				<button type="button" class="btn btn-s" id="phraseBtn" onclick="togglePhrasePicker()">📝 常用片語</button>
				<div id="phrasePicker" style="display:none;margin-top:8px;border:1px solid #334155;border-radius:7px;padding:8px;background:#0f172a">
					<input type="search" id="phraseSearch" name="phrase" class="search-input" placeholder="搜尋片語..." style="width:100%;margin-bottom:8px"
						hx-get="/api/phrases/search" hx-trigger="keyup changed delay:300ms, search"
						hx-target="#phraseResults" hx-swap="innerHTML">
					<div id="phraseResults" style="max-height:150px;overflow-y:auto"></div>
				</div>
			</div>
		</label>
		<label>數量<input name="quantity" type="number" min="1" value="1" required></label>
		<label>單價<input name="unit_price" type="number" min="0" step="1" value="0" required id="unitPrice"></label>
		<label>主技師
			<div class="staff-picker">
				<input class="staff-picker-input" name="q" type="search" placeholder="搜尋姓名或部門" autocomplete="off"
					hx-get="/api/staff/search?format=picker&kind=employee" hx-trigger="keyup changed delay:250ms, search"
					hx-target="next .staff-picker-results" hx-swap="innerHTML">
				<input type="hidden" name="primary_technician_id" value="0">
				<div class="staff-picker-results"></div>
			</div>
		</label>
		<label>助手
			<div class="staff-picker">
				<input class="staff-picker-input" name="q" type="search" placeholder="搜尋姓名或部門" autocomplete="off"
					hx-get="/api/staff/search?format=picker&kind=employee" hx-trigger="keyup changed delay:250ms, search"
					hx-target="next .staff-picker-results" hx-swap="innerHTML">
				<input type="hidden" name="assistant_technician_id" value="0">
				<div class="staff-picker-results"></div>
			</div>
		</label>
		<div class="full"><button class="btn btn-p" type="submit">加入項目</button></div>
	</form>
	@PartSearchScript()
	@PhrasePickerScript()
}

// StatusControls 狀態切換控制（HTMX 無刷新）。
templ StatusControls(wo model.WorkOrder, canEdit bool) {
	if canEdit {
		<form hx-post={ "/work-orders/" + strconv.FormatInt(wo.ID, 10) + "/status" }
			hx-target="#wo-status"
			hx-swap="innerHTML"
			style="display:inline;margin:0 8px">
			@components.CSRFInput()
			<select name="status" onchange="htmx.trigger(this.closest('form'), 'submit')"
				style="padding:6px 9px;border-radius:7px;border:1px solid #334155;background:#0f172a;color:#e2e8f0">
				<option value="pending" selected?={ wo.Status == "pending" }>待處理</option>
				<option value="in_progress" selected?={ wo.Status == "in_progress" }>進行中</option>
				<option value="waiting_parts" selected?={ wo.Status == "waiting_parts" }>等零件</option>
				<option value="completed" selected?={ wo.Status == "completed" }>已完成</option>
				<option value="paid" selected?={ wo.Status == "paid" }>已結帳</option>
			</select>
		</form>
		<form hx-post={ "/work-orders/" + strconv.FormatInt(wo.ID, 10) + "/approval" }
			hx-target="#wo-approval"
			hx-swap="innerHTML"
			style="display:inline;margin:0 8px">
			@components.CSRFInput()
			<select name="approval_status" onchange="htmx.trigger(this.closest('form'), 'submit')"
				style="padding:6px 9px;border-radius:7px;border:1px solid #334155;background:#0f172a;color:#e2e8f0">
				<option value="pending" selected?={ wo.ApprovalStatus == "pending" }>待核准</option>
				<option value="approved" selected?={ wo.ApprovalStatus == "approved" }>已核准</option>
				<option value="rejected" selected?={ wo.ApprovalStatus == "rejected" }>已駁回</option>
			</select>
		</form>
		<form hx-post={ "/work-orders/" + strconv.FormatInt(wo.ID, 10) + "/sop" }
			hx-target="#wo-sop"
			hx-swap="innerHTML"
			style="display:inline;margin:0 8px">
			@components.CSRFInput()
			<button class="btn btn-s" type="submit">{ sopLabel(wo.SOPCompleted) }</button>
		</form>
	}
}

// InsuranceRow 保險理賠資訊列。
templ InsuranceRow(wo model.WorkOrder, canEdit bool) {
	if wo.IsInsurance || wo.InsuranceCompanyID > 0 {
		<tr><th>件別</th><td><span class="pill p-progress">保險理賠</span></td>
		<th>保險公司</th><td>{ wo.InsuranceName }</td></tr>
		<tr><th>理賠編號</th><td>{ wo.ClaimNo }</td>
		<th>事故日期</th><td>{ wo.AccidentDate }</td></tr>
		<tr><th>自負額</th><td>{ money(wo.DeductibleAmount) }</td><th></th><td></td></tr>
	}
	if wo.IsInsurance == false && wo.InsuranceCompanyID == 0 {
		<tr><th>件別</th><td><span class="pill">自費</span></td>
		<th></th><td></td></tr>
	}
	<tr>
		<td colspan="4">
			if canEdit {
				<form class="frm" method="POST" action={ "/work-orders/" + strconv.FormatInt(wo.ID, 10) + "/claim" }>
					@components.CSRFInput()
					<label>理賠日期<input type="date" name="claim_date" value={ wo.ClaimDate }></label>
					<label>理賠金額<input type="number" name="claim_amount" min="0" step="0.01" value={ strconv.FormatFloat(wo.ClaimAmount, 'f', 2, 64) }></label>
					<label class="full">理賠備註<textarea name="claim_note">{ wo.ClaimNote }</textarea></label>
					<div class="full"><button class="btn btn-s" type="submit">儲存理賠資料</button></div>
				</form>
			}
			if !canEdit {
				<b>理賠日期</b> { wo.ClaimDate }
				<b>理賠金額</b> { money(wo.ClaimAmount) }
			}
			if !canEdit && wo.ClaimNote != "" {
				<p>{ wo.ClaimNote }</p>
			}
		</td>
	</tr>
}

templ SOPChecklistTable(woID int64, records []model.SOPRecord, canEdit bool) {
	<table>
		<tr><th>檢查項目</th><th>必填</th><th>狀態</th><th>完成者</th><th>完成時間</th></tr>
		for _, r := range records {
			<tr>
				<td>{ r.Description }</td>
				<td>{ yesNo(r.Required) }</td>
				<td>
					if r.Completed {
						if canEdit {
							<form method="POST" action={ "/work-orders/" + strconv.FormatInt(woID, 10) + "/sop/records/" + strconv.FormatInt(r.ID, 10) + "/toggle" }>
								@components.CSRFInput()
								<button class="pill p-completed" type="submit">已完成</button>
							</form>
						} else {
							<span class="pill p-completed">已完成</span>
						}
					}
					if !r.Completed {
						if canEdit {
							<form method="POST" action={ "/work-orders/" + strconv.FormatInt(woID, 10) + "/sop/records/" + strconv.FormatInt(r.ID, 10) + "/toggle" }>
								@components.CSRFInput()
								<button class="pill p-pending" type="submit">未勾選</button>
							</form>
						} else {
							<span class="pill p-pending">未勾選</span>
						}
					}
				</td>
				<td>{ r.CompletedByName }</td>
				<td>{ r.CompletedAtText }</td>
			</tr>
		}
	</table>
}

// PartSearchScript 零件即時搜尋 JS。
templ PartSearchScript() {
	<script>
		function togglePartSearch(sel) {
			var wrap = document.getElementById('partSearchWrap');
			if (wrap) wrap.style.display = '';
			if (sel.value !== 'part') {
				document.getElementById('inventoryItemId').value = '0';
			}
		}
		(function(){
			var type = document.getElementById('itemType');
			if (type) togglePartSearch(type);
			var search = document.getElementById('partSearch');
			var results = document.getElementById('partResults');
			var hidden = document.getElementById('inventoryItemId');
			var desc = document.getElementById('itemDesc');
			var price = document.getElementById('unitPrice');
			if (!search || !results) return;
			results.addEventListener('click', function(e){
				var item = e.target.closest('.part-result-item');
				if (!item) return;
				var type = document.getElementById('itemType');
				if (type) type.value = 'part';
				hidden.value = item.dataset.partId;
				search.value = item.dataset.partName + ' / ' + item.dataset.partNumber;
				desc.value = item.dataset.partName;
				price.value = item.dataset.partPrice;
				results.innerHTML = '';
			});
			document.addEventListener('click', function(e){
				if (!results.contains(e.target) && e.target !== search) results.style.display = 'none';
			});
		})();
	</script>
}

// PhrasePickerScript 技師片語選擇 JS（T2.7）。
templ PhrasePickerScript() {
	<script>
		function togglePhrasePicker() {
			var picker = document.getElementById('phrasePicker');
			if (picker) picker.style.display = picker.style.display === 'none' ? 'block' : 'none';
		}
		(function(){
			var search = document.getElementById('phraseSearch');
			var results = document.getElementById('phraseResults');
			var desc = document.getElementById('itemDesc');
			if (!search || !results) return;
			results.addEventListener('click', function(e){
				var item = e.target.closest('.phrase-result-item');
				if (!item) return;
				desc.value = item.dataset.phrase;
				results.innerHTML = '';
				search.value = '';
			});
		})();
	</script>
}

// 以下為 templ 內使用的輔助函式（Go 邏輯部分）。
func statusIndex(s string) int {
	flow := []string{"pending", "in_progress", "waiting_parts", "completed", "paid"}
	for i, x := range flow {
		if x == s {
			return i
		}
	}
	return 0
}

func statusStepStyle(stepIdx, currentIdx int) string {
	if stepIdx < currentIdx {
		return "background:#1e3a5f;color:#93c5fd"
	}
	if stepIdx == currentIdx {
		return "background:#1d4ed8;color:#fff"
	}
	return "background:#334155;color:#64748b"
}

func itemTypeLabel(t string) string {
	switch t {
	case "labor":
		return "工資"
	case "part":
		return "零件"
	case "subcontract":
		return "外包"
	}
	return t
}

func yesNo(b bool) string {
	if b {
		return "是"
	}
	return "否"
}

func sopLabel(done bool) string {
	if done {
		return "取消 SOP"
	}
	return "標記 SOP 完成"
}

func sopStatusText(completed bool, total int) string {
	if total == 0 { return "未掛入模板" }
	if completed { return "已完成" }
	return "進行中"
}

func money(f float64) string {
	return "$" + strconv.FormatFloat(f, 'f', 0, 64)
}

var _ = time.Now
