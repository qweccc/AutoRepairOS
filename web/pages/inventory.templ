package pages

import (
	"strconv"

	"autorepairos/internal/model"
	"autorepairos/web/components"
)

type InventoryRow struct {
	ID            int64
	PartNumber    string
	Name          string
	Category      string
	BinLocation   string
	SupplierName  string
	CostPrice     float64
	SellingPrice  float64
	StockQuantity int
	MinSafety     int
	LowStock      bool
	ItemKind      string
}

// ListInventoryPage 庫存列表頁（HTMX 即時搜尋）。
templ ListInventoryPage(rows []InventoryRow, total, lowCount, negCount, page, size int,
	q string, lowOnly bool, showMoney bool, catTabsHTML string, negBannerHTML string) {
	@components.Layout("庫存管理", "/inventory", "owner", "owner", "AutoRepair OS") {
		if negBannerHTML != "" {
			@templ.Raw(negBannerHTML)
		}
		<div class="card">
			<h2>新增零件</h2>
			<form class="frm" method="POST" action="/inventory">
				<label>料號<input name="part_number" required></label>
				<label>名稱<input name="name" required></label>
				<label>庫位<input name="bin_location" required placeholder="例 A-01-3"></label>
				<label>條碼<input name="barcode"></label>
				<label>供應商<select name="supplier_id"><option value="0">無</option>{ children... }</select></label>
				if showMoney {
					<label>成本<input name="cost_price" type="number" min="0" step="1" value="0"></label>
				}
				<label>售價<input name="selling_price" type="number" min="0" step="1" value="0"></label>
				<label>庫存數量<input name="stock_quantity" type="number" value="0"></label>
				<label>安全庫存<input name="min_safety_stock" type="number" min="0" value="5"></label>
				<div class="full"><button class="btn btn-p" type="submit">新增零件</button></div>
			</form>
		</div>
		<div class="card">
			<h2>零件列表（符合條件 { strconv.Itoa(total) } 筆，低庫存 { strconv.Itoa(lowCount) } 種）</h2>
			<div style="margin-bottom:12px;display:flex;gap:6px;flex-wrap:wrap;align-items:center">
				@templ.Raw(catTabsHTML)
			</div>
			// HTMX 即時搜尋
			<input type="search" name="q" value={ q }
				placeholder="搜尋名稱 / 料號 / 條碼 / 庫位"
				hx-get="/api/inventory/search"
				hx-trigger="keyup changed delay:300ms, search"
				hx-target="#inventory-rows"
				hx-swap="innerHTML"
				style="padding:8px 10px;border-radius:7px;border:1px solid #334155;background:#0f172a;color:#e2e8f0;width:300px;margin-bottom:12px">
			<a class="btn btn-s" href="/inventory">清除</a>
			<a class="btn btn-s" href="/inventory/movements">異動紀錄</a>
			<table>
				<tr>
					<th>料號</th><th>名稱</th><th>類別</th><th>庫位</th><th>供應商</th>
					if showMoney {
						<th class="num">成本</th>
					}
					<th class="num">售價</th><th class="num">庫存</th><th class="num">安全值</th><th>操作</th>
				</tr>
				<tbody id="inventory-rows">
					for _, it := range rows {
						@InventoryRowContent(it, showMoney)
					}
				</tbody>
			</table>
			if len(rows) == 0 {
				<div class="empty">沒有零件資料</div>
			}
			@components.Pager("/inventory", page, calcPages(total, size), total)
		</div>
	}
}

templ InventoryRowContent(it InventoryRow, showMoney bool) {
	<tr>
		<td><code>{ it.PartNumber }</code></td>
		<td>
			{ it.Name }
			if it.ItemKind == "labor" {
				<span style="color:#94a3b8;font-size:11px">(工資)</span>
			}
		</td>
		<td>
			if it.Category != "" {
				<span class="pill" style="background:#1e3a5f;color:#bae6fd">{ it.Category }</span>
			} else {
				<span style="color:#64748b">-</span>
			}
		</td>
		<td>{ orEmpty(it.BinLocation) }</td>
		<td>{ orEmpty(it.SupplierName) }</td>
		if showMoney {
			<td class="num">{ moneyFmt(it.CostPrice) }</td>
		}
		<td class="num">{ moneyFmt(it.SellingPrice) }</td>
		<td class="num">
			if it.LowStock {
				<b style="color:#f87171">{ strconv.Itoa(it.StockQuantity) } ⚠</b>
			} else {
				{ strconv.Itoa(it.StockQuantity) }
			}
		</td>
		<td class="num">{ strconv.Itoa(it.MinSafety) }</td>
		<td>
			<a class="btn btn-s" href={ "/inventory/" + strconv.FormatInt(it.ID, 10) + "/edit" }>編輯</a>
			<a class="btn btn-o" href={ "/inventory/" + strconv.FormatInt(it.ID, 10) + "/stock" }>調庫</a>
			<a class="btn btn-d" href={ "/inventory/" + strconv.FormatInt(it.ID, 10) + "/delete" }
				data-confirm="確定刪除此零件？">刪除</a>
		</td>
	</tr>
}

// InventorySearchRows HTMX 即時搜尋回傳的純列。
templ InventorySearchRows(rows []InventoryRow, showMoney bool) {
	if len(rows) == 0 {
		<tr><td colspan="9" style="color:#64748b;text-align:center;padding:20px">查無零件</td></tr>
	}
	for _, it := range rows {
		@InventoryRowContent(it, showMoney)
	}
}

var _ = model.InventoryItem{}
