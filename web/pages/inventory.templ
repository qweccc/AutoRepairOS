package pages

import (
	"fmt"
	"strconv"

	"autorepairos/internal/i18n"
	"autorepairos/internal/model"
	"autorepairos/web/components"
)

type InventoryRow struct {
	ID            int64
	PartNumber    string
	Name          string
	Category      string
	BinLocation   string
	SupplierName  string
	CostPrice     float64
	SellingPrice  float64
	StockQuantity int
	MinSafety     int
	LowStock      bool
	ItemKind      string
}

// ListInventoryPage 庫存列表頁（HTMX 即時搜尋）。
// InventoryCreateForm carries create-form state for same-screen error
// re-rendering (see CustomerCreateForm).
type InventoryCreateForm struct {
	ErrMsg    string
	Part      string
	Name      string
	Bin       string
	Barcode   string
	Cost      string
	Selling   string
	Stock     string
	MinSafety string
}

templ ListInventoryPage(rows []InventoryRow, total, lowCount, negCount, page, size int,
	q string, lowOnly bool, showMoney bool, catTabsHTML string, negBannerHTML string,
	categoryOptionsHTML string, form InventoryCreateForm, user model.User) {
	@components.Layout(i18n.T(ctx, "inventory.page_title"), "/inventory", user, AppName) {
		if negBannerHTML != "" {
			@templ.Raw(negBannerHTML)
		}
		<div class="card">
			<h2>{ i18n.T(ctx, "inventory.new") }</h2>
			if form.ErrMsg != "" {
				<div class="msg msg-err">{ form.ErrMsg }</div>
			}
			<form class="frm" method="POST" action="/inventory">
				@components.CSRFInput()
				<label>{ i18n.T(ctx, "inventory.field.part_number") }<input name="part_number" required value={ form.Part }></label>
				<label>{ i18n.T(ctx, "inventory.field.name") }<input name="name" required value={ form.Name }></label>
				<label>{ i18n.T(ctx, "inventory.field.category") }
					<select name="category">
						<option value="">{ i18n.T(ctx, "inventory.uncategorized") }</option>
						@templ.Raw(categoryOptionsHTML)
					</select>
				</label>
				<label>{ i18n.T(ctx, "inventory.field.bin") }<input name="bin_location" required placeholder={ i18n.T(ctx, "inventory.bin_placeholder") } value={ form.Bin }></label>
				<label>{ i18n.T(ctx, "inventory.field.barcode") }<input name="barcode" value={ form.Barcode }></label>
				<label>{ i18n.T(ctx, "inventory.field.supplier") }<select name="supplier_id"><option value="0">{ i18n.T(ctx, "inventory.none") }</option>{ children... }</select></label>
				if showMoney {
					<label>{ i18n.T(ctx, "inventory.field.cost") }<input name="cost_price" type="number" min="0" step="1" value={ form.Cost }></label>
				}
				<label>{ i18n.T(ctx, "inventory.field.selling") }<input name="selling_price" type="number" min="0" step="1" value={ form.Selling }></label>
				<label>{ i18n.T(ctx, "inventory.field.stock_quantity") }<input name="stock_quantity" type="number" value={ form.Stock }></label>
				<label>{ i18n.T(ctx, "inventory.field.min_safety") }<input name="min_safety_stock" type="number" min="0" value={ form.MinSafety }></label>
				<div class="full"><button class="btn btn-p" type="submit">{ i18n.T(ctx, "inventory.new") }</button></div>
			</form>
		</div>
		<div class="card">
			<h2>{ fmt.Sprintf(i18n.T(ctx, "inventory.list_title"), total, lowCount) }</h2>
			<div style="margin-bottom:12px;display:flex;gap:6px;flex-wrap:wrap;align-items:center">
				@templ.Raw(catTabsHTML)
			</div>
			// HTMX 即時搜尋
			<div class="search-bar">
				<input type="search" id="inventorySearch" class="search-input wide" name="q" value={ q }
					placeholder={ i18n.T(ctx, "inventory.search_placeholder") }
					hx-get="/api/inventory/search"
					hx-trigger="keyup changed delay:300ms, search"
					hx-target="#inventory-rows"
					hx-swap="innerHTML">
				@components.BarcodeScanUI("inventoryScanBtn", "inventorySearch", "inventoryScanBox")
				<a class="btn btn-s" href="/inventory">{ i18n.T(ctx, "inventory.clear") }</a>
			</div>
			<a class="btn btn-s" href="/inventory/movements">{ i18n.T(ctx, "inventory.movements") }</a>
			<table>
				<tr>
					<th>{ i18n.T(ctx, "inventory.col.part_number") }</th><th>{ i18n.T(ctx, "inventory.col.name") }</th><th>{ i18n.T(ctx, "inventory.col.category") }</th><th>{ i18n.T(ctx, "inventory.col.bin") }</th><th>{ i18n.T(ctx, "inventory.col.supplier") }</th>
					if showMoney {
						<th class="num">{ i18n.T(ctx, "inventory.col.cost") }</th>
					}
					<th class="num">{ i18n.T(ctx, "inventory.col.selling") }</th><th class="num">{ i18n.T(ctx, "inventory.col.stock") }</th><th class="num">{ i18n.T(ctx, "inventory.col.safety") }</th><th>{ i18n.T(ctx, "inventory.col.actions") }</th>
				</tr>
				<tbody id="inventory-rows">
					for _, it := range rows {
						@InventoryRowContent(it, showMoney)
					}
				</tbody>
			</table>
			if len(rows) == 0 {
				<div class="empty">{ i18n.T(ctx, "inventory.empty") }</div>
			}
			@components.Pager("/inventory", page, calcPages(total, size), total)
		</div>
	}
}

templ InventoryRowContent(it InventoryRow, showMoney bool) {
	<tr>
		<td><code>{ it.PartNumber }</code></td>
		<td>
			{ it.Name }
			if it.ItemKind == "labor" {
				<span style="color:var(--text-sub);font-size:11px">({ i18n.T(ctx, "inventory.labor") })</span>
			}
		</td>
		<td>
			if it.Category != "" {
				<span class="pill" style="background:var(--primary-bg);color:var(--primary)">{ it.Category }</span>
			} else {
				<span style="color:var(--muted)">-</span>
			}
		</td>
		<td>{ orEmpty(it.BinLocation) }</td>
		<td>{ orEmpty(it.SupplierName) }</td>
		if showMoney {
			<td class="num">{ moneyFmt(it.CostPrice) }</td>
		}
		<td class="num">{ moneyFmt(it.SellingPrice) }</td>
		<td class="num">
			if it.LowStock {
				<b style="color:var(--danger)">{ strconv.Itoa(it.StockQuantity) } ⚠</b>
			} else {
				{ strconv.Itoa(it.StockQuantity) }
			}
		</td>
		<td class="num">{ strconv.Itoa(it.MinSafety) }</td>
		<td>
			<a class="btn btn-s" href={ "/inventory/" + strconv.FormatInt(it.ID, 10) + "/edit" }>{ i18n.T(ctx, "common.edit") }</a>
			<a class="btn btn-o" href={ "/inventory/" + strconv.FormatInt(it.ID, 10) + "/stock" }>{ i18n.T(ctx, "inventory.stock_adjust") }</a>
			<a class="btn btn-d" href={ "/inventory/" + strconv.FormatInt(it.ID, 10) + "/delete" }
				hx-post={ "/inventory/" + strconv.FormatInt(it.ID, 10) + "/delete" }
				data-confirm={ i18n.T(ctx, "inventory.delete_confirm") }>{ i18n.T(ctx, "common.delete") }</a>
		</td>
	</tr>
}

// InventorySearchRows HTMX 即時搜尋回傳的純列。
templ InventorySearchRows(rows []InventoryRow, showMoney bool) {
	if len(rows) == 0 {
		<tr><td colspan="9" style="color:var(--muted);text-align:center;padding:20px">{ i18n.T(ctx, "inventory.search_empty") }</td></tr>
	}
	for _, it := range rows {
		@InventoryRowContent(it, showMoney)
	}
}

var _ = model.InventoryItem{}
