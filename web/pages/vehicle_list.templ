package pages

import (
	"strconv"

	"autorepairos/internal/i18n"
	"autorepairos/internal/model"
	"autorepairos/web/components"
)

// ListVehiclesPage 車輛列表頁（新增表單 + HTMX 即時搜尋 + 列表）。
type VehicleRow struct {
	ID               int64
	PlateNumber      string
	BrandModel       string
	VehicleTypeLabel string
	ManufactureYear  int
	CustomerName     string
	DateCell         string
	KmCell           string
	CanEdit          bool
}

templ VehicleSearchRows(rows []VehicleRow) {
	if len(rows) == 0 {
		<tr><td colspan="9" style="color:var(--muted);text-align:center;padding:20px">{ i18n.T(ctx, "vehicle.no_results") }</td></tr>
	}
	for _, row := range rows {
		<tr>
			<td>{ strconv.FormatInt(row.ID, 10) }</td>
			<td><b>{ row.PlateNumber }</b></td>
			<td>{ row.BrandModel }</td>
			<td>
				if row.VehicleTypeLabel != "" {
					<span class="pill" style="background:var(--primary-bg);color:var(--primary)">{ row.VehicleTypeLabel }</span>
				} else {
					<span style="color:var(--muted)">-</span>
				}
			</td>
			<td>{ intOrBlank(row.ManufactureYear) }</td>
			<td>{ row.CustomerName }</td>
			<td>@templ.Raw(row.DateCell)</td>
			<td>@templ.Raw(row.KmCell)</td>
			<td>
				<a class="btn btn-p" href={ "/work-orders/new?vehicle=" + strconv.FormatInt(row.ID, 10) }>{ i18n.T(ctx, "vehicle.open_workorder") }</a>
				<a class="btn btn-o" href={ "/vehicles/" + strconv.FormatInt(row.ID, 10) }>{ i18n.T(ctx, "vehicle.history") }</a>
				<a class="btn btn-s" href={ "/vehicles/" + strconv.FormatInt(row.ID, 10) + "/edit" }>{ i18n.T(ctx, "vehicle.edit") }</a>
			</td>
		</tr>
	}
}

// vehiclePlateFieldMap 行照 OCR 欄位 → 車輛表單 input name 的對照。
// 三個車輛表單（列表頁內嵌新增、編輯頁、獨立新增頁）共用同一份 JSON，
// 避免三處各寫一遍然後漏欄位對不起來。
const vehiclePlateFieldMap = `{"plate_number":"plate_number","vin":"vin","engine_number":"engine_number","owner_name":"owner_name","owner_address":"owner_address","owner_id_number":"owner_id_number","displacement":"displacement","manufacture_date":"manufacture_date","license_issue_date":"license_issue_date","seating_capacity":"seating_capacity"}`

templ ListVehiclesPage(rows []VehicleRow, total, page, size int,
	q string, filterCustomer int64,
	newModelOptions, newVehicleTypeOptions, newFuelTypeOptions, newBodyStyleOptions string, user model.User) {
	@components.Layout(i18n.T(ctx, "vehicle.title"), "/vehicles", user, AppName) {
		<div class="card">
			<h2>{ i18n.T(ctx, "vehicle.new_title") }</h2>
			<form class="frm" method="POST" action="/vehicles">
				@components.CSRFInput()
				@components.PlateScanUI(vehiclePlateFieldMap)
				<label>{ i18n.T(ctx, "vehicle.customer") }<input name="customer_query" required placeholder={i18n.T(ctx, "vehicle.customer_ph")}></label>
				<label>{ i18n.T(ctx, "vehicle.plate") }<input name="plate_number" required autocapitalize="characters" autocomplete="off"/></label>
				<label>{ i18n.T(ctx, "vehicle.brand_model") }
					<select name="brand_model" id="brandModelSel" required onchange="toggleModelOther()">
						@templ.Raw(newModelOptions)
					</select>
				</label>
				<label id="brandModelOtherWrap" style="display:none">{ i18n.T(ctx, "vehicle.other_model") }
					<input name="brand_model_other" id="brandModelOther" placeholder={i18n.T(ctx, "vehicle.other_model_ph_example")}>
				</label>
				<label>{ i18n.T(ctx, "vehicle.vehicle_type") }<select name="vehicle_type">@templ.Raw(newVehicleTypeOptions)</select></label>
				<label>{ i18n.T(ctx, "vehicle.fuel_type") }<select name="fuel_type">@templ.Raw(newFuelTypeOptions)</select></label>
				<label>{ i18n.T(ctx, "vehicle.body_style") }<select name="body_style">@templ.Raw(newBodyStyleOptions)</select></label>
				<label>{ i18n.T(ctx, "vehicle.driver") }<input name="driver_name" placeholder={i18n.T(ctx, "vehicle.driver_ph")}></label>
				<label>{ i18n.T(ctx, "vehicle.driver_phone") }<input name="driver_phone" placeholder={i18n.T(ctx, "vehicle.driver_phone_ph")}></label>
				<label>{ i18n.T(ctx, "vehicle.contact") }<input name="contact_name" placeholder={i18n.T(ctx, "vehicle.contact_ph")}></label>
				<label>{ i18n.T(ctx, "vehicle.contact_phone") }<input name="contact_phone" placeholder={i18n.T(ctx, "vehicle.contact_phone_ph")}></label>
				<label>{ i18n.T(ctx, "vehicle.owner") }<input name="owner_name" placeholder={i18n.T(ctx, "vehicle.owner_ph")}></label>
				<label>{ i18n.T(ctx, "vehicle.owner_address") }<input name="owner_address" placeholder={i18n.T(ctx, "vehicle.owner_address_ph")}></label>
				<label>{ i18n.T(ctx, "vehicle.owner_id") }<input name="owner_id_number" placeholder={i18n.T(ctx, "vehicle.owner_id_ph")}></label>
				<label>{ i18n.T(ctx, "vehicle.license_expiry") }<input name="license_expiry_date" type="date"></label>
				<label>{ i18n.T(ctx, "vehicle.color") }<input name="color" placeholder={i18n.T(ctx, "vehicle.color_ph")}></label>
				<label>{ i18n.T(ctx, "vehicle.door_count") }<input name="door_count" type="number" min="0" max="10" placeholder={i18n.T(ctx, "vehicle.door_count_ph")}></label>
				<label>{ i18n.T(ctx, "vehicle.manufacture_date") }<input name="manufacture_date" placeholder={i18n.T(ctx, "vehicle.manufacture_date_ph")}></label>
				<label>{ i18n.T(ctx, "vehicle.license_issue_date") }<input name="license_issue_date" placeholder={i18n.T(ctx, "vehicle.license_issue_date_ph")}></label>
				<label>{ i18n.T(ctx, "vehicle.manufacture_year") }<input name="manufacture_year" type="number" min="0" max="9999" placeholder={i18n.T(ctx, "vehicle.manufacture_year_ph")}></label>
				<label>{ i18n.T(ctx, "vehicle.displacement") }<input name="displacement" type="number" min="0" placeholder="c.c."></label>
				<label>{ i18n.T(ctx, "vehicle.seating") }<input name="seating_capacity" type="number" min="0" max="99" placeholder={i18n.T(ctx, "vehicle.seating_ph")}></label>
				<label>{ i18n.T(ctx, "vehicle.curb_weight") }<input name="curb_weight" type="number" min="0" placeholder="kg"></label>
				<label>{ i18n.T(ctx, "vehicle.gross_weight") }<input name="gross_weight" type="number" min="0" placeholder="kg"></label>
				<label>{ i18n.T(ctx, "vehicle.tire_size") }<input name="tire_size" placeholder={i18n.T(ctx, "vehicle.tire_size_ph")}></label>
				<label>{ i18n.T(ctx, "vehicle.wheelbase") }<input name="wheelbase" type="number" min="0" placeholder="mm"></label>
				<label>{ i18n.T(ctx, "vehicle.vin") }<input name="vin" placeholder={i18n.T(ctx, "vehicle.vin_ph")}></label>
				<label>{ i18n.T(ctx, "vehicle.engine_number") }<input name="engine_number"></label>
				<label>{ i18n.T(ctx, "vehicle.inspection_due") }<input name="inspection_due_date" type="date"></label>
				<label>{ i18n.T(ctx, "vehicle.maint_interval_months") }<input name="maint_interval_months" type="number" min="1" max="60" value="6"></label>
				<label>{ i18n.T(ctx, "vehicle.maint_interval_km") }<input name="maint_interval_km" type="number" min="500" value="5000"></label>
				<div class="full"><button class="btn btn-p" type="submit">{ i18n.T(ctx, "vehicle.create") }</button></div>
			</form>
			<p style="color:var(--muted);font-size:12.5px;margin-top:10px">
				{ i18n.T(ctx, "vehicle.model_note") }
			</p>
			<script>
				function toggleModelOther(){
					var sel = document.getElementById('brandModelSel');
					var wrap = document.getElementById('brandModelOtherWrap');
					var other = document.getElementById('brandModelOther');
					if (!sel || !wrap) return;
					var isOther = sel.value === '__OTHER__';
					wrap.style.display = isOther ? '' : 'none';
					if (other) other.disabled = !isOther;
					if (isOther) {
						sel.removeAttribute('name');
						if (other) { other.setAttribute('name','brand_model'); other.required = true; }
					} else {
						sel.setAttribute('name','brand_model');
						if (other) { other.removeAttribute('name'); other.required = false; }
					}
				}
			</script>
		</div>
		<div class="card">
			<h2>{ i18n.T(ctx, "vehicle.list_heading") + " " + strconv.Itoa(total) + " " + i18n.T(ctx, "vehicle.list_unit") }</h2>
			<form method="GET" action="/vehicles" style="margin-bottom:12px">
				<input type="search" name="q" value={ q }
					placeholder={i18n.T(ctx, "vehicle.search_ph")}
					hx-get="/api/vehicles/search"
					hx-trigger="keyup changed delay:300ms, search"
					hx-target="#vehicle-rows"
					hx-swap="innerHTML"
					style="padding:8px 10px;border-radius:7px;border:1px solid var(--border);background:var(--surface);color:var(--text);width:320px">
				<button class="btn btn-p" type="submit">{ i18n.T(ctx, "vehicle.search") }</button>
				<a class="btn btn-s" href="/vehicles">{ i18n.T(ctx, "vehicle.clear") }</a>
			</form>
			if len(rows) == 0 {
				<div class="empty">{ i18n.T(ctx, "vehicle.empty") }</div>
			}
			if len(rows) > 0 {
				<table>
					<tr>
						<th>ID</th><th>{ i18n.T(ctx, "vehicle.col_plate") }</th><th>{ i18n.T(ctx, "vehicle.col_model") }</th><th>{ i18n.T(ctx, "vehicle.col_type") }</th><th>{ i18n.T(ctx, "vehicle.col_year") }</th><th>{ i18n.T(ctx, "vehicle.col_owner") }</th>
						<th>{ i18n.T(ctx, "vehicle.col_next_date") }</th><th>{ i18n.T(ctx, "vehicle.col_next_km") }</th><th>{ i18n.T(ctx, "vehicle.col_actions") }</th>
					</tr>
					<tbody id="vehicle-rows">
						for _, row := range rows {
							<tr>
								<td>{ strconv.FormatInt(row.ID, 10) }</td>
								<td><b>{ row.PlateNumber }</b></td>
								<td>{ row.BrandModel }</td>
								<td>
									if row.VehicleTypeLabel != "" {
										<span class="pill" style="background:var(--primary-bg);color:var(--primary)">{ row.VehicleTypeLabel }</span>
									}
									if row.VehicleTypeLabel == "" {
										<span style="color:var(--muted)">-</span>
									}
								</td>
								<td>{ intOrBlank(row.ManufactureYear) }</td>
								<td>{ row.CustomerName }</td>
								<td>@templ.Raw(row.DateCell)</td>
								<td>@templ.Raw(row.KmCell)</td>
								<td>
									<a class="btn btn-p" href={ "/work-orders/new?vehicle=" + strconv.FormatInt(row.ID, 10) }>{ i18n.T(ctx, "vehicle.open_workorder") }</a>
									<a class="btn btn-o" href={ "/vehicles/" + strconv.FormatInt(row.ID, 10) }>{ i18n.T(ctx, "vehicle.history") }</a>
									<a class="btn btn-s" href={ "/vehicles/" + strconv.FormatInt(row.ID, 10) + "/edit" }>{ i18n.T(ctx, "vehicle.edit") }</a>
									<a class="btn btn-d" href={ "/vehicles/" + strconv.FormatInt(row.ID, 10) + "/delete" }
										hx-post={ "/vehicles/" + strconv.FormatInt(row.ID, 10) + "/delete" }
										data-confirm={i18n.T(ctx, "vehicle.delete_confirm")}>{ i18n.T(ctx, "vehicle.delete") }</a>
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
			@components.Pager("/vehicles", page, calcPages(total, size), total)
		</div>
	}
}

func calcPages(total, size int) int {
	if size <= 0 {
		return 1
	}
	pages := (total + size - 1) / size
	if pages < 1 {
		pages = 1
	}
	return pages
}

var _ = model.Vehicle{}
