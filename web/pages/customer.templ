package pages

import (
	"fmt"
	"html"
	"strconv"

	"autorepairos/internal/i18n"
	"autorepairos/internal/model"
	"autorepairos/web/components"
)

type CustomerRow struct {
	ID              int64
	Name            string
	Phone           string
	Tags            string
	Address         string
	Notification    string
	LineUserID      string
	TelegramUserID  string
	TotalSpent      float64
	UnpaidAmount    float64
}

// CustomerCreateForm carries create-form state for same-screen error
// re-rendering: ErrMsg shown under the form title, remaining fields refill
// the user's input after a failed POST.
type CustomerCreateForm struct {
	ErrMsg    string
	Name      string
	Phone     string
	Address   string
	Tags      string
	Campaign  string
	Notes     string
	Pref      string
}

// ListCustomersPage 客戶列表頁（HTMX 即時搜尋）。
templ ListCustomersPage(rows []CustomerRow, total, page, size int, q string, form CustomerCreateForm, user model.User) {
	@components.Layout(i18n.T(ctx, "customer.title"), "/customers", user, AppName) {
		<div class="card">
			<h2>{ i18n.T(ctx, "customer.new") }</h2>
			if form.ErrMsg != "" {
				<div class="msg msg-err">{ form.ErrMsg }</div>
			}
			<form class="frm" method="POST" action="/customers">
				@components.CSRFInput()
				<label>{ i18n.T(ctx, "customer.field.name") }<input name="name" required placeholder={ i18n.T(ctx, "customer.name_placeholder") } value={ form.Name }></label>
				<label>{ i18n.T(ctx, "customer.field.phone") }<input name="phone" type="tel" required placeholder={ i18n.T(ctx, "customer.phone_placeholder") } value={ form.Phone }></label>
				<label>{ i18n.T(ctx, "customer.notification_preference") }
					<select name="notification_preference">
						<option value="none" selected>{ i18n.T(ctx, "customer.notify_none") }</option>
						<option value="line">LINE</option>
						<option value="telegram">Telegram</option>
						<option value="sms">SMS</option>
					</select>
				</label>
				<label class="full">{ i18n.T(ctx, "customer.field.address") }<input name="address" value={ form.Address }></label>
				<label class="full">{ i18n.T(ctx, "customer.field.tags") }<input name="tags" placeholder={ i18n.T(ctx, "customer.tags_placeholder") } value={ form.Tags }></label>
				<label class="full">{ i18n.T(ctx, "customer.campaign_code") }<input name="campaign_code" placeholder={ i18n.T(ctx, "customer.campaign_placeholder") } value={ form.Campaign }></label>
				<label class="full">{ i18n.T(ctx, "customer.notes") }<textarea name="notes">{ form.Notes }</textarea></label>
				<div class="full"><button class="btn btn-p" type="submit">{ i18n.T(ctx, "customer.create") }</button></div>
			</form>
			<p style="color:var(--muted);font-size:12.5px;margin:10px 0 0;line-height:1.6">
				{ i18n.T(ctx, "customer.line_binding_hint") }
			</p>
		</div>
		<div class="card">
			<h2>{ fmt.Sprintf(i18n.T(ctx, "customer.list_title"), total) }</h2>
			// HTMX 即時搜尋：輸入後 300ms 自動查詢，無需按送出
			<input type="search" name="q" value={ q }
				placeholder={ i18n.T(ctx, "customer.search_placeholder") }
				hx-get="/api/customers/search"
				hx-trigger="keyup changed delay:300ms, search"
				hx-target="#customer-rows"
				hx-swap="innerHTML"
				style="padding:8px 10px;border-radius:7px;border:1px solid var(--border);background:var(--surface);color:var(--text);width:280px;margin-bottom:12px">
			<a class="btn btn-s" href="/customers">{ i18n.T(ctx, "customer.clear") }</a>
			<table>
				<tr>
										<th>ID</th><th>{ i18n.T(ctx, "customer.field.name") }</th><th>{ i18n.T(ctx, "customer.field.phone") }</th><th>{ i18n.T(ctx, "customer.field.tags") }</th><th>{ i18n.T(ctx, "customer.field.address") }</th><th>{ i18n.T(ctx, "customer.column.notification") }</th>
										<th>LINE ID</th><th>Telegram ID</th>
										if user.Role == "owner" || user.Role == "counter" {
											<th class="num">{ i18n.T(ctx, "customer.column.total_spent") }</th><th class="num">{ i18n.T(ctx, "customer.column.unpaid") }</th>
										}
										<th>{ i18n.T(ctx, "customer.column.actions") }</th>
				</tr>
				<tbody id="customer-rows">
					for _, c := range rows {
						<tr>
							<td>{ strconv.FormatInt(c.ID, 10) }</td>
							<td>{ c.Name }</td>
							<td>{ c.Phone }</td>
							<td style="font-size:12.5px">@templ.Raw(tagPillsHTML(c.Tags))</td>
							<td>{ c.Address }</td>
							<td>{ c.Notification }</td>
							<td>{ orEmpty(c.LineUserID) }</td>
														<td>{ orEmpty(c.TelegramUserID) }</td>
														if user.Role == "owner" || user.Role == "counter" {
															<td class="num">{ moneyFmt(c.TotalSpent) }</td>
															<td class="num">{ moneyFmt(c.UnpaidAmount) }</td>
														}
														<td>
								<a class="btn btn-p" href={ "/work-orders/new?customer=" + strconv.FormatInt(c.ID, 10) }>{ i18n.T(ctx, "customer.action.new_workorder") }</a>
								<a class="btn btn-s" href={ "/customers/" + strconv.FormatInt(c.ID, 10) + "/edit" }>{ i18n.T(ctx, "common.edit") }</a>
								<a class="btn btn-o" href={ "/vehicles?customer=" + strconv.FormatInt(c.ID, 10) }>{ i18n.T(ctx, "nav.vehicles") }</a>
								<a class="btn btn-s" href={ "/customers/" + strconv.FormatInt(c.ID, 10) + "/ar-statement" }>{ i18n.T(ctx, "customer.action.ar_statement") }</a>
								<a class="btn btn-d" href={ "/customers/" + strconv.FormatInt(c.ID, 10) + "/delete" }
									hx-post={ "/customers/" + strconv.FormatInt(c.ID, 10) + "/delete" }
									data-confirm={ i18n.T(ctx, "customer.delete_confirm") }>{ i18n.T(ctx, "common.delete") }</a>
							</td>
						</tr>
					}
				</tbody>
			</table>
			if len(rows) == 0 {
				<div class="empty">{ i18n.T(ctx, "customer.empty_no_match") }</div>
			}
			@components.Pager("/customers", page, calcPages(total, size), total)
		</div>
	}
}

// CustomerSearchRows HTMX 即時搜尋回傳的純列（無 Layout）。
templ CustomerSearchRows(rows []CustomerRow, user model.User) {
	if len(rows) == 0 {
		<tr><td colspan="11" style="color:var(--muted);text-align:center;padding:20px">{ i18n.T(ctx, "customer.search_empty") }</td></tr>
	}
	for _, c := range rows {
		<tr>
			<td>{ strconv.FormatInt(c.ID, 10) }</td>
			<td>{ c.Name }</td>
			<td>{ c.Phone }</td>
			<td style="font-size:12.5px">@templ.Raw(tagPillsHTML(c.Tags))</td>
			<td>{ c.Address }</td>
			<td>{ c.Notification }</td>
			<td>{ orEmpty(c.LineUserID) }</td>
			<td>{ orEmpty(c.TelegramUserID) }</td>
			if user.Role == "owner" || user.Role == "counter" {
				<td class="num">{ moneyFmt(c.TotalSpent) }</td>
				<td class="num">{ moneyFmt(c.UnpaidAmount) }</td>
			}
			<td>
				<a class="btn btn-p" href={ "/work-orders/new?customer=" + strconv.FormatInt(c.ID, 10) }>{ i18n.T(ctx, "customer.action.new_workorder") }</a>
				<a class="btn btn-s" href={ "/customers/" + strconv.FormatInt(c.ID, 10) + "/edit" }>{ i18n.T(ctx, "common.edit") }</a>
				<a class="btn btn-o" href={ "/vehicles?customer=" + strconv.FormatInt(c.ID, 10) }>{ i18n.T(ctx, "nav.vehicles") }</a>
				<a class="btn btn-s" href={ "/customers/" + strconv.FormatInt(c.ID, 10) + "/ar-statement" }>{ i18n.T(ctx, "customer.action.ar_statement") }</a>
				<a class="btn btn-d" href={ "/customers/" + strconv.FormatInt(c.ID, 10) + "/delete" }
					hx-post={ "/customers/" + strconv.FormatInt(c.ID, 10) + "/delete" }
					data-confirm={ i18n.T(ctx, "customer.delete_confirm") }>{ i18n.T(ctx, "common.delete") }</a>
			</td>
		</tr>
	}
}

// tagPillsHTML 標籤轉為 HTML pill。
func tagPillsHTML(tags string) string {
	if tags == "" {
		return `<span style="color:var(--muted)">-</span>`
	}
	var b []byte
	b = append(b, []byte(`<span class="pill" style="background:var(--primary-bg);color:var(--primary);margin-right:4px">`)...)
	for i, ch := range tags {
		if ch == ',' {
			b = append(b, []byte(`</span> <span class="pill" style="background:var(--primary-bg);color:var(--primary);margin-right:4px">`)...)
			_ = i
			continue
		}
		b = append(b, []byte(html.EscapeString(string(ch)))...)
	}
	b = append(b, []byte(`</span>`)...)
	return string(b)
}

var _ = model.Customer{}