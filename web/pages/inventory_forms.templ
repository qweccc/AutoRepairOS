package pages

import (
	"strconv"

	"autorepairos/internal/model"
	"autorepairos/web/components"
)

templ EditInventoryPage(it model.InventoryItem, showMoney bool, categoryOptions, supplierOptions string, user model.User) {
	@components.Layout("編輯零件", "/inventory", user, AppName) {
		<div class="card">
			<h2>編輯零件 { it.Name }</h2>
			<form class="frm" method="POST" action={ "/inventory/" + strconv.FormatInt(it.ID, 10) }>
				@components.CSRFInput()
				<label>料號<input name="part_number" value={ it.PartNumber } required></label>
				<label>名稱<input name="name" value={ it.Name } required></label>
				<label>類別<select name="category"><option value="">未分類</option>@templ.Raw(categoryOptions)</select></label>
				<label>庫位<input name="bin_location" value={ it.BinLocation } required></label>
				<label>條碼<input name="barcode" value={ it.Barcode }></label>
				<label>供應商<select name="supplier_id"><option value="0">無</option>@templ.Raw(supplierOptions)</select></label>
				if showMoney {
					<label>成本價<input name="cost_price" type="number" step="1" value={ moneyValue(it.CostPrice) }></label>
				}
				<label>售價<input name="selling_price" type="number" step="1" value={ moneyValue(it.SellingPrice) }></label>
				<label>安全庫存<input name="min_safety_stock" type="number" min="0" value={ strconv.Itoa(it.MinSafetyStock) }></label>
				<div class="full"><button class="btn btn-p" type="submit">儲存</button> <a class="btn btn-s" href="/inventory">取消</a></div>
			</form>
			<p style="color:#64748b;font-size:12.5px;margin-top:10px">庫存數量請用「調庫」功能變更，以保留進出紀錄。</p>
		</div>
	}
}

templ StockAdjustPage(it model.InventoryItem, user model.User) {
	@components.Layout("調庫", "/inventory", user, AppName) {
		<div class="card">
			<h2>調庫 — { it.Name }（{ it.PartNumber }）</h2>
			<p style="color:#94a3b8;font-size:13.5px">目前庫存：<b style="color:#f8fafc;font-size:20px">{ strconv.Itoa(it.StockQuantity) }</b>　安全庫存：{ strconv.Itoa(it.MinSafetyStock) }</p>
			<form class="frm" method="POST" action={ "/inventory/" + strconv.FormatInt(it.ID, 10) + "/stock" }>
				@components.CSRFInput()
				<label>異動數量（正數進貨、負數領用）<input name="delta" type="number" required placeholder="例 10 或 -2"></label>
				<label>備註<input name="note" placeholder="例：採購進貨 / 工單領用"></label>
				<div class="full"><button class="btn btn-p" type="submit">確認調庫</button> <a class="btn btn-s" href="/inventory">取消</a></div>
			</form>
		</div>
	}
}

func moneyValue(v float64) string {
	return strconv.FormatFloat(v, 'f', 0, 64)
}
