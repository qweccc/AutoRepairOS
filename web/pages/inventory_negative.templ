package pages

import (
	"fmt"
	"net/url"
	"strconv"

	"autorepairos/internal/i18n"
	"autorepairos/internal/model"
	"autorepairos/web/components"
)

type NegativeStockStats struct {
	Total, TotalAll, WorstQty, SumDeficit, SellableOnly, WithSupplier int
}

type NegativeStockRow struct {
	ID int64
	PartNumber, Name, BinLocation, SupplierName string
	SellingPrice string
	StockQuantity, Suggested int
}

type InventoryMovementRow struct {
	CreatedAt, PartNumber, Name, Source, Reason, User string
	Delta, Before, After int
	DeltaPositive bool
}

templ NegativeStockPage(stats NegativeStockStats, rows []NegativeStockRow, total, page, size int, q, sortBy, hiddenHTML, pagerHTML, perPageHTML, flashHTML string, user model.User) {
	@components.Layout(i18n.T(ctx, "inventory.negative_title"), "/inventory", user, AppName) {
		@templ.Raw(flashHTML)
		<div class="card">
			<h2>{ i18n.T(ctx, "inventory.negative_title") }</h2>
			<p style="color:var(--text-sub);font-size:13.5px;margin:0 0 14px">{ i18n.T(ctx, "inventory.negative_intro") }<br><b>{ i18n.T(ctx, "inventory.negative_audit") }</b>{ i18n.T(ctx, "inventory.negative_audit_suffix") }</p>
			<div style="margin-bottom:14px">
				<div class="stat"><b>{ strconv.Itoa(stats.Total) }</b><span>{ i18n.T(ctx, "inventory.stat.negative_parts") }</span></div>
				<div class="stat"><b>{ strconv.Itoa(stats.TotalAll) }</b><span>{ i18n.T(ctx, "inventory.stat.all_parts") }</span></div>
				<div class="stat"><b style="color:var(--danger)">{ strconv.Itoa(stats.WorstQty) }</b><span>{ i18n.T(ctx, "inventory.stat.worst_qty") }</span></div>
				<div class="stat"><b>{ strconv.Itoa(stats.SumDeficit) }</b><span>{ i18n.T(ctx, "inventory.stat.deficit_sum") }</span></div>
				<div class="stat"><b>{ strconv.Itoa(stats.SellableOnly) }</b><span>{ i18n.T(ctx, "inventory.stat.with_price") }</span></div>
				<div class="stat"><b>{ strconv.Itoa(stats.WithSupplier) }</b><span>{ i18n.T(ctx, "inventory.stat.with_supplier") }</span></div>
			</div>
			<div style="margin-bottom:12px">
				@negativeSortTab(i18n.T(ctx, "inventory.sort.deficit"), "", sortBy, q)
				@negativeSortTab(i18n.T(ctx, "inventory.sort.sellable"), "sellable", sortBy, q)
				@negativeSortTab(i18n.T(ctx, "inventory.sort.name"), "name", sortBy, q)
				<a class="btn btn-s" href="/inventory">{ i18n.T(ctx, "inventory.back_list") }</a>
			</div>
			<form method="GET" action="/inventory/negative" style="margin-bottom:12px">
				<input name="q" value={ q } placeholder={ i18n.T(ctx, "inventory.negative_search_placeholder") } style="padding:8px 10px;border-radius:7px;border:1px solid var(--border);background:var(--surface);color:var(--text);width:280px">
				@templ.Raw(hiddenHTML)
				<button class="btn btn-p" type="submit">{ i18n.T(ctx, "common.search") }</button>
				<a class="btn btn-s" href="/inventory/negative">{ i18n.T(ctx, "inventory.clear") }</a>
			</form>
			<h2 style="font-size:15px">{ fmt.Sprintf(i18n.T(ctx, "inventory.matching_count"), total) }</h2>
			if len(rows) == 0 {
				<div class="empty">{ i18n.T(ctx, "inventory.negative_empty") }</div>
			} else {
				<table><tr><th>{ i18n.T(ctx, "inventory.col.part_number") }</th><th>{ i18n.T(ctx, "inventory.col.name") }</th><th>{ i18n.T(ctx, "inventory.col.bin") }</th><th>{ i18n.T(ctx, "inventory.col.supplier") }</th><th class="num">{ i18n.T(ctx, "inventory.col.selling") }</th><th class="num">{ i18n.T(ctx, "inventory.col.current_stock") }</th><th class="num">{ i18n.T(ctx, "inventory.col.suggested") }</th><th>{ i18n.T(ctx, "inventory.col.actions") }</th></tr>
					for _, row := range rows {
						<tr><td><code>{ row.PartNumber }</code></td><td>{ row.Name }</td><td>{ row.BinLocation }</td><td>{ row.SupplierName }</td><td class="num">{ row.SellingPrice }</td><td class="num"><b style="color:var(--danger)">{ strconv.Itoa(row.StockQuantity) }</b></td><td class="num" style="color:var(--ok)">+{ strconv.Itoa(row.Suggested) }</td><td><a class="btn btn-p" href={ "/inventory/negative?id=" + strconv.FormatInt(row.ID, 10) }>{ i18n.T(ctx, "inventory.fix") }</a></td></tr>
					}
				</table>
			}
			@templ.Raw(pagerHTML)
			<div style="margin-top:6px">@templ.Raw(perPageHTML)</div>
		</div>
	}
}

templ negativeSortTab(label, key, sortBy, q string) {
	<a class={ "btn " + sortClass(key, sortBy) } href={ negativeSortURL(key, q) }>{ label }</a>
}

func sortClass(key, sortBy string) string {
	if key == sortBy { return "btn-p" }
	return "btn-s"
}

func negativeSortURL(key, q string) string {
	query := url.Values{}
	if q != "" { query.Set("q", q) }
	if key != "" {
		query.Set("sort", key)
	}
	if encoded := query.Encode(); encoded != "" {
		return "/inventory/negative?" + encoded
	}
	return "/inventory/negative"
}

templ NegativeStockFixPage(it model.InventoryItem, movements []InventoryMovementRow, user model.User) {
	@components.Layout(i18n.T(ctx, "inventory.negative_title"), "/inventory", user, AppName) {
		<div class="card">
			<h2>{ fmt.Sprintf(i18n.T(ctx, "inventory.negative_fix_title"), it.Name, it.PartNumber) }</h2>
			<p style="color:var(--text-sub);font-size:13.5px">{ i18n.T(ctx, "inventory.current_stock") + "：" }<b style="color:var(--danger);font-size:20px">{ strconv.Itoa(it.StockQuantity) }</b>{ "　" + i18n.T(ctx, "inventory.field.min_safety") + "：" }{ strconv.Itoa(it.MinSafetyStock) }{ "　" + i18n.T(ctx, "inventory.col.selling") + "：" }{ moneyFmt(it.SellingPrice) }</p>
			<form class="frm" method="POST" action="/inventory/negative/fix">
				@components.CSRFInput()
				<input type="hidden" name="item_id" value={ strconv.FormatInt(it.ID, 10) }>
				<label>{ i18n.T(ctx, "inventory.fix_mode") }<select name="mode" id="fixMode" onchange="document.getElementById('customRow').style.display=(this.value=='custom')?'block':'none'"><option value="zero">{ i18n.T(ctx, "inventory.fix_zero") }</option><option value="safety">{ fmt.Sprintf(i18n.T(ctx, "inventory.fix_safety"), it.MinSafetyStock) }</option><option value="custom">{ i18n.T(ctx, "inventory.fix_custom") }</option></select></label>
				<label id="customRow" style="display:none">{ i18n.T(ctx, "inventory.fix_custom_label") }<input name="target" type="number" min="0" value="0"></label>
				<label class="full">{ i18n.T(ctx, "inventory.fix_reason") }<input name="reason" value={ i18n.T(ctx, "inventory.fix_reason_default") } placeholder={ i18n.T(ctx, "inventory.fix_reason_placeholder") }></label>
				<div class="full"><button class="btn btn-p" type="submit">{ i18n.T(ctx, "inventory.confirm_fix") }</button> <a class="btn btn-s" href="/inventory/negative">{ i18n.T(ctx, "common.cancel") }</a></div>
			</form>
			<p style="color:var(--muted);font-size:12.5px;margin-top:12px">{ i18n.T(ctx, "inventory.fix_hint") }</p>
		</div>
		@MovementTable(i18n.T(ctx, "inventory.recent_movements"), movements, true)
	}
}

templ MovementLogPage(rows []InventoryMovementRow, total, page, size int, q, source, hiddenHTML, pagerHTML, perPageHTML string, user model.User) {
	@components.Layout(i18n.T(ctx, "inventory.movements_title"), "/inventory", user, AppName) {
		<div class="card">
			<h2>{ fmt.Sprintf(i18n.T(ctx, "inventory.movements_list_title"), total) }</h2>
			<div style="margin-bottom:12px"><a class={ "btn " + sourceClass("", source) } href={ sourceURL("", q) }>{ i18n.T(ctx, "inventory.source.all") }</a> <a class={ "btn " + sourceClass("manual", source) } href={ sourceURL("manual", q) }>{ i18n.T(ctx, "inventory.source.manual") }</a> <a class={ "btn " + sourceClass("checkout", source) } href={ sourceURL("checkout", q) }>{ i18n.T(ctx, "inventory.source.checkout") }</a> <a class={ "btn " + sourceClass("legacy_fix", source) } href={ sourceURL("legacy_fix", q) }>{ i18n.T(ctx, "inventory.source.legacy_fix") }</a> <a class="btn btn-s" href="/inventory">{ i18n.T(ctx, "inventory.back_list") }</a></div>
			<form method="GET" action="/inventory/movements" style="margin-bottom:12px"><input name="q" value={ q } placeholder={ i18n.T(ctx, "inventory.movements_search_placeholder") } style="padding:8px 10px;border-radius:7px;border:1px solid var(--border);background:var(--surface);color:var(--text);width:280px">@templ.Raw(hiddenHTML)<button class="btn btn-p" type="submit">{ i18n.T(ctx, "common.search") }</button> <a class="btn btn-s" href="/inventory/movements">{ i18n.T(ctx, "inventory.clear") }</a></form>
			@MovementTable("", rows, false)
			@templ.Raw(pagerHTML)
			<div style="margin-top:6px">@templ.Raw(perPageHTML)</div>
		</div>
	}
}

func sourceClass(key, source string) string {
	if key == source { return "btn-p" }
	return "btn-s"
}

func sourceURL(key, q string) string {
	query := url.Values{}
	if q != "" { query.Set("q", q) }
	if key != "" { query.Set("source", key) }
	if encoded := query.Encode(); encoded != "" {
		return "/inventory/movements?" + encoded
	}
	return "/inventory/movements"
}

templ MovementTable(title string, rows []InventoryMovementRow, recent bool) {
	<div class="card">
		if title != "" {
			<h2>{ title }
				if recent {
					{ i18n.T(ctx, "inventory.recent_10") }
				}
			</h2>
		}
		if len(rows) == 0 {
			<div class="empty">
				if recent {
					{ i18n.T(ctx, "inventory.no_movements_for_item") }
				} else {
					{ i18n.T(ctx, "inventory.no_matching_movements") }
				}
			</div>
		} else {
			<table><tr><th>{ i18n.T(ctx, "inventory.col.time") }</th>
				if !recent {
					<th>{ i18n.T(ctx, "inventory.col.part_number") }</th><th>{ i18n.T(ctx, "inventory.col.name") }</th>
				}
				<th class="num">{ i18n.T(ctx, "inventory.col.delta") }</th><th class="num">{ i18n.T(ctx, "inventory.col.before") }</th><th class="num">{ i18n.T(ctx, "inventory.col.after") }</th><th>{ i18n.T(ctx, "inventory.col.source") }</th><th>{ i18n.T(ctx, "inventory.col.reason") }</th><th>{ i18n.T(ctx, "inventory.col.user") }</th></tr>
				for _, row := range rows {
					<tr>
						<td style="font-size:12.5px;color:var(--text-sub)">{ row.CreatedAt }</td>
						if !recent {
							<td><code>{ row.PartNumber }</code></td><td>{ row.Name }</td>
						}
						<td class="num">
							if row.DeltaPositive {
								<b style="color:var(--ok)">+{ strconv.Itoa(row.Delta) }</b>
							} else {
								<b style="color:var(--danger)">{ strconv.Itoa(row.Delta) }</b>
							}
						</td>
						<td class="num">{ strconv.Itoa(row.Before) }</td><td class="num">{ strconv.Itoa(row.After) }</td>
						<td>{ row.Source }</td><td style="font-size:12.5px">{ row.Reason }</td><td style="font-size:12.5px">{ row.User }</td>
					</tr>
				}
			</table>
		}
	</div>
}
