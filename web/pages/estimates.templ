package pages

import (
	"strconv"

	"autorepairos/internal/i18n"
	"autorepairos/internal/model"
	"autorepairos/web/components"
)

type EstimateListRow struct {
	ID                    int64
	CustomerName          string
	PlateNumber           string
	BrandModel            string
	Status                string
	TotalAmount           float64
	DiscountAmount        float64
	CreatedAt             string
	ConvertedWorkOrderID  int64
}

type EstimateVehicleOption struct {
	ID           int64
	PlateNumber  string
	BrandModel   string
	CustomerName string
}

type EstimateDetail struct {
	ID                   int64
	CustomerName         string
	CustomerPhone        string
	PlateNumber          string
	BrandModel           string
	Status               string
	CurrentMileage       int
	CustomerComplaint    string
	DiscountAmount       float64
	TotalAmount          float64
	CreatedAt            string
	ConvertedWorkOrderID int64
}

type EstimateItemRow struct {
	ID          int64
	ItemType    string
	Description string
	Quantity    int
	UnitPrice   float64
	Subtotal    float64
}

templ EstimateListPage(rows []EstimateListRow, user model.User) {
	@components.Layout(i18n.T(ctx, "estimates.title"), "/estimates", user, AppName) {
		<div class="card">
			<h2>{ i18n.T(ctx, "estimates.title") }</h2>
			if user.Role == "owner" || user.Role == "counter" {
				<p><a class="btn btn-p" href="/estimates/new">{ i18n.T(ctx, "estimates.new") }</a></p>
			}
			if len(rows) == 0 {
				<div class="empty">{ i18n.T(ctx, "estimates.empty") }</div>
			}
			if len(rows) > 0 {
				<table>
					<tr><th>{ i18n.T(ctx, "estimates.field.id") }</th><th>{ i18n.T(ctx, "estimates.field.vehicle") }</th><th>{ i18n.T(ctx, "estimates.field.customer") }</th><th>{ i18n.T(ctx, "estimates.field.status") }</th><th class="num">{ i18n.T(ctx, "estimates.field.total") }</th><th>{ i18n.T(ctx, "estimates.field.created") }</th><th>{ i18n.T(ctx, "insurancelist.field.actions") }</th></tr>
					for _, e := range rows {
						<tr>
							<td>#{ strconv.FormatInt(e.ID, 10) }</td>
							<td>{ e.PlateNumber } / { e.BrandModel }</td>
							<td>{ e.CustomerName }</td>
							<td>
								if e.Status == "converted" {
									<span class="pill p-completed">{ i18n.T(ctx, "estimates.status_converted") }</span>
								}
								if e.Status != "converted" {
									<span class="pill p-pending">{ i18n.T(ctx, "estimates.status_draft") }</span>
								}
							</td>
							<td class="num">{ estimateMoney(e.TotalAmount) }</td>
							<td>{ e.CreatedAt }</td>
							<td>
								<a class="btn btn-s" href={ estimateURL(e.ID) }>{ i18n.T(ctx, "estimates.view") }</a>
								if e.ConvertedWorkOrderID > 0 {
									<a class="btn btn-p" href={ "/work-orders/" + strconv.FormatInt(e.ConvertedWorkOrderID, 10) }>{ i18n.T(ctx, "subcontract.field.workorder_th") }</a>
								}
							</td>
						</tr>
					}
				</table>
			}
		</div>
	}
}

templ EstimateNewPage(vehicles []EstimateVehicleOption, vehicleOptionsJSON string, user model.User) {
	@components.Layout(i18n.T(ctx, "estimates.new_layout"), "/estimates", user, AppName) {
		<div class="card">
			<h2>{ i18n.T(ctx, "estimates.new_title") }</h2>
			if len(vehicles) == 0 {
				<div class="msg msg-err">{ i18n.T(ctx, "estimates.no_vehicles") }</div>
			}
			<form class="frm" method="POST" action="/estimates">
				@components.CSRFInput()
				<label class="full">{ i18n.T(ctx, "estimates.vehicle_label") }
					<div class="vsearch" data-vsearch data-options={ vehicleOptionsJSON }>
						<input type="hidden" name="vehicle_id" id="estimateVehicleID" value="0" required>
						<input name="plate_number" class="vs-input" id="estimatePlate" autocapitalize="characters" autocomplete="off"
							placeholder={ i18n.T(ctx, "estimates.plate_ph") } autocomplete="off" required>
						<div class="vs-list hidden"></div>
					</div>
					<span style="color:#94a3b8;font-size:12px">{ i18n.T(ctx, "estimates.vehicle_hint") }</span>
				</label>
				<label>{ i18n.T(ctx, "estimates.mileage") }
					<input name="current_mileage" type="number" min="0" value="0" placeholder={ i18n.T(ctx, "estimates.mileage_ph") }>
				</label>
				<label class="full">{ i18n.T(ctx, "estimates.complaint") }
					<textarea name="customer_complaint" placeholder={ i18n.T(ctx, "estimates.complaint_ph") }></textarea>
				</label>
				<div class="full">
					<button class="btn btn-p" type="submit">{ i18n.T(ctx, "estimates.create_submit") }</button>
					<a class="btn btn-s" href="/estimates">{ i18n.T(ctx, "common.cancel") }</a>
				</div>
			</form>
		</div>
		<link rel="stylesheet" href="/static/vehicle-search.css"/>
		<script src="/static/vehicle-search.js" defer></script>
	}
}

templ EstimateDetailPage(e EstimateDetail, items []EstimateItemRow, user model.User, canEdit bool) {
	@components.Layout(i18n.T(ctx, "estimates.detail_layout")+strconv.FormatInt(e.ID, 10), "/estimates", user, AppName) {
		<div class="card">
			<h2>{ i18n.T(ctx, "estimates.title") } #{ strconv.FormatInt(e.ID, 10) }</h2>
			<table>
				<tr><th>{ i18n.T(ctx, "estimates.field.vehicle2") }</th><td>{ e.PlateNumber } / { e.BrandModel }</td><th>{ i18n.T(ctx, "estimates.field.customer") }</th><td>{ e.CustomerName } / { e.CustomerPhone }</td></tr>
				<tr><th>{ i18n.T(ctx, "estimates.mileage") }</th><td>{ strconv.Itoa(e.CurrentMileage) } km</td><th>{ i18n.T(ctx, "estimates.field.created") }</th><td>{ e.CreatedAt }</td></tr>
				<tr><th>{ i18n.T(ctx, "estimates.complaint") }</th><td colspan="3">{ e.CustomerComplaint }</td></tr>
			</table>
			if e.Status == "converted" {
				<div class="msg msg-ok">{ i18n.T(ctx, "estimates.converted_prefix") }{ strconv.FormatInt(e.ConvertedWorkOrderID, 10) }{ i18n.T(ctx, "estimates.converted_mid") } { estimateMoney(e.TotalAmount) }{ i18n.T(ctx, "estimates.source_suffix") }</div>
				<p>
					<a class="btn btn-p" href={ "/work-orders/" + strconv.FormatInt(e.ConvertedWorkOrderID, 10) }>{ i18n.T(ctx, "estimates.open_workorder") }</a>
					<a class="btn btn-s" href={ "/work-orders/" + strconv.FormatInt(e.ConvertedWorkOrderID, 10) + "/estimate-source" }>{ i18n.T(ctx, "estimates.view_source") }</a>
				</p>
			}
		</div>
		<div class="card">
			<h2>{ i18n.T(ctx, "estimates.items_title") }</h2>
			if len(items) == 0 {
				<div class="empty">{ i18n.T(ctx, "estimates.items_empty") }</div>
			}
			if len(items) > 0 {
				<table>
					<tr><th>{ i18n.T(ctx, "estimates.field.type") }</th><th>{ i18n.T(ctx, "estimates.field.description") }</th><th class="num">{ i18n.T(ctx, "estimates.field.quantity") }</th><th class="num">{ i18n.T(ctx, "estimates.field.unit_price") }</th><th class="num">{ i18n.T(ctx, "estimates.field.subtotal") }</th><th>{ i18n.T(ctx, "insurancelist.field.actions") }</th></tr>
					for _, item := range items {
						<tr>
							<td><span class="pill p-progress">{ estimateItemType(item.ItemType) }</span></td>
							<td>{ item.Description }</td><td class="num">{ strconv.Itoa(item.Quantity) }</td>
							<td class="num">{ estimateMoney(item.UnitPrice) }</td><td class="num">{ estimateMoney(item.Subtotal) }</td>
							<td>
								if canEdit && e.Status == "draft" {
									<form method="POST" action={ estimateURL(e.ID) + "/items/" + strconv.FormatInt(item.ID, 10) + "/delete" }>
										@components.CSRFInput()
										<button class="btn btn-d" type="submit">{ i18n.T(ctx, "common.delete") }</button>
									</form>
								}
							</td>
						</tr>
					}
				</table>
			}
			if canEdit && e.Status == "draft" {
				<form class="frm" method="POST" action={ estimateURL(e.ID) + "/items" }>
					@components.CSRFInput()
					<label>{ i18n.T(ctx, "estimates.field.type") }
						<select name="item_type" id="estimateItemType">
								<option value="labor" selected>{ i18n.T(ctx, "estimates.item_type_labor") }</option><option value="part">{ i18n.T(ctx, "estimates.item_type_part") }</option><option value="subcontract">{ i18n.T(ctx, "estimates.item_type_subcontract") }</option>
						</select>
					</label>
					<label>{ i18n.T(ctx, "estimates.field.quantity") }<input name="quantity" type="number" min="1" value="1" required></label>
				</form>
				<form class="frm" method="POST" action={ estimateURL(e.ID) + "/items" }>
					@components.CSRFInput()
					<label class="full" id="estimateSearchWrap">{ i18n.T(ctx, "estimates.search_label") }
						<input type="search" id="estimateSearch" name="q" placeholder={ i18n.T(ctx, "estimates.search_ph") }
							hx-get="/api/estimate-items/search" hx-trigger="keyup delay:300ms"
							hx-target="#estimateSearchResults" hx-swap="innerHTML" hx-on::after-request="document.getElementById('estimateSearchResults').style.display='block';" autocomplete="off">
						<div id="estimateSearchResults" class="part-results"></div>
					</label>
					<label class="full">{ i18n.T(ctx, "estimates.field.description") }
						<input name="description" id="estimateItemDescription" placeholder={ i18n.T(ctx, "estimates.description_ph") } required>
					</label>
					<input type="hidden" name="inventory_item_id" id="estimateInventoryItemID" value="0">
					<input type="hidden" name="item_type" id="estimateItemTypeHidden" value="labor">
					<input type="hidden" name="quantity" id="estimateQuantityHidden" value="1">
					<label>{ i18n.T(ctx, "estimates.field.unit_price") }<input name="unit_price" id="estimateUnitPrice" type="number" min="0" step="1" value="0" placeholder={ i18n.T(ctx, "estimates.unit_price_ph") } required></label>
					<div id="estAddErr" style="color:#f87171;margin-top:6px;font-size:13px"></div>
					<div class="full"><button class="btn btn-p" type="submit">{ i18n.T(ctx, "estimates.add_item") }</button></div>
				</form>
				<script>
						(function() {
							var type = document.getElementById('estimateItemType');
							var typeHidden = document.getElementById('estimateItemTypeHidden');
							var qtyHidden = document.getElementById('estimateQuantityHidden');
							var qtyInput = document.querySelector('form.frm input[name="quantity"]');
							var phraseWrap = document.getElementById('estimatePhraseSearchWrap');
							var partWrap = document.getElementById('estimatePartSearchWrap');
							var phraseSearch = document.getElementById('estimatePhraseSearch');
							var partSearch = document.getElementById('estimatePartSearch');
							var searchResults = document.getElementById('estimateSearchResults');
							var description = document.getElementById('estimateItemDescription');
							var price = document.getElementById('estimateUnitPrice');
							var inventoryID = document.getElementById('estimateInventoryItemID');
							if (!type || !description || !price || !inventoryID) return;

							function updateLookup() {
								var isPart = type.value === 'part';
								if (typeHidden) typeHidden.value = type.value;
								phraseWrap.style.display = isPart ? 'none' : '';
								partWrap.style.display = isPart ? '' : 'none';
								inventoryID.value = '0';
								if (searchResults) searchResults.innerHTML = '';
							}
							if (qtyInput && qtyHidden) {
								qtyHidden.value = qtyInput.value || '1';
								qtyInput.addEventListener('change', function(){ qtyHidden.value = qtyInput.value || '1'; });
							}
							type.addEventListener('change', updateLookup);
							if (searchResults) {
								searchResults.addEventListener('click', function(e) {
									var phraseItem = e.target.closest('.phrase-result-item');
									if (phraseItem) {
										description.value = phraseItem.dataset.phrase || '';
										searchResults.innerHTML = '';
										return;
									}
									var partItem = e.target.closest('.part-result-item');
									if (partItem) {
										inventoryID.value = partItem.dataset.partId || '0';
										description.value = (partItem.dataset.partName || '') + (partItem.dataset.partNumber ? ' (' + partItem.dataset.partNumber + ')' : '');
										if (partItem.dataset.partPrice) {
											price.value = partItem.dataset.partPrice.replace(/[^0-9.]/g, '') || partItem.dataset.partPrice;
										}
										searchResults.innerHTML = '';
									}
								});
							}
							if (partResults) {
								partResults.addEventListener('click', function(e) {
									var item = e.target.closest('.part-result-item');
									if (!item) return;
									inventoryID.value = item.dataset.partId || '0';
									description.value = (item.dataset.partName || '') + (item.dataset.partNumber ? ' (' + item.dataset.partNumber + ')' : '');
									if (partSearch) partSearch.value = (item.dataset.partName || '') + (item.dataset.partNumber ? ' / ' + item.dataset.partNumber : '');
									if (item.dataset.partPrice) {
										price.value = item.dataset.partPrice.replace(/[^0-9.]/g, '') || item.dataset.partPrice;
									}
									partResults.innerHTML = '';
								});
							}
							updateLookup();
						})();
				</script>
				<form class="frm" method="POST" action={ estimateURL(e.ID) + "/discount" }>
					@components.CSRFInput()
					<label>{ i18n.T(ctx, "estimates.discount_amount") }<input name="discount_amount" type="number" min="0" max={ strconv.FormatFloat(estimateSubtotal(items), 'f', 2, 64) } step="1" value={ strconv.FormatFloat(e.DiscountAmount, 'f', 0, 64) }></label>
					<div><button class="btn btn-s" type="submit">{ i18n.T(ctx, "estimates.update_discount") }</button></div>
				</form>
			}
		</div>
		<div class="card">
			<h2>{ i18n.T(ctx, "estimates.total_title") }</h2>
			<table>
				<tr><th>{ i18n.T(ctx, "estimates.subtotal") }</th><td class="num">{ estimateMoney(estimateSubtotal(items)) }</td></tr>
				<tr><th>{ i18n.T(ctx, "estimates.discount") }</th><td class="num">-{ estimateMoney(e.DiscountAmount) }</td></tr>
				<tr><th>{ i18n.T(ctx, "estimates.grand_total") }</th><td class="num" style="font-size:20px;font-weight:700;color:#38bdf8">{ estimateMoney(e.TotalAmount) }</td></tr>
			</table>
			if canEdit && e.Status == "draft" {
				<form method="POST" action={ estimateURL(e.ID) + "/convert" } style="margin-top:16px">
					@components.CSRFInput()
					<button class="btn btn-p" type="submit" data-confirm={ i18n.T(ctx, "estimates.convert_confirm") }>{ i18n.T(ctx, "estimates.convert") }</button>
				</form>
			}
			<p><a class="btn btn-s" href="/estimates">{ i18n.T(ctx, "estimates.back") }</a></p>
		</div>
	}
}

templ EstimateSourcePage(e EstimateDetail, items []EstimateItemRow, workOrderID int64, quoteTotal, quoteDiscount float64, user model.User) {
	@components.Layout(i18n.T(ctx, "estimates.source_title"), "/estimates", user, AppName) {
		<div class="card">
			<h2>{ i18n.T(ctx, "estimates.source_prefix") }{ strconv.FormatInt(workOrderID, 10) } { i18n.T(ctx, "estimates.source_heading_suffix") }</h2>
			<p>{ i18n.T(ctx, "estimates.source_line_prefix") }{ strconv.FormatInt(e.ID, 10) }{ i18n.T(ctx, "estimates.source_vehicle_sep") } { e.PlateNumber } / { e.BrandModel }{ i18n.T(ctx, "estimates.source_customer_sep") } { e.CustomerName }{ i18n.T(ctx, "estimates.source_suffix") }</p>
			<p>{ i18n.T(ctx, "estimates.source_total_label") }<strong>{ estimateMoney(quoteTotal) }</strong>{ i18n.T(ctx, "estimates.source_discount_label") }{ estimateMoney(quoteDiscount) }</p>
			<a class="btn btn-p" href={ "/work-orders/" + strconv.FormatInt(workOrderID, 10) }>{ i18n.T(ctx, "estimates.open_workorder") }</a>
			<a class="btn btn-s" href={ estimateURL(e.ID) }>{ i18n.T(ctx, "estimates.view_draft") }</a>
		</div>
		<div class="card">
			<h2>{ i18n.T(ctx, "estimates.source_items_title") }</h2>
			if len(items) == 0 {
				<div class="empty">{ i18n.T(ctx, "estimates.source_items_empty") }</div>
			}
			if len(items) > 0 {
				<table>
					<tr><th>{ i18n.T(ctx, "estimates.field.type") }</th><th>{ i18n.T(ctx, "estimates.field.description") }</th><th class="num">{ i18n.T(ctx, "estimates.field.quantity") }</th><th class="num">{ i18n.T(ctx, "estimates.field.unit_price") }</th><th class="num">{ i18n.T(ctx, "estimates.field.subtotal") }</th></tr>
					for _, item := range items {
						<tr><td>{ estimateItemType(item.ItemType) }</td><td>{ item.Description }</td>
							<td class="num">{ strconv.Itoa(item.Quantity) }</td><td class="num">{ estimateMoney(item.UnitPrice) }</td>
							<td class="num">{ estimateMoney(item.Subtotal) }</td></tr>
					}
				</table>
			}
		</div>
	}
}

func estimateURL(id int64) string {
	return "/estimates/" + strconv.FormatInt(id, 10)
}

func estimateMoney(amount float64) string {
	return "$" + strconv.FormatFloat(amount, 'f', 0, 64)
}

func estimateItemType(itemType string) string {
	switch itemType {
	case "labor":
		return "工資 / 服務"
	case "part":
		return "零件"
	case "subcontract":
		return "外包"
	default:
		return itemType
	}
}

func estimateSubtotal(items []EstimateItemRow) float64 {
	var total float64
	for _, item := range items {
		total += item.Subtotal
	}
	return total
}
