package pages

import (
	"strconv"

	"autorepairos/internal/i18n"
	"autorepairos/internal/model"
	"autorepairos/web/components"
)

templ PhrasesPage(phrases []model.TechnicianPhrase, user model.User, flashMessage string) {
	@components.Layout(i18n.T(ctx, "phrases.title"), "/phrases", user, AppName) {
		@components.FlashMsg(flashMessage)
		<div class="card">
			<h2>{ i18n.T(ctx, "phrases.page_title") }</h2>
			<form method="POST" action="/phrases/new" class="frm">
				@components.CSRFInput()
				<label>{ i18n.T(ctx, "phrases.field.phrase") }<input name="phrase" required placeholder={ i18n.T(ctx, "phrases.phrase_ph") }></label>
				<label>{ i18n.T(ctx, "phrases.field.category") }<input name="category" placeholder={ i18n.T(ctx, "phrases.category_ph") }></label>
				<label>{ i18n.T(ctx, "phrases.field.sort") }<input name="sort_order" type="number" value="0"></label>
				<div class="full"><button class="btn btn-p" type="submit">{ i18n.T(ctx, "phrases.new") }</button></div>
			</form>
			<table>
				<tr><th>{ i18n.T(ctx, "phrases.field.phrase_th") }</th><th>{ i18n.T(ctx, "phrases.field.category") }</th><th>{ i18n.T(ctx, "phrases.field.sort") }</th><th>{ i18n.T(ctx, "phrases.active") }</th><th>{ i18n.T(ctx, "insurancelist.field.actions") }</th></tr>
				for _, p := range phrases {
					<tr class="phrase-item">
						<td>{ p.Phrase }</td>
						<td>{ p.Category }</td>
						<td class="num">{ strconv.Itoa(p.SortOrder) }</td>
						<td>{ phraseActiveLabel(p.Active) }</td>
						<td>
							<a class="btn btn-s" href={ "/phrases/" + strconv.FormatInt(p.ID, 10) + "/edit" }>{ i18n.T(ctx, "common.edit") }</a>
							<a class="btn btn-d" href={ "/phrases/" + strconv.FormatInt(p.ID, 10) + "/delete" }
								hx-post={ "/phrases/" + strconv.FormatInt(p.ID, 10) + "/delete" }
								data-confirm={ i18n.T(ctx, "phrases.delete_confirm") }>{ i18n.T(ctx, "common.delete") }</a>
						</td>
					</tr>
				}
			</table>
		</div>
	}
}

templ PhraseEditPage(p model.TechnicianPhrase, user model.User, flashMessage string) {
	@components.Layout(i18n.T(ctx, "phrases.edit_title"), "/phrases", user, AppName) {
		@components.FlashMsg(flashMessage)
		<div class="card">
			<h2>{ i18n.T(ctx, "phrases.edit_title") } #{ strconv.FormatInt(p.ID, 10) }</h2>
			<form method="POST" action={ "/phrases/" + strconv.FormatInt(p.ID, 10) + "/update" } class="frm">
				@components.CSRFInput()
				<label>{ i18n.T(ctx, "phrases.field.phrase") }<input name="phrase" value={ p.Phrase } required></label>
				<label>{ i18n.T(ctx, "phrases.field.category") }<input name="category" value={ p.Category }></label>
				<label>{ i18n.T(ctx, "phrases.field.sort") }<input name="sort_order" type="number" value={ strconv.Itoa(p.SortOrder) }></label>
				<label>{ i18n.T(ctx, "phrases.active") }
					<select name="active">
						<option value="1" selected?={ p.Active == 1 }>{ i18n.T(ctx, "phrases.active") }</option>
						<option value="0" selected?={ p.Active == 0 }>{ i18n.T(ctx, "phrases.inactive") }</option>
					</select>
				</label>
				<div class="full"><button class="btn btn-p" type="submit">{ i18n.T(ctx, "phrases.update") }</button>
					<a class="btn btn-s" href="/phrases">{ i18n.T(ctx, "common.cancel") }</a></div>
			</form>
		</div>
	}
}

func phraseActiveLabel(active int) string {
	if active == 0 {
		return "停用"
	}
	return "啟用"
}
