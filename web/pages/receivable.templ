package pages

import (
	"fmt"

	"autorepairos/internal/i18n"
	"autorepairos/internal/model"
	"strconv"

	"autorepairos/web/components"
)

type ReceivableRow struct {
	ID           int64
	VoucherNo    string
	PayDate      string
	CustomerName string
	PlateNumber  string
	MethodLabel  string
	MethodPill   string
	Cash         float64
	Card         float64
	CheckAmount  float64
	TransferAmount float64
	PayTotal     float64
	WorkOrderID  int64
	WoCell       string
	ReceivedCell string
	UnpaidCell   string
	UnpaidRed    bool
	IsLegacy     bool
}

// ListReceivablesPage 收款紀錄頁（HTMX 即時搜尋）。
templ ListReceivablesPage(rows []ReceivableRow, total, page, size int,
	q, method, from, to string, showVoided, unpaidOnly bool,
	sumPay, sumCash, sumCard, sumCheck, sumTransfer float64, user model.User) {
	@components.Layout(i18n.T(ctx, "receivable.title"), "/receivables", user, AppName) {
		<div class="card">
			<h2>{ fmt.Sprintf(i18n.T(ctx, "receivable.heading"), total) }</h2>
			<div style="margin-bottom:14px">
				<div class="stat"><b>{ moneyFmt(sumPay) }</b><span>{ i18n.T(ctx, "receivable.stat_total") }</span></div>
				<div class="stat"><b>{ moneyFmt(sumCash) }</b><span>{ i18n.T(ctx, "receivable.cash") }</span></div>
				<div class="stat"><b>{ moneyFmt(sumCard) }</b><span>{ i18n.T(ctx, "receivable.card") }</span></div>
				<div class="stat"><b>{ moneyFmt(sumCheck) }</b><span>{ i18n.T(ctx, "receivable.check") }</span></div>
				<div class="stat"><b>{ moneyFmt(sumTransfer) }</b><span>{ i18n.T(ctx, "receivable.transfer") }</span></div>
			</div>
			<p style="color:var(--text-sub);font-size:13.5px;margin:0 0 14px">
				{ i18n.T(ctx, "receivable.filter_note") }
			</p>
			<div style="margin-bottom:12px;display:flex;gap:6px;flex-wrap:wrap">
				<a class={ "btn " + btnCls(method == "") } href="/receivables">{ i18n.T(ctx, "receivable.all") }</a>
				<a class={ "btn " + btnCls(method == "cash") } href="/receivables?method=cash">{ i18n.T(ctx, "receivable.cash") }</a>
				<a class={ "btn " + btnCls(method == "card") } href="/receivables?method=card">{ i18n.T(ctx, "receivable.card") }</a>
				<a class={ "btn " + btnCls(method == "check") } href="/receivables?method=check">{ i18n.T(ctx, "receivable.check") }</a>
				<a class={ "btn " + btnCls(method == "transfer") } href="/receivables?method=transfer">{ i18n.T(ctx, "receivable.transfer") }</a>
			</div>
			<div style="margin-bottom:12px">
				<a class="btn btn-p" href="/receivables/new">＋ { i18n.T(ctx, "receivable.new") }</a>
				<a class="btn btn-s" href="/receivables?unpaid=1">{ i18n.T(ctx, "receivable.unpaid") }</a>
			</div>
			<input type="search" name="q" value={ q }
				placeholder={ i18n.T(ctx, "receivable.search_placeholder") }
				hx-get="/api/receivables/search"
				hx-trigger="keyup changed delay:300ms, search"
				hx-target="#receivable-rows"
				hx-swap="innerHTML"
				style="padding:8px 10px;border-radius:7px;border:1px solid var(--border);background:var(--surface);color:var(--text);width:280px;margin-bottom:12px">
			<table>
				<tr>
					<th>{ i18n.T(ctx, "receivable.col_voucher") }</th><th>{ i18n.T(ctx, "receivable.col_date") }</th><th>{ i18n.T(ctx, "receivable.col_customer") }</th><th>{ i18n.T(ctx, "receivable.col_plate") }</th>
					<th>{ i18n.T(ctx, "receivable.col_method") }</th><th class="num">{ i18n.T(ctx, "receivable.cash") }</th><th class="num">{ i18n.T(ctx, "receivable.col_card") }</th>
					<th class="num">{ i18n.T(ctx, "receivable.col_check") }</th><th class="num">{ i18n.T(ctx, "receivable.transfer") }</th><th class="num">{ i18n.T(ctx, "receivable.col_total") }</th><th>{ i18n.T(ctx, "receivable.col_wo") }</th><th>{ i18n.T(ctx, "receivable.col_received") }</th><th>{ i18n.T(ctx, "receivable.col_unpaid") }</th><th>{ i18n.T(ctx, "receivable.col_action") }</th>
				</tr>
				<tbody id="receivable-rows">
					for _, rec := range rows {
						@ReceivableRowContent(rec)
					}
				</tbody>
			</table>
			if len(rows) == 0 {
				<div class="empty">{ i18n.T(ctx, "receivable.empty") }</div>
			}
			@components.Pager("/receivables", page, calcPages(total, size), total)
		</div>
	}
}

templ ReceivableRowContent(rec ReceivableRow) {
	<tr>
		<td>
			<code style="font-size:12px">{ rec.VoucherNo }</code>
			if rec.IsLegacy {
				<span style="color:var(--muted);font-size:11px">{ i18n.T(ctx, "receivable.legacy_old") }</span>
			}
		</td>
		<td style="font-size:12.5px">{ rec.PayDate }</td>
		<td>{ rec.CustomerName }</td>
		<td style="font-size:12.5px">{ rec.PlateNumber }</td>
		<td><span class={ "pill " + rec.MethodPill }>{ rec.MethodLabel }</span></td>
		<td class="num">{ moneyOrDash(rec.Cash) }</td>
		<td class="num">{ moneyOrDash(rec.Card) }</td>
		<td class="num">{ moneyOrDash(rec.CheckAmount) }</td>
		<td class="num">{ moneyOrDash(rec.TransferAmount) }</td>
		<td class="num"><b>{ moneyFmt(rec.PayTotal) }</b></td>
		<td style="font-size:12.5px">
			if rec.WorkOrderID > 0 {
				<a href={ "/work-orders/" + strconv.FormatInt(rec.WorkOrderID, 10) }>{ rec.WoCell }</a>
			}
			if rec.WorkOrderID == 0 {
				<span style="color:var(--text-sub)">—</span>
			}
		</td>
		<td class="num">{ rec.ReceivedCell }</td>
		<td class="num">
			if rec.UnpaidRed {
				<span style="color:var(--danger)">{ rec.UnpaidCell }</span>
			}
			if !rec.UnpaidRed {
				{ rec.UnpaidCell }
			}
		</td>
		<td>
			<a class="btn btn-s" href={ "/receivables/" + strconv.FormatInt(rec.ID, 10) + "/edit" }>{ i18n.T(ctx, "common.edit") }</a>
			<a class="btn btn-s" href={ "/receivables/" + strconv.FormatInt(rec.ID, 10) + "/print" }>{ i18n.T(ctx, "receivable.print_detail") }</a>
		</td>
	</tr>
}

// ReceivableSearchRows HTMX 即時搜尋回傳的純列。
templ ReceivableSearchRows(rows []ReceivableRow) {
	if len(rows) == 0 {
		<tr><td colspan="14" style="color:var(--muted);text-align:center;padding:20px">{ i18n.T(ctx, "receivable.no_results") }</td></tr>
	}
	for _, rec := range rows {
		@ReceivableRowContent(rec)
	}
}

func moneyOrDash(f float64) string {
	if f == 0 {
		return "-"
	}
	return moneyFmt(f)
}
