package pages

import (
	"autorepairos/internal/model"
	"strconv"

	"autorepairos/web/components"
)

type ReceivableRow struct {
	ID           int64
	VoucherNo    string
	PayDate      string
	CustomerName string
	PlateNumber  string
	MethodLabel  string
	MethodPill   string
	Cash         float64
	Card         float64
	CheckAmount  float64
	TransferAmount float64
	PayTotal     float64
	WorkOrderID  int64
	WoCell       string
	ReceivedCell string
	UnpaidCell   string
	UnpaidRed    bool
	IsLegacy     bool
}

// ListReceivablesPage 收款紀錄頁（HTMX 即時搜尋）。
templ ListReceivablesPage(rows []ReceivableRow, total, page, size int,
	q, method, from, to string, showVoided, unpaidOnly bool,
	sumPay, sumCash, sumCard, sumCheck, sumTransfer float64, user model.User) {
	@components.Layout("收款紀錄", "/receivables", user, AppName) {
		<div class="card">
			<h2>收款紀錄（符合條件 { strconv.Itoa(total) } 筆）</h2>
			<div style="margin-bottom:14px">
				<div class="stat"><b>{ moneyFmt(sumPay) }</b><span>收款合計</span></div>
				<div class="stat"><b>{ moneyFmt(sumCash) }</b><span>現金</span></div>
				<div class="stat"><b>{ moneyFmt(sumCard) }</b><span>信用卡</span></div>
				<div class="stat"><b>{ moneyFmt(sumCheck) }</b><span>票據</span></div>
				<div class="stat"><b>{ moneyFmt(sumTransfer) }</b><span>轉帳</span></div>
			</div>
			<p style="color:#94a3b8;font-size:13.5px;margin:0 0 14px">
				上方合計為目前篩選條件的全部筆數（不受分頁影響）。
			</p>
			<div style="margin-bottom:12px;display:flex;gap:6px;flex-wrap:wrap">
				<a class={ "btn " + btnCls(method == "") } href="/receivables">全部</a>
				<a class={ "btn " + btnCls(method == "cash") } href="/receivables?method=cash">現金</a>
				<a class={ "btn " + btnCls(method == "card") } href="/receivables?method=card">信用卡</a>
				<a class={ "btn " + btnCls(method == "check") } href="/receivables?method=check">票據</a>
				<a class={ "btn " + btnCls(method == "transfer") } href="/receivables?method=transfer">轉帳</a>
			</div>
			<div style="margin-bottom:12px">
				<a class="btn btn-p" href="/receivables/new">＋ 新增收款</a>
				<a class="btn btn-s" href="/receivables?unpaid=1">待收款</a>
			</div>
			<input type="search" name="q" value={ q }
				placeholder="搜尋單號 / 客戶 / 電話 / 車牌 / 票號 / 轉帳序號"
				hx-get="/api/receivables/search"
				hx-trigger="keyup changed delay:300ms, search"
				hx-target="#receivable-rows"
				hx-swap="innerHTML"
				style="padding:8px 10px;border-radius:7px;border:1px solid #334155;background:#0f172a;color:#e2e8f0;width:280px;margin-bottom:12px">
			<table>
				<tr>
					<th>收款單號</th><th>收款日</th><th>客戶</th><th>車牌</th>
					<th>方式</th><th class="num">現金</th><th class="num">刷卡</th>
					<th class="num">票額</th><th class="num">轉帳</th><th class="num">合計</th><th>關聯工單</th><th>已收</th><th>未收</th><th>操作</th>
				</tr>
				<tbody id="receivable-rows">
					for _, rec := range rows {
						@ReceivableRowContent(rec)
					}
				</tbody>
			</table>
			if len(rows) == 0 {
				<div class="empty">沒有符合條件的收款紀錄</div>
			}
			@components.Pager("/receivables", page, calcPages(total, size), total)
		</div>
	}
}

templ ReceivableRowContent(rec ReceivableRow) {
	<tr>
		<td>
			<code style="font-size:12px">{ rec.VoucherNo }</code>
			if rec.IsLegacy {
				<span style="color:#64748b;font-size:11px">舊帳</span>
			}
		</td>
		<td style="font-size:12.5px">{ rec.PayDate }</td>
		<td>{ rec.CustomerName }</td>
		<td style="font-size:12.5px">{ rec.PlateNumber }</td>
		<td><span class={ "pill " + rec.MethodPill }>{ rec.MethodLabel }</span></td>
		<td class="num">{ moneyOrDash(rec.Cash) }</td>
		<td class="num">{ moneyOrDash(rec.Card) }</td>
		<td class="num">{ moneyOrDash(rec.CheckAmount) }</td>
		<td class="num">{ moneyOrDash(rec.TransferAmount) }</td>
		<td class="num"><b>{ moneyFmt(rec.PayTotal) }</b></td>
		<td style="font-size:12.5px">
			if rec.WorkOrderID > 0 {
				<a href={ "/work-orders/" + strconv.FormatInt(rec.WorkOrderID, 10) }>{ rec.WoCell }</a>
			}
			if rec.WorkOrderID == 0 {
				<span style="color:#475569">—</span>
			}
		</td>
		<td class="num">{ rec.ReceivedCell }</td>
		<td class="num">
			if rec.UnpaidRed {
				<span style="color:#f87171">{ rec.UnpaidCell }</span>
			}
			if !rec.UnpaidRed {
				{ rec.UnpaidCell }
			}
		</td>
		<td>
			<a class="btn btn-s" href={ "/receivables/" + strconv.FormatInt(rec.ID, 10) + "/edit" }>編輯</a>
			<a class="btn btn-s" href={ "/receivables/" + strconv.FormatInt(rec.ID, 10) + "/print" }>明細列印</a>
		</td>
	</tr>
}

// ReceivableSearchRows HTMX 即時搜尋回傳的純列。
templ ReceivableSearchRows(rows []ReceivableRow) {
	if len(rows) == 0 {
		<tr><td colspan="14" style="color:#64748b;text-align:center;padding:20px">查無收款紀錄</td></tr>
	}
	for _, rec := range rows {
		@ReceivableRowContent(rec)
	}
}

func moneyOrDash(f float64) string {
	if f == 0 {
		return "-"
	}
	return moneyFmt(f)
}
