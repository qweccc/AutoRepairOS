package pages

import (
	"strconv"

	"autorepairos/internal/model"
	"autorepairos/internal/i18n"
	"autorepairos/web/components"
)

type WorkOrderRow struct {
	ID              int64
	PlateNumber     string
	BrandModel      string
	CustomerName    string
	CustomerPhone   string
	TechnicianName  string
	Status          string
	StatusLabel     string
	StatusPill      string
	ApprovalStatus  string
	ApprovalLabel   string
	ApprovalPill    string
	IsInsurance     bool
	PartSummary     string
	PartCount       int
	CurrentMileage  int
	TotalAmount     float64
	CreatedAt       string
}

// ListWorkOrdersPage 工單列表頁（HTMX 即時搜尋）。
templ ListWorkOrdersPage(rows []WorkOrderRow, total, page, size int,
	q, part, status, tech, from, to string,
	tabsHTML, techOptionsHTML string, user model.User) {
	@components.Layout(i18n.T(ctx, "workorder.title"), "/work-orders", user, AppName) {
		<div class="card">
			<h2>{ i18n.T(ctx, "workorder.list_title") }（{ i18n.T(ctx, "workorder.list_matching") } { strconv.Itoa(total) } { i18n.T(ctx, "workorder.list_entries") }）</h2>
			<div style="margin-bottom:12px;display:flex;gap:8px;align-items:center;flex-wrap:wrap">
				// 開立新工單僅限櫃檯以上（GET /work-orders/new 是 CounterUpPage）。
				// 技師看得到按鈕卻點進去被擋，只會以為系統壞了。
				if user.Role == "owner" || user.Role == "counter" {
					<a class="btn btn-p" href="/work-orders/new">{ i18n.T(ctx, "workorder.new_button") }</a>
				}
				<span style="color:#64748b;font-size:12.5px">{ i18n.T(ctx, "workorder.list_hint") }</span>
			</div>
			<div style="margin-bottom:12px">@templ.Raw(tabsHTML)</div>
			<form method="GET" action="/work-orders" style="margin-bottom:12px;display:flex;gap:8px;flex-wrap:wrap;align-items:center">
				<input type="search" name="q" value={ q }
					placeholder={ i18n.T(ctx, "workorder.search_ph") }
					hx-get="/api/work-orders/search"
					hx-trigger="keyup changed delay:300ms, search"
					hx-target="#wo-rows"
					hx-swap="innerHTML"
					hx-include="[name='part'],[name='status'],[name='tech']"
					hx-indicator="#wo-search-indicator"
					hx-on::response-error="htmx.ajax('GET', '/api/work-orders/search?error=1', {target:'#wo-rows', swap:'innerHTML'})"
					style="padding:8px 10px;border-radius:7px;border:1px solid #334155;background:#0f172a;color:#e2e8f0;width:240px">
				<label style="font-size:12.5px;color:#94a3b8">{ i18n.T(ctx, "workorder.col.technician") }
					<select name="tech" style="padding:7px 9px;border-radius:7px;border:1px solid #334155;background:#0f172a;color:#e2e8f0">
						<option value="">{ i18n.T(ctx, "workorder.filter_all") }</option>
						<option value="0" selected?={ tech == "0" }>{ i18n.T(ctx, "workorder.filter_unassigned") }</option>
						@templ.Raw(techOptionsHTML)
					</select>
				</label>
				<label style="font-size:12.5px;color:#94a3b8">{ i18n.T(ctx, "workorder.col.part") }
					<input name="part" value={ part } placeholder={ i18n.T(ctx, "workorder.filter_part_ph") }
						style="padding:8px 10px;border-radius:7px;border:1px solid #334155;background:#0f172a;color:#e2e8f0;width:190px">
				</label>
				<input type="hidden" name="status" value={ status }>
				<label style="font-size:12.5px;color:#94a3b8">{ i18n.T(ctx, "workorder.filter_from") }
					<input type="date" name="from" value={ from } style="padding:7px 9px;border-radius:7px;border:1px solid #334155;background:#0f172a;color:#e2e8f0">
				</label>
				<label style="font-size:12.5px;color:#94a3b8">{ i18n.T(ctx, "workorder.filter_to") }
					<input type="date" name="to" value={ to } style="padding:7px 9px;border-radius:7px;border:1px solid #334155;background:#0f172a;color:#e2e8f0">
				</label>
				<button class="btn btn-p" type="submit">{ i18n.T(ctx, "workorder.search_button") }</button>
				<span id="wo-search-indicator" class="htmx-indicator search-indicator" role="status">{ i18n.T(ctx, "workorder.searching") }</span>
				<a class="btn btn-s" href="/work-orders">{ i18n.T(ctx, "workorder.clear") }</a>
			</form>
			<div class="table-scroll">
			<table class="workorder-table">
				<tr>
					<th>#</th><th>{ i18n.T(ctx, "workorder.col.plate") }</th><th>{ i18n.T(ctx, "workorder.col.customer") }</th><th>{ i18n.T(ctx, "workorder.col.technician") }</th><th>{ i18n.T(ctx, "workorder.col.status") }</th><th>{ i18n.T(ctx, "workorder.col.approval") }</th>
					<th>{ i18n.T(ctx, "workorder.col.part") }</th><th class="num">{ i18n.T(ctx, "workorder.col.mileage_short") }</th><th class="num">{ i18n.T(ctx, "workorder.col.amount") }</th><th>{ i18n.T(ctx, "workorder.col.date") }</th>
				</tr>
				<tbody id="wo-rows">
					for _, wo := range rows {
						@WorkOrderRowContent(wo)
					}
				</tbody>
			</table>
			</div>
			if len(rows) == 0 {
				<div class="empty">{ i18n.T(ctx, "workorder.list_empty") }</div>
			}
			@components.Pager("/work-orders", page, calcPages(total, size), total)
		</div>
	}
}

templ WorkOrderRowContent(wo WorkOrderRow) {
	<tr>
		<td><a href={ "/work-orders/" + strconv.FormatInt(wo.ID, 10) }>{ strconv.FormatInt(wo.ID, 10) }</a></td>
		<td>
			<b>{ wo.PlateNumber }</b><br>
			<span style="color:#64748b;font-size:12px">{ wo.BrandModel }</span>
		</td>
		<td>
			{ wo.CustomerName }<br>
			<span style="color:#64748b;font-size:12px">{ wo.CustomerPhone }</span>
		</td>
		<td>{ wo.TechnicianName }</td>
		<td>
			<span class={ "pill " + wo.StatusPill }>{ wo.StatusLabel }</span>
			if wo.IsInsurance {
				<span class="pill p-waitparts">{ i18n.T(ctx, "workorder.insurance_short") }</span>
			}

		</td>
		<td><span class={ "pill " + wo.ApprovalPill }>{ wo.ApprovalLabel }</span></td>
		<td style="font-size:12.5px;max-width:190px">
			if wo.PartCount > 0 {
				{ wo.PartSummary }
				if wo.PartCount > 1 {
					<span style="color:#64748b;font-size:11.5px">{ i18n.T(ctx, "workorder.and_more") } { strconv.Itoa(wo.PartCount) } { i18n.T(ctx, "workorder.items_unit") }</span>
				}
			} else {
				<span style="color:#475569">—</span>
			}
		</td>
		<td class="num">{ strconv.Itoa(wo.CurrentMileage) }</td>
		<td class="num">{ moneyFmt(wo.TotalAmount) }</td>
		<td style="font-size:12.5px;color:#94a3b8">{ wo.CreatedAt }</td>
	</tr>
}

templ WorkOrderSearchError() {
	<tr><td colspan="10">
		<div class="msg msg-err">
			{ i18n.T(ctx, "workorder.search_error") }
			<button class="btn btn-s" type="button"
				onclick="htmx.trigger(document.querySelector('[name=q]'), 'search')">{ i18n.T(ctx, "workorder.retry") }</button>
		</div>
	</td></tr>
}

// WorkOrderSearchRows HTMX 即時搜尋回傳的純列。
templ WorkOrderSearchRows(rows []WorkOrderRow) {
	if len(rows) == 0 {
		<tr><td colspan="10" style="color:#64748b;text-align:center;padding:20px">{ i18n.T(ctx, "workorder.search_no_results") }</td></tr>
	}
	for _, wo := range rows {
		@WorkOrderRowContent(wo)
	}
}

var _ = model.WorkOrder{}
