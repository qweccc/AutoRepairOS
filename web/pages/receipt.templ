package pages

import (
	"fmt"

	"autorepairos/internal/i18n"
)

type ReceiptItem struct {
	Description string
	Quantity    string
	UnitPrice   string
	Subtotal    string
}

type ReceiptPageData struct {
	AppName          string
	WorkOrderID      string
	Date             string
	Status           string
	Approval         string
	CustomerName     string
	CustomerPhone    string
	PlateNumber      string
	BrandModel       string
	Mileage          string
	Technician       string
	Complaint        string
	Items            []ReceiptItem
	ItemTotal        string
	Total            string
	Username         string
	LineBound        bool
	LineJSON         string
	Style            string
}

templ ReceiptPage(data ReceiptPageData) {
	<!DOCTYPE html>
	<html lang="zh-Hant">
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<title>{ fmt.Sprintf(i18n.T(ctx, "receipt.title"), data.WorkOrderID) }</title>
		<style>@templ.Raw(data.Style)</style>
	</head>
	<body>
		<div class="sheet">
			<div class="rpt-head">
				<h1>🔧 { data.AppName }</h1>
				<p>{ i18n.T(ctx, "receipt.subtitle") }</p>
			</div>
			<div class="rpt-meta">
				<div><span>{ i18n.T(ctx, "receipt.wo_no") }</span><b>#{ data.WorkOrderID }</b></div>
				<div><span>{ i18n.T(ctx, "receipt.date") }</span><b>{ data.Date }</b></div>
				<div><span>{ i18n.T(ctx, "receipt.status") }</span><b>{ data.Status }</b></div>
				<div><span>{ i18n.T(ctx, "receipt.approval") }</span><b>{ data.Approval }</b></div>
			</div>
			<div class="rpt-sec">
				<h2>{ i18n.T(ctx, "receipt.customer") }</h2>
				<p><b>{ data.CustomerName }</b> / { data.CustomerPhone }</p>
			</div>
			<div class="rpt-sec">
				<h2>{ i18n.T(ctx, "receipt.line_title") }</h2>
				if data.LineBound {
					<div class="rpt-line"><span>{ i18n.T(ctx, "receipt.line_bound") }</span></div>
					<pre class="rpt-flex">@templ.Raw(data.LineJSON)</pre>
				} else {
					<div class="rpt-line"><span>{ i18n.T(ctx, "receipt.line_unbound") }</span></div>
				}
			</div>
			<div class="rpt-sec">
				<h2>{ i18n.T(ctx, "receipt.vehicle") }</h2>
				<p><b>{ data.PlateNumber }</b> — { data.BrandModel }</p>
				<p>{ fmt.Sprintf(i18n.T(ctx, "receipt.mileage"), data.Mileage) }
					if data.Technician != "" {
						<br/><span class="lbl">{ i18n.T(ctx, "receipt.technician") }</span>{ data.Technician }
					}
					if data.Complaint != "" {
						<br/><span class="lbl">{ i18n.T(ctx, "receipt.complaint") }</span>{ data.Complaint }
					}
				</p>
			</div>
			<div class="rpt-sec">
				<h2>{ i18n.T(ctx, "receipt.items") }</h2>
				<table class="rpt">
					<tr><th>{ i18n.T(ctx, "receipt.col_item") }</th><th class="num">{ i18n.T(ctx, "receipt.col_qty") }</th><th class="num">{ i18n.T(ctx, "receipt.col_unit") }</th><th class="num">{ i18n.T(ctx, "receipt.col_subtotal") }</th></tr>
					for _, item := range data.Items {
						<tr><td>{ item.Description }</td><td class="num">{ item.Quantity }</td><td class="num">{ item.UnitPrice }</td><td class="num">{ item.Subtotal }</td></tr>
					}
				</table>
			</div>
			<div class="rpt-total">
				<div><span>{ i18n.T(ctx, "receipt.item_total") }</span><b>{ data.ItemTotal }</b></div>
				<div class="grand"><span>{ i18n.T(ctx, "receipt.grand_total") }</span><b>{ data.Total }</b></div>
			</div>
			<div class="rpt-foot">
				<p>{ i18n.T(ctx, "receipt.thanks") }</p>
				<p class="tiny">{ fmt.Sprintf(i18n.T(ctx, "receipt.print_meta"), data.Date, data.Username) }</p>
			</div>
		</div>
		<div class="no-print">
			<button class="btn btn-p" onclick="window.print()">🖨 { i18n.T(ctx, "receipt.print") }</button>
			<a class="btn btn-s" href={ "/work-orders/" + data.WorkOrderID }>{ i18n.T(ctx, "receipt.back_wo") }</a>
			<a class="btn btn-p" href={ "/receivables/new?work_order=" + data.WorkOrderID }>{ i18n.T(ctx, "receipt.checkout") }</a>
		</div>
		<script>window.addEventListener('load', function(){ if (location.hash === '#print') window.print(); });</script>
	</body>
	</html>
}
