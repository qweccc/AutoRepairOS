package pages

type ReceiptItem struct {
	Description string
	Quantity    string
	UnitPrice   string
	Subtotal    string
}

type ReceiptPageData struct {
	AppName          string
	WorkOrderID      string
	Date             string
	Status           string
	Approval         string
	CustomerName     string
	CustomerPhone    string
	PlateNumber      string
	BrandModel       string
	Mileage          string
	Technician       string
	Complaint        string
	Items            []ReceiptItem
	ItemTotal        string
	Total            string
	Username         string
	LineBound        bool
	LineJSON         string
	Style            string
}

templ ReceiptPage(data ReceiptPageData) {
	<!DOCTYPE html>
	<html lang="zh-Hant">
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<title>收據 #{ data.WorkOrderID } - AutoRepair OS</title>
		<style>@templ.Raw(data.Style)</style>
	</head>
	<body>
		<div class="sheet">
			<div class="rpt-head">
				<h1>🔧 { data.AppName }</h1>
				<p>車行維修估價單 / 收據</p>
			</div>
			<div class="rpt-meta">
				<div><span>工單編號</span><b>#{ data.WorkOrderID }</b></div>
				<div><span>日期</span><b>{ data.Date }</b></div>
				<div><span>狀態</span><b>{ data.Status }</b></div>
				<div><span>核准</span><b>{ data.Approval }</b></div>
			</div>
			<div class="rpt-sec">
				<h2>客戶</h2>
				<p><b>{ data.CustomerName }</b> / { data.CustomerPhone }</p>
			</div>
			<div class="rpt-sec">
				<h2>LINE 估價單</h2>
				if data.LineBound {
					<div class="rpt-line"><span>LINE 估價單（明細兩欄 + 金額 + 線上核准）</span></div>
					<pre class="rpt-flex">@templ.Raw(data.LineJSON)</pre>
				} else {
					<div class="rpt-line"><span>LINE 估價單：客戶未綁定 line_user_id</span></div>
				}
			</div>
			<div class="rpt-sec">
				<h2>車輛</h2>
				<p><b>{ data.PlateNumber }</b> — { data.BrandModel }</p>
				<p>進廠里程：{ data.Mileage } km
					if data.Technician != "" {
						<br/><span class="lbl">技師：</span>{ data.Technician }
					}
					if data.Complaint != "" {
						<br/><span class="lbl">客戶反映：</span>{ data.Complaint }
					}
				</p>
			</div>
			<div class="rpt-sec">
				<h2>明細</h2>
				<table class="rpt">
					<tr><th>項目</th><th class="num">數量</th><th class="num">單價</th><th class="num">小計</th></tr>
					for _, item := range data.Items {
						<tr><td>{ item.Description }</td><td class="num">{ item.Quantity }</td><td class="num">{ item.UnitPrice }</td><td class="num">{ item.Subtotal }</td></tr>
					}
				</table>
			</div>
			<div class="rpt-total">
				<div><span>項目小計</span><b>{ data.ItemTotal }</b></div>
				<div class="grand"><span>應付總額（含稅）</span><b>{ data.Total }</b></div>
			</div>
			<div class="rpt-foot">
				<p>謝謝惠顧！</p>
				<p class="tiny">列印時間：{ data.Date } / 櫃檯：{ data.Username }</p>
			</div>
		</div>
		<div class="no-print">
			<button class="btn btn-p" onclick="window.print()">🖨 列印</button>
			<a class="btn btn-s" href={ "/work-orders/" + data.WorkOrderID }>返回工單</a>
			<a class="btn btn-p" href={ "/receivables/new?work_order=" + data.WorkOrderID }>收款結帳</a>
		</div>
		<script>window.addEventListener('load', function(){ if (location.hash === '#print') window.print(); });</script>
	</body>
	</html>
}
