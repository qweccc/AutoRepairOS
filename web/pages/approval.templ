package pages

import (
	"strconv"

	"fmt"

	"autorepairos/internal/i18n"
	"autorepairos/internal/model"
)

type ApprovalPageData struct {
	Request     *model.ApprovalRequest
	WorkOrder   *model.WorkOrder
	Customer    *model.Customer
	Items       []model.WorkOrderItem
	IsExpired   bool
	IsDecided   bool
	ErrorMsg    string
	DecidedText string
}

templ ApprovalPage(data ApprovalPageData) {
	<!DOCTYPE html>
	<html lang="zh-TW">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ i18n.T(ctx, "approval.title") }</title>
		<style>
			body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: #1a1a1a; color: #e0e0e0; margin: 0; padding: 20px; }
			.container { max-width: 600px; margin: 0 auto; background: #2d2d2d; border-radius: 8px; padding: 30px; }
			h1 { color: #4a9eff; margin-top: 0; }
			.error { color: #ff6b6b; background: var(--danger-bg); padding: 15px; border-radius: 4px; }
			.success { color: #51cf66; background: #1f3d2f; padding: 15px; border-radius: 4px; }
			.info { background: #1f2d3d; padding: 15px; border-radius: 4px; margin: 15px 0; }
			.btn { display: inline-block; padding: 12px 24px; margin: 10px 5px; border: none; border-radius: 4px; cursor: pointer; font-size: 16px; text-decoration: none; }
			.btn-approve { background: #51cf66; color: white; }
			.btn-reject { background: #ff6b6b; color: white; }
			.btn:hover { opacity: 0.9; }
			.item { border-bottom: 1px solid #3d3d3d; padding: 10px 0; }
			.item:last-child { border-bottom: none; }
		</style>
	</head>
	<body>
		<div class="container">
			<h1>🔧 { i18n.T(ctx, "approval.title") }</h1>
			if data.ErrorMsg != "" {
				<div class="error">{ data.ErrorMsg }</div>
			} else if data.IsExpired {
				<div class="error">{ i18n.T(ctx, "approval.expired") }</div>
			} else if data.IsDecided {
				<div class="success">{ fmt.Sprintf(i18n.T(ctx, "approval.decided"), data.DecidedText, data.Request.DecidedAt) }</div>
			} else if data.Request != nil && data.WorkOrder != nil {
				<div class="info">
					<strong>{ i18n.T(ctx, "approval.wo_no") }</strong>#{ strconv.FormatInt(data.WorkOrder.ID, 10) }<br/>
					<strong>{ i18n.T(ctx, "approval.customer") }</strong>{ data.Customer.Name }<br/>
					<strong>{ i18n.T(ctx, "approval.plate") }</strong>{ data.WorkOrder.PlateNumber }<br/>
					<strong>{ i18n.T(ctx, "approval.expires") }</strong>{ data.Request.ExpiresAt }
				</div>
				if data.Request.ItemSummary != "" {
					<div class="info">
						<strong>{ i18n.T(ctx, "approval.add_items") }</strong><br/>
						{ data.Request.ItemSummary }
					</div>
				}
				if len(data.Items) > 0 {
					<div class="info"><strong>{ i18n.T(ctx, "approval.wo_items") }</strong><br/>
						for _, item := range data.Items {
							<div class="item">{ item.Description } x{ strconv.Itoa(item.Quantity) } - ${ strconv.FormatFloat(item.Subtotal, 'f', 0, 64) }</div>
						}
					</div>
				}
				<form method="POST" action={ "/approval/approve/" + data.Request.Token }>
					<button type="submit" class="btn btn-approve">✅ { i18n.T(ctx, "approval.approve") }</button>
				</form>
				<form method="POST" action={ "/approval/reject/" + data.Request.Token }>
					<button type="submit" class="btn btn-reject">❌ { i18n.T(ctx, "approval.reject") }</button>
				</form>
			}
		</div>
	</body>
	</html>
}

templ ApprovalResult(status, message string) {
	{{ cssClass := "info" }}
	if status == "success" {
		{{ cssClass = "success" }}
	}
	if status == "error" || status == "expired" || status == "decided" {
		{{ cssClass = "error" }}
	}
	<!DOCTYPE html>
	<html lang="zh-TW">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ i18n.T(ctx, "approval.result_title") }</title>
		<style>
			body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: #1a1a1a; color: #e0e0e0; margin: 0; padding: 20px; }
			.container { max-width: 600px; margin: 0 auto; background: #2d2d2d; border-radius: 8px; padding: 30px; }
			h1 { color: #4a9eff; margin-top: 0; }
			.info, .success, .error { padding: 15px; border-radius: 4px; margin: 20px 0; }
			.success { color: #51cf66; background: #1f3d2f; }
			.error { color: #ff6b6b; background: var(--danger-bg); }
			.info { color: #4a9eff; background: #1f2d3d; }
		</style>
	</head>
	<body>
		<div class="container">
			<h1>🔧 { i18n.T(ctx, "approval.result_heading") }</h1>
			<div class={ cssClass }>{ message }</div>
			<p>{ i18n.T(ctx, "approval.close_hint") }</p>
		</div>
	</body>
	</html>
}
