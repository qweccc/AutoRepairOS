package pages

import (
	"fmt"
	"strconv"

	"autorepairos/internal/i18n"
	"autorepairos/internal/model"
	"autorepairos/web/components"
)

type SupplierRow struct {
	ID            int64
	Name          string
	VendorType    string
	VendorLabel   string
	PaymentTerms  string
	Phone         string
	ContactPerson string
	Address       string
	Notes         string
	Active        int
}

// ListSuppliersPage 廠商列表頁（HTMX 即時搜尋）。
templ ListSuppliersPage(rows []SupplierRow, total, page, size int, q, vtype string,
	matCount, venCount int, showAddForm bool, user model.User) {
	@components.Layout(i18n.T(ctx, "supplier.title"), "/suppliers", user, AppName) {
		if showAddForm {
			<div class="card">
				<h2>{ i18n.T(ctx, "supplier.new") }</h2>
				<form class="frm" method="POST" action="/suppliers">
					@components.CSRFInput()
					<label>{ i18n.T(ctx, "supplier.field.name") }<input name="name" required placeholder={ i18n.T(ctx, "supplier.name_placeholder") }></label>
					<label>{ i18n.T(ctx, "supplier.field.type") }<select name="vendor_type">
						<option value="material">{ i18n.T(ctx, "supplier.type.material") }</option>
						<option value="vendor">{ i18n.T(ctx, "supplier.type.vendor") }</option>
					</select></label>
					<label>{ i18n.T(ctx, "supplier.field.phone") }<input name="phone" inputmode="tel"></label>
					<label>{ i18n.T(ctx, "supplier.field.contact_person") }<input name="contact_person"></label>
					<label>{ i18n.T(ctx, "supplier.field.address") }<input name="address"></label>
					<label>{ i18n.T(ctx, "supplier.field.payment_terms") }<select name="payment_terms">
						<option value="cash">{ i18n.T(ctx, "supplier.payment.cash") }</option>
						<option value="monthly">{ i18n.T(ctx, "supplier.payment.monthly") }</option>
						<option value="net30">{ i18n.T(ctx, "supplier.payment.net30") }</option>
						<option value="net60">{ i18n.T(ctx, "supplier.payment.net60") }</option>
					</select></label>
					<label class="full">{ i18n.T(ctx, "supplier.field.notes") }<textarea name="notes"></textarea></label>
					<div class="full"><button class="btn btn-p" type="submit">{ i18n.T(ctx, "common.create") }</button></div>
				</form>
			</div>
		}
		<div class="card">
			<h2>{ fmt.Sprintf(i18n.T(ctx, "supplier.list_title"), total) }</h2>
			<p style="color:#94a3b8;font-size:13.5px;margin:0 0 14px">
				{ i18n.T(ctx, "supplier.hint") }
			</p>
			<div style="margin-bottom:12px;display:flex;gap:6px;flex-wrap:wrap">
				<a class={ "btn " + btnCls(vtype == "") } href="/suppliers">{ i18n.T(ctx, "supplier.filter_all") } { strconv.Itoa(matCount+venCount) }</a>
				<a class={ "btn " + btnCls(vtype == "material") } href="/suppliers?type=material">{ i18n.T(ctx, "supplier.type.material") } { strconv.Itoa(matCount) }</a>
				<a class={ "btn " + btnCls(vtype == "vendor") } href="/suppliers?type=vendor">{ i18n.T(ctx, "supplier.type.vendor") } { strconv.Itoa(venCount) }</a>
			</div>
			<input type="search" name="q" value={ q }
				placeholder={ i18n.T(ctx, "supplier.search_placeholder") }
				hx-get="/api/suppliers/search"
				hx-trigger="keyup changed delay:300ms, search"
				hx-target="#supplier-rows"
				hx-swap="innerHTML"
				style="padding:8px 10px;border-radius:7px;border:1px solid #334155;background:#0f172a;color:#e2e8f0;width:280px;margin-bottom:12px">
			<a class="btn btn-s" href="/suppliers">{ i18n.T(ctx, "supplier.clear") }</a>
			<table>
				<tr>
					<th>{ i18n.T(ctx, "supplier.col.name") }</th><th>{ i18n.T(ctx, "supplier.col.status") }</th><th>{ i18n.T(ctx, "supplier.col.type") }</th><th>{ i18n.T(ctx, "supplier.col.payment_terms") }</th><th>{ i18n.T(ctx, "supplier.col.phone") }</th><th>{ i18n.T(ctx, "supplier.col.contact_person") }</th><th>{ i18n.T(ctx, "supplier.col.address") }</th><th>{ i18n.T(ctx, "supplier.col.notes") }</th><th>{ i18n.T(ctx, "supplier.col.actions") }</th>
				</tr>
				<tbody id="supplier-rows">
					for _, s := range rows {
						@SupplierRowContent(s)
					}
				</tbody>
			</table>
			if len(rows) == 0 {
				<div class="empty">{ i18n.T(ctx, "supplier.empty") }</div>
			}
			@components.Pager("/suppliers", page, calcPages(total, size), total)
		</div>
	}
}

func btnCls(active bool) string {
	if active {
		return "btn-p"
	}
	return "btn-s"
}

templ SupplierRowContent(s SupplierRow) {
	<tr>
		<td><b>{ s.Name }</b></td>
		<td>
			if s.Active == 0 {
				<span class="pill" style="background:#7f1d1d;color:#fca5a5">{ i18n.T(ctx, "supplier.status.inactive") }</span>
			}
			if s.Active != 0 {
				<span class="pill" style="background:#14532d;color:#86efac">{ i18n.T(ctx, "supplier.status.active") }</span>
			}
		</td>
		<td>
			if s.VendorType == "vendor" {
				<span class="pill" style="background:#4a2f13;color:#fde68a">{ s.VendorLabel }</span>
			}
			if s.VendorType != "vendor" {
				<span class="pill" style="background:#1e3a5f;color:#bae6fd">{ s.VendorLabel }</span>
			}
		</td>
		<td style="font-size:12.5px;color:#94a3b8">{ s.PaymentTerms }</td>
		<td>{ s.Phone }</td>
		<td>{ s.ContactPerson }</td>
		<td style="font-size:12.5px">{ s.Address }</td>
		<td style="font-size:12px;color:#94a3b8">{ s.Notes }</td>
		<td>
			if s.Active == 0 {
				<a class="btn btn-s" href={ "/suppliers/" + strconv.FormatInt(s.ID, 10) + "/reactivate" }
					hx-post={ "/suppliers/" + strconv.FormatInt(s.ID, 10) + "/reactivate" }>{ i18n.T(ctx, "supplier.action.reactivate") }</a>
			}
			if s.Active != 0 {
				<a class="btn btn-s" href={ "/suppliers/" + strconv.FormatInt(s.ID, 10) + "/edit" }>{ i18n.T(ctx, "common.edit") }</a>
				<a class="btn btn-s" href={ "/suppliers/" + strconv.FormatInt(s.ID, 10) + "/ap-statement" }>{ i18n.T(ctx, "supplier.action.ap_statement") }</a>
			}
		</td>
	</tr>
}

// SupplierSearchRows HTMX 即時搜尋回傳的純列。
templ SupplierSearchRows(rows []SupplierRow) {
	if len(rows) == 0 {
		<tr><td colspan="9" style="color:#64748b;text-align:center;padding:20px">{ i18n.T(ctx, "supplier.search_empty") }</td></tr>
	}
	for _, s := range rows {
		@SupplierRowContent(s)
	}
}

var _ = model.Supplier{}
