package pages

import (
	"fmt"

	"autorepairos/internal/i18n"
	"autorepairos/internal/model"
	"strconv"

	"autorepairos/web/components"
)

type ExpenseRow struct {
	ID     int64
	Date   string
	Part   string
	Notes  string
	AmtIn  float64
	AmtOut float64
}

// ListExpensesPage 零用金支出頁（HTMX 即時搜尋）。
templ ListExpensesPage(rows []ExpenseRow, total, page, size int, q string, sumIn, sumOut float64, user model.User) {
	@components.Layout(i18n.T(ctx, "expense.title"), "/expenses", user, AppName) {
		<div class="card">
			<h2>{ fmt.Sprintf(i18n.T(ctx, "expense.heading"), total) }</h2>
			<div class="msg msg-err" style="margin-bottom:14px">
				{ i18n.T(ctx, "expense.warning_prefix") }<b>{ i18n.T(ctx, "expense.warning_bold") }</b>{ i18n.T(ctx, "expense.warning_suffix") }
			</div>
			<div style="margin-bottom:14px">
				<div class="stat"><b>{ strconv.Itoa(total) }</b><span>{ i18n.T(ctx, "expense.stat_count") }</span></div>
				<div class="stat"><b style="color:var(--ok)">{ moneyFmt(sumIn) }</b><span>{ i18n.T(ctx, "expense.stat_in") }</span></div>
				<div class="stat"><b style="color:var(--danger)">{ moneyFmt(sumOut) }</b><span>{ i18n.T(ctx, "expense.stat_out") }</span></div>
			</div>
			<p style="color:var(--text-sub);font-size:13.5px;margin:0 0 14px">
				{ i18n.T(ctx, "expense.intro") }
			</p>
			<input type="search" name="q" value={ q }
				placeholder={ i18n.T(ctx, "expense.search_placeholder") }
				hx-get="/api/expenses/search"
				hx-trigger="keyup changed delay:300ms, search"
				hx-target="#expense-rows"
				hx-swap="innerHTML"
				style="padding:8px 10px;border-radius:7px;border:1px solid var(--border);background:var(--surface);color:var(--text);width:280px;margin-bottom:12px">
			<table>
				<tr><th>{ i18n.T(ctx, "expense.col_date") }</th><th>{ i18n.T(ctx, "expense.col_account") }</th><th>{ i18n.T(ctx, "expense.col_desc") }</th><th class="num">{ i18n.T(ctx, "expense.col_in") }</th><th class="num">{ i18n.T(ctx, "expense.col_out") }</th></tr>
				<tbody id="expense-rows">
					for _, e := range rows {
						@ExpenseRowContent(e)
					}
				</tbody>
			</table>
			if len(rows) == 0 {
				<div class="empty">{ i18n.T(ctx, "expense.empty") }</div>
			}
			@components.Pager("/expenses", page, calcPages(total, size), total)
		</div>
	}
}

templ ExpenseRowContent(e ExpenseRow) {
	<tr>
		<td style="font-size:12.5px">{ e.Date }</td>
		<td><code style="font-size:12px">{ orEmpty(e.Part) }</code></td>
		<td style="font-size:12.5px">{ orEmpty(e.Notes) }</td>
		<td class="num">
			if e.AmtIn != 0 {
				<span style="color:var(--ok)">{ moneyFmt(e.AmtIn) }</span>
			}
			if e.AmtIn == 0 {
				-
			}
		</td>
		<td class="num">
			if e.AmtOut != 0 {
				<span style="color:var(--danger)">{ moneyFmt(e.AmtOut) }</span>
			}
			if e.AmtOut == 0 {
				-
			}
		</td>
	</tr>
}

// ExpenseSearchRows 支出即時搜尋回傳的純列。
templ ExpenseSearchRows(rows []ExpenseRow) {
	if len(rows) == 0 {
		<tr><td colspan="5" style="color:var(--muted);text-align:center;padding:20px">{ i18n.T(ctx, "expense.no_results") }</td></tr>
	}
	for _, e := range rows {
		@ExpenseRowContent(e)
	}
}
