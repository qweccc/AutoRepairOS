package pages

import (
	"autorepairos/internal/i18n"
	"autorepairos/internal/model"
	"autorepairos/web/components"
	"strconv"
)

type Phase5Cell struct { Value, Class string }
type Phase5Table struct { Headers []string; Rows [][]Phase5Cell; Empty string }
type Phase5Page struct { User model.User; Title, Active string; Body templ.Component }
type Phase5CampaignRow struct { Code, OrderCount, Revenue, Cost, Gross string; LaborRecorded bool }
type Phase5TechRow struct { Name, OrderCount, Hours, HourlyPrice, Commission, Margin string; LaborRecorded bool }
type Phase5ReportStatusRow struct { Label, Pill, Count string }
type Phase5ReportItemRow struct { Description, Quantity, Revenue string }
type Phase5ReportTechRow struct { Name, Orders, Hours, Commission string }
type Phase5ReportLowRow struct { Part, Name, Stock, MinStock, Pill string }
type Phase5ReportAgingRow struct { Label, Count, Amount, Class string }
type Phase5Option struct { Value, Label string }
type Phase5WorklogRow struct { Date, Technician, Hours, Rate, Labor, CommissionRate, Commission, Notes, ID string }
type Phase5WorklogSummaryRow struct { Name, Hours, Commission string }
type Phase5EditWorklogData struct { WOID, LogID, Technician, Date, Hours, Rate, CommissionRate, Notes string }
type Phase5CommissionRow struct { Name, Username, Branch, Orders, Hours, Labor, Commission string }

type Phase5ReportData struct {
	From, To, InsLabel, SelfLabel, InsRevenue, SelfRevenue, TotalRevenue string
	InsCount, SelfCount, TotalCount, InsurancePct string
	AnalyticsLink bool
	StatusSelf, StatusIns []Phase5ReportStatusRow
	ItemsSelf, ItemsIns []Phase5ReportItemRow
	Tech []Phase5ReportTechRow
	Low []Phase5ReportLowRow
	Aging []Phase5ReportAgingRow
	AgingTotalCount, AgingTotalAmount string
}
type Phase5AnalyticsData struct {
	From, To, GroupBy, Gran string
	ShowCost, CanExportCosts bool
	Chart, Campaign, Technician templ.Component
	ProfitLoss, Cars, Parts, Dead []Phase5Table
	ActiveCust, NewCust, OldCust, RepeatCust, AvgPerCust string
	DiscountTotal, WarrantyCount, WarrantyRevenue, WarrantyDiscount string
	WarrantyCostTotal, WarrantyGross string
	WarrantyLaborRecorded bool
	DeadCostTotal, DeadCount, Flash, ARO, OrderCount, GrossStat, RepeatRate, GrossNote string
}
type Phase5WorklogData struct {
	Flash, WOID, StatusLabel, StatusPill, InsuranceLabel, WODateDefault string
	WOAmount, TotalHours, TotalLabor, TotalCommission, Count string
	Rows []Phase5WorklogRow
	Summaries []Phase5WorklogSummaryRow
	Technicians []Phase5Option
}
type Phase5CommissionsData struct {
	Flash, Month, TotalOrders, TotalHours, TotalLabor, TotalCommission string
	Rows []Phase5CommissionRow
}

func phase5ButtonClass(active, key string) string {
	if active == key { return "btn btn-p" }
	return "btn btn-s"
}

templ Phase5PageView(user model.User, data Phase5Page) {
	@components.Layout(data.Title, data.Active, user, AppName) { @data.Body }
}

templ Phase5Tables(sections []Phase5Table) {
	for _, section := range sections {
		if len(section.Headers) > 0 {
			<table>
				<tr>
					for _, h := range section.Headers {
						<th>{ h }</th>
					}
				</tr>
				if len(section.Rows) == 0 {
					<tr><td colspan={ strconv.Itoa(len(section.Headers)) }>{ section.Empty }</td></tr>
				}
				for _, row := range section.Rows {
					<tr>
						for _, cell := range row {
							<td class={ cell.Class }>{ cell.Value }</td>
						}
					</tr>
				}
			</table>
		}
	}
}

templ CampaignAnalysisTable(rows []Phase5CampaignRow, showCost bool) {
	if len(rows) == 0 {
		<div class="empty">{ i18n.T(ctx, "reports.campaign_empty") }</div>
	}
	if len(rows) > 0 {
		<table><tr><th>{ i18n.T(ctx, "reports.field.campaign") }</th><th class="num">{ i18n.T(ctx, "reports.field.orders") }</th><th class="num">{ i18n.T(ctx, "reports.revenue_suffix") }</th>
			if showCost {
				<th class="num">{ i18n.T(ctx, "reports.field.cost") }</th><th class="num">{ i18n.T(ctx, "reports.field.gross") }</th>
			}
		</tr>
			for _, row := range rows {
				<tr><td><code>{ row.Code }</code></td><td class="num">{ row.OrderCount }</td><td class="num">{ row.Revenue }</td>
					if showCost {
						if row.LaborRecorded {
							<td class="num">{ row.Cost }</td><td class="num">{ row.Gross }</td>
						}
						if !row.LaborRecorded {
							<td class="num">{ i18n.T(ctx, "reports.not_recorded") }</td><td class="num">{ i18n.T(ctx, "reports.not_recorded") }</td>
						}
					}
				</tr>
			}
		</table>
	}
}

templ TechnicianEfficiencyTable(rows []Phase5TechRow, unlogged string, showCost bool) {
	if len(rows) == 0 {
		<div class="empty">{ i18n.T(ctx, "reports.tech_empty") }</div>
	}
	if len(rows) > 0 {
		<table><tr><th>{ i18n.T(ctx, "reports.field.tech") }</th><th class="num">{ i18n.T(ctx, "reports.field.completed") }</th><th class="num">{ i18n.T(ctx, "reports.field.hours") }</th><th class="num">{ i18n.T(ctx, "reports.field.hourly") }</th>
			if showCost {
				<th class="num">{ i18n.T(ctx, "reports.field.commission") }</th><th class="num">{ i18n.T(ctx, "reports.field.margin_per_hour") }</th>
			}
		</tr>
			for _, row := range rows {
				<tr><td>{ row.Name }</td><td class="num">{ row.OrderCount }</td><td class="num">{ row.Hours }</td><td class="num">{ row.HourlyPrice }</td>
					if showCost {
						if row.LaborRecorded {
							<td class="num">{ row.Commission }</td><td class="num">{ row.Margin }</td>
						}
						if !row.LaborRecorded {
							<td class="num">{ i18n.T(ctx, "reports.not_recorded") }</td><td class="num">{ i18n.T(ctx, "reports.not_recorded") }</td>
						}
					}
				</tr>
			}
		</table>
	}
	<p style="color:var(--text-sub);font-size:12.5px;margin:8px 0 0">{ i18n.T(ctx, "reports.unlogged_prefix") } { unlogged } { i18n.T(ctx, "reports.unlogged_suffix") }</p>
}

templ ReportStatusTable(label string, rows []Phase5ReportStatusRow) {
	<table><tr><th>{ label }{ i18n.T(ctx, "reports.status_suffix") }</th><th class="num">{ i18n.T(ctx, "reports.field.quantity") }</th></tr>
		for _, row := range rows {
			<tr><td><span class={ "pill " + row.Pill }>{ row.Label }</span></td><td class="num">{ row.Count }</td></tr>
		}
	</table>
}
templ ReportItemsTable(label string, rows []Phase5ReportItemRow) {
	if len(rows) == 0 {
		<div class="empty">{ i18n.T(ctx, "reports.empty_prefix") }{ label }{ i18n.T(ctx, "reports.items_suffix") }</div>
	}
	if len(rows) > 0 {
		<table><tr><th>{ label }{ i18n.T(ctx, "reports.hot_suffix") }</th><th class="num">{ i18n.T(ctx, "reports.field.quantity") }</th><th class="num">{ i18n.T(ctx, "reports.revenue_suffix") }</th></tr>
			for _, row := range rows {
				<tr><td>{ row.Description }</td><td class="num">{ row.Quantity }</td><td class="num">{ row.Revenue }</td></tr>
			}
		</table>
	}
}
templ ReportTechTable(rows []Phase5ReportTechRow) {
	if len(rows) == 0 {
		<div class="empty">{ i18n.T(ctx, "reports.tech_empty") }</div>
	}
	if len(rows) > 0 {
		<table><tr><th>{ i18n.T(ctx, "reports.field.tech") }</th><th class="num">{ i18n.T(ctx, "reports.field.orders") }</th><th class="num">{ i18n.T(ctx, "reports.field.total_hours") }</th><th class="num">{ i18n.T(ctx, "reports.field.total_commission") }</th></tr>
			for _, row := range rows {
				<tr><td>{ row.Name }</td><td class="num">{ row.Orders }</td><td class="num">{ row.Hours }</td><td class="num">{ row.Commission }</td></tr>
			}
		</table>
	}
}
templ ReportLowTable(rows []Phase5ReportLowRow) {
	if len(rows) == 0 {
		<div class="empty">{ i18n.T(ctx, "reports.low_empty") }</div>
	}
	if len(rows) > 0 {
		<table><tr><th>{ i18n.T(ctx, "reports.field.part_number") }</th><th>{ i18n.T(ctx, "reports.field.name") }</th><th class="num">{ i18n.T(ctx, "reports.field.stock") }</th><th class="num">{ i18n.T(ctx, "reports.field.min_stock") }</th></tr>
			for _, row := range rows {
				<tr><td><code>{ row.Part }</code></td><td>{ row.Name }</td><td class="num"><span class={ "pill " + row.Pill }>{ row.Stock }</span></td><td class="num">{ row.MinStock }</td></tr>
			}
		</table>
	}
}

templ ReportsPage(data Phase5ReportData, user model.User) {
	@components.Layout(i18n.T(ctx, "reports.title"), "/reports", user, AppName) {
		<div class="card"><h2>{ i18n.T(ctx, "reports.overview") }</h2><form method="GET" action="/reports"><label>{ i18n.T(ctx, "reports.from") }</label><input name="from" value={ data.From }/><label>{ i18n.T(ctx, "reports.to") }</label><input name="to" value={ data.To }/><button class="btn btn-p" type="submit">{ i18n.T(ctx, "reports.query") }</button><a class="btn btn-p" href="/reports/daily">{ i18n.T(ctx, "reports.daily") }</a><a class="btn btn-s" href={ "/reports/export?from=" + data.From + "&amp;to=" + data.To }>{ i18n.T(ctx, "reports.export_detail") }</a>
			if data.AnalyticsLink {
				<a class="btn btn-s" href="/analytics">{ i18n.T(ctx, "reports.analytics") }</a>
			}
		</form>
			<div><div class="stat"><b>{ data.TotalRevenue }</b><span>{ i18n.T(ctx, "reports.total_revenue") }</span></div><div class="stat"><b>{ data.InsRevenue }</b><span>{ data.InsLabel }{ i18n.T(ctx, "reports.revenue_suffix") }</span></div><div class="stat"><b>{ data.SelfRevenue }</b><span>{ data.SelfLabel }{ i18n.T(ctx, "reports.revenue_suffix") }</span></div><div class="stat"><b>{ data.TotalCount }</b><span>{ i18n.T(ctx, "reports.completed_orders") }</span></div><div class="stat"><b>{ data.InsCount }</b><span>{ data.InsLabel }{ i18n.T(ctx, "reports.pieces_suffix") }</span></div><div class="stat"><b>{ data.SelfCount }</b><span>{ data.SelfLabel }{ i18n.T(ctx, "reports.pieces_suffix") }</span></div></div><p>{ i18n.T(ctx, "reports.revenue_note_prefix") } { data.InsurancePct }{ i18n.T(ctx, "reports.note_suffix") }</p><p>{ i18n.T(ctx, "reports.period_prefix") }{ data.From } ~ { data.To }</p>
		</div>
		<div class="card"><h2>{ i18n.T(ctx, "reports.status_dist_prefix") }{ data.InsLabel } / { data.SelfLabel }）</h2>@ReportStatusTable(data.SelfLabel, data.StatusSelf)<br/>@ReportStatusTable(data.InsLabel, data.StatusIns)</div>
		<div class="card"><h2>{ i18n.T(ctx, "reports.top10") }</h2>@ReportItemsTable(data.SelfLabel, data.ItemsSelf)<br/>@ReportItemsTable(data.InsLabel, data.ItemsIns)</div>
		<div class="card"><h2>{ i18n.T(ctx, "reports.tech_perf") }</h2>@ReportTechTable(data.Tech)</div>
		<div class="card"><h2>{ i18n.T(ctx, "reports.ar_aging") }</h2><table><tr><th>{ i18n.T(ctx, "reports.field.aging_bucket") }</th><th class="num">{ i18n.T(ctx, "reports.field.orders") }</th><th class="num">{ i18n.T(ctx, "reports.field.ar_amount") }</th></tr>
			for _, row := range data.Aging {
				<tr><td>{ row.Label }</td><td class="num">{ row.Count }</td><td class="num">{ row.Amount }</td></tr>
			}
			<tr><td>{ i18n.T(ctx, "reports.total") }</td><td class="num">{ data.AgingTotalCount }</td><td class="num">{ data.AgingTotalAmount }</td></tr></table></div>
		<div class="card"><h2>{ i18n.T(ctx, "reports.low_title") }</h2>@ReportLowTable(data.Low)</div>
	}
	}

	templ WorklogSummaries(rows []Phase5WorklogSummaryRow) {
		if len(rows) == 0 {
			<div class="empty">{ i18n.T(ctx, "reports.worklog_empty") }</div>
		}
		if len(rows) > 0 {
			<table><tr><th>{ i18n.T(ctx, "reports.field.tech") }</th><th>{ i18n.T(ctx, "reports.field.total_hours") }</th><th>{ i18n.T(ctx, "reports.field.total_commission") }</th></tr>
				for _, row := range rows {
					<tr><td>{ row.Name }</td><td>{ row.Hours }</td><td>{ row.Commission }</td></tr>
				}
			</table>
		}
	}
	templ CommissionRows(rows []Phase5CommissionRow) {
		if len(rows) == 0 {
			<div class="empty">{ i18n.T(ctx, "reports.commission_empty") }</div>
		}
		if len(rows) > 0 {
			<table><tr><th>{ i18n.T(ctx, "reports.field.tech") }</th><th>{ i18n.T(ctx, "reports.field.username") }</th><th>{ i18n.T(ctx, "reports.field.branch") }</th><th>{ i18n.T(ctx, "reports.field.orders") }</th><th>{ i18n.T(ctx, "reports.field.total_hours") }</th><th>{ i18n.T(ctx, "reports.field.total_labor") }</th><th>{ i18n.T(ctx, "reports.field.total_commission") }</th></tr>
				for _, row := range rows {
					<tr><td>{ row.Name }</td><td>{ row.Username }</td><td>{ row.Branch }</td><td>{ row.Orders }</td><td>{ row.Hours }</td><td>{ row.Labor }</td><td>{ row.Commission }</td></tr>
				}
			</table>
		}
	}

templ WorklogsPage(data Phase5WorklogData, user model.User) {
	@components.Layout(i18n.T(ctx, "worklog.title"), "/work-orders", user, AppName) {
		@components.FlashMsg(data.Flash)
		<div class="card"><h2>{ i18n.T(ctx, "worklog.heading") }</h2><table><tr><th>{ i18n.T(ctx, "worklog.field.status") }</th><td><span class={ "pill " + data.StatusPill }>{ data.StatusLabel }</span></td><th>{ i18n.T(ctx, "worklog.field.insurance") }</th><td>{ data.InsuranceLabel }</td></tr><tr><th>{ i18n.T(ctx, "worklog.field.wo_total") }</th><td>{ data.WOAmount }</td><th>{ i18n.T(ctx, "reports.field.total_hours") }</th><td>{ data.TotalHours } { i18n.T(ctx, "worklog.hours_suffix") }</td></tr><tr><th>{ i18n.T(ctx, "reports.field.total_labor") }</th><td>{ data.TotalLabor }</td><th>{ i18n.T(ctx, "reports.field.total_commission") }</th><td>{ data.TotalCommission }</td></tr><tr><th>{ i18n.T(ctx, "worklog.field.count") }</th><td>{ data.Count }</td></tr></table></div>
		<div class="card"><h2>{ i18n.T(ctx, "worklog.detail_title") }</h2>
			if len(data.Rows) == 0 {
				<div class="empty">{ i18n.T(ctx, "worklog.empty") }</div>
			}
			if len(data.Rows) > 0 {
				<table><tr><th>{ i18n.T(ctx, "worklog.field.date") }</th><th>{ i18n.T(ctx, "reports.field.tech") }</th><th class="num">{ i18n.T(ctx, "worklog.field.hours") }</th><th class="num">{ i18n.T(ctx, "worklog.field.rate") }</th><th class="num">{ i18n.T(ctx, "worklog.field.labor") }</th><th class="num">{ i18n.T(ctx, "worklog.field.commission_rate") }</th><th class="num">{ i18n.T(ctx, "reports.field.commission") }</th><th>{ i18n.T(ctx, "common.notes") }</th><th>{ i18n.T(ctx, "worklog.field.actions") }</th></tr>
					for _, row := range data.Rows {
						<tr><td>{ row.Date }</td><td>{ row.Technician }</td><td class="num">{ row.Hours }</td><td class="num">{ row.Rate }</td><td class="num">{ row.Labor }</td><td class="num">{ row.CommissionRate }%</td><td class="num">{ row.Commission }</td><td>{ row.Notes }</td><td><a class="btn btn-s" href={ "/work-orders/" + data.WOID + "/worklogs/" + row.ID + "/edit" }>{ i18n.T(ctx, "common.edit") }</a> <form method="POST" action={ "/work-orders/" + data.WOID + "/worklogs/" + row.ID + "/delete" } style="display:inline"><button class="btn btn-d" type="submit">{ i18n.T(ctx, "common.delete") }</button></form></td></tr>
					}
				</table>
			}
			<form method="POST" action={ "/work-orders/" + data.WOID + "/worklogs" }><label>{ i18n.T(ctx, "reports.field.tech") }<select name="technician_id"><option value="0">-</option>
				for _, o := range data.Technicians {
					<option value={ o.Value }>{ o.Label }</option>
				}
			</select></label><label>{ i18n.T(ctx, "worklog.field.work_date") }<input name="work_date" type="date" value={ data.WODateDefault }/></label><label>{ i18n.T(ctx, "worklog.field.hours") }<input name="hours" value="1"/></label><label>{ i18n.T(ctx, "worklog.field.rate") }<input name="hourly_rate" value="0"/></label><label>{ i18n.T(ctx, "worklog.field.commission_rate") }<input name="commission_rate" value="0"/></label><label>{ i18n.T(ctx, "common.notes") }<input name="notes"/></label><button class="btn btn-p" type="submit">{ i18n.T(ctx, "worklog.new") }</button></form>
		</div>
		<div class="card"><h2>{ i18n.T(ctx, "worklog.summary_title") }</h2>@WorklogSummaries(data.Summaries)</div>
	}
}

templ EditWorklogPage(data Phase5EditWorklogData, user model.User) {
	@components.Layout(i18n.T(ctx, "worklog.edit_title"), "/work-orders", user, AppName) { <div class="card"><h2>{ i18n.T(ctx, "worklog.edit_heading") }</h2><form method="POST" action={ "/work-orders/" + data.WOID + "/worklogs/" + data.LogID }><label>{ i18n.T(ctx, "reports.field.tech") }<input value={ data.Technician } disabled/></label><label>{ i18n.T(ctx, "worklog.field.work_date") }<input name="work_date" type="date" value={ data.Date }/></label><label>{ i18n.T(ctx, "worklog.field.hours") }<input name="hours" value={ data.Hours }/></label><label>{ i18n.T(ctx, "worklog.field.rate") }<input name="hourly_rate" value={ data.Rate }/></label><label>{ i18n.T(ctx, "worklog.field.commission_rate") }<input name="commission_rate" value={ data.CommissionRate }/></label><label>{ i18n.T(ctx, "common.notes") }<input name="notes" value={ data.Notes }/></label><button class="btn btn-p" type="submit">{ i18n.T(ctx, "common.save") }</button><a class="btn btn-s" href={ "/work-orders/" + data.WOID + "/worklogs" }>{ i18n.T(ctx, "common.cancel") }</a></form></div> }
}
templ CommissionsPage(data Phase5CommissionsData, user model.User) {
	@components.Layout(i18n.T(ctx, "commissions.title"), "/technicians/commissions", user, AppName) {
		@components.FlashMsg(data.Flash)
		<div class="card"><h2>{ i18n.T(ctx, "commissions.heading_prefix") } { data.Month }</h2><form method="GET" action="/technicians/commissions"><input name="month" value={ data.Month }/><button class="btn btn-p" type="submit">{ i18n.T(ctx, "reports.query") }</button></form><table><tr><th>{ i18n.T(ctx, "commissions.field.orders") }</th><td>{ data.TotalOrders }</td><th>{ i18n.T(ctx, "reports.field.total_hours") }</th><td>{ data.TotalHours }</td></tr><tr><th>{ i18n.T(ctx, "reports.field.total_labor") }</th><td>{ data.TotalLabor }</td><th>{ i18n.T(ctx, "reports.field.total_commission") }</th><td>{ data.TotalCommission }</td></tr></table></div>
		<div class="card"><h2>{ i18n.T(ctx, "commissions.detail_title") }</h2>@CommissionRows(data.Rows)</div>
	}
}

templ AnalyticsPage(data Phase5AnalyticsData, user model.User) {
	@components.Layout(i18n.T(ctx, "reports.analytics"), "/analytics", user, AppName) {
		@components.FlashMsg(data.Flash)
		<div class="card"><h2>{ i18n.T(ctx, "reports.analytics") }</h2>
			<a class={ phase5ButtonClass(data.Gran, "day") } href={ "/analytics?gran=day&amp;group=" + data.GroupBy }>{ i18n.T(ctx, "analytics.today") }</a>
			<a class={ phase5ButtonClass(data.Gran, "week") } href={ "/analytics?gran=week&amp;group=" + data.GroupBy }>{ i18n.T(ctx, "analytics.week") }</a>
			<a class={ phase5ButtonClass(data.Gran, "month") } href={ "/analytics?gran=month&amp;group=" + data.GroupBy }>{ i18n.T(ctx, "analytics.month") }</a>
			<a class={ phase5ButtonClass(data.Gran, "year") } href={ "/analytics?gran=year&amp;group=" + data.GroupBy }>{ i18n.T(ctx, "analytics.year") }</a>
			<form method="GET" action="/analytics"><input type="hidden" name="gran" value="custom"/><input type="hidden" name="group" value={ data.GroupBy }/><input name="from" value={ data.From }/><input name="to" value={ data.To }/><select name="group"><option value="kind">{ i18n.T(ctx, "analytics.group_kind") }</option><option value="customer">{ i18n.T(ctx, "analytics.group_customer") }</option><option value="vehicle">{ i18n.T(ctx, "analytics.group_vehicle") }</option></select><button class="btn btn-p" type="submit">{ i18n.T(ctx, "reports.query") }</button><a class="btn btn-s" href={ "/reports/export?from=" + data.From + "&amp;to=" + data.To }>{ i18n.T(ctx, "analytics.export_orders") }</a>
				if data.CanExportCosts {
					<a class="btn btn-s" href={ "/analytics/export?from=" + data.From + "&amp;to=" + data.To }>{ i18n.T(ctx, "analytics.export_summary") }</a>
				}
			</form>
			<p>{ i18n.T(ctx, "reports.period_prefix") }{ data.From } ~ { data.To }</p>
			<div><div class="stat"><b>{ data.ARO }</b><span>{ i18n.T(ctx, "analytics.aro") }</span></div><div class="stat"><b>{ data.OrderCount }</b><span>{ i18n.T(ctx, "analytics.visits") }</span></div>
				if data.CanExportCosts {
					<div class="stat"><b>{ data.GrossStat }</b><span>{ i18n.T(ctx, "analytics.gross_margin") }</span></div>
				}
				<div class="stat"><b>{ data.RepeatRate }</b><span>{ i18n.T(ctx, "analytics.repeat_rate") }</span></div>
			</div><p>{ data.GrossNote }</p>
		</div>
		@data.Chart
		<div class="card"><h2>{ i18n.T(ctx, "analytics.profit_loss") }</h2>@Phase5Tables(data.ProfitLoss)</div>
		<div class="card"><h2>{ i18n.T(ctx, "analytics.tech_efficiency") }</h2>@data.Technician</div>
		<div class="card"><h2>{ i18n.T(ctx, "analytics.retention") }</h2><div class="stat"><b>{ data.ActiveCust }</b><span>{ i18n.T(ctx, "analytics.active_customers") }</span></div><div class="stat"><b>{ data.NewCust }</b><span>{ i18n.T(ctx, "analytics.new_customers") }</span></div><div class="stat"><b>{ data.OldCust }</b><span>{ i18n.T(ctx, "analytics.old_customers") }</span></div><div class="stat"><b>{ data.RepeatCust }</b><span>{ i18n.T(ctx, "analytics.repeat_customers") }</span></div><div class="stat"><b>{ data.AvgPerCust }</b><span>{ i18n.T(ctx, "analytics.avg_per_customer") }</span></div></div>
		<div class="card"><h2>{ i18n.T(ctx, "analytics.campaign") }</h2>@data.Campaign</div><div class="card"><h2>{ i18n.T(ctx, "analytics.hot_vehicles") }</h2>@Phase5Tables(data.Cars)</div><div class="card"><h2>{ i18n.T(ctx, "analytics.hot_parts") }</h2>@Phase5Tables(data.Parts)</div>
		<div class="card"><h2>{ i18n.T(ctx, "analytics.discount_warranty") }</h2><div class="stat"><b>{ data.DiscountTotal }</b><span>{ i18n.T(ctx, "analytics.discount_total") }</span></div><div class="stat"><b>{ data.WarrantyCount }</b><span>{ i18n.T(ctx, "analytics.warranty_count") }</span></div><div class="stat"><b>{ data.WarrantyRevenue }</b><span>{ i18n.T(ctx, "analytics.warranty_revenue") }</span></div><div class="stat"><b>{ data.WarrantyDiscount }</b><span>{ i18n.T(ctx, "analytics.warranty_discount") }</span></div>
			if data.ShowCost {
				if data.WarrantyLaborRecorded {
					<p>{ i18n.T(ctx, "analytics.warranty_cost_prefix") }{ data.WarrantyCostTotal }{ i18n.T(ctx, "analytics.warranty_gross_prefix") } { data.WarrantyGross }</p>
				}
				if !data.WarrantyLaborRecorded {
					<p>{ i18n.T(ctx, "analytics.warranty_not_recorded") }</p>
				}
			}
		</div>
		if data.ShowCost {
			<div class="card"><h2>{ i18n.T(ctx, "analytics.dead_stock") }</h2><p>{ data.DeadCostTotal }{ i18n.T(ctx, "analytics.dead_count_sep") } { data.DeadCount } { i18n.T(ctx, "analytics.dead_items_suffix") }</p>@Phase5Tables(data.Dead)</div>
		}
	}
}
