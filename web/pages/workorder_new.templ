package pages

import (
	"strconv"

	"autorepairos/internal/model"
	"autorepairos/internal/i18n"
	"autorepairos/web/components"
)

type NewWorkOrderPageData struct {
	FlashHTML          string
	NotFoundHTML       string
	ApptBannerHTML     string
	ErrMsg             string
	Complaint          string
	PreAppointment     int64
	PreVehicle         int64
	VehicleOptionsJSON string
	Vehicles           []model.Vehicle
	PresetLabel        string
	Mileage            string
	TechnicianOptions  string
	InsuranceOptions   string
	CustomerHintHTML   string
}

templ NewWorkOrderPage(data NewWorkOrderPageData, user model.User) {
	@components.Layout(i18n.T(ctx, "workorder.new"), "/work-orders", user, AppName) {
		@templ.Raw(data.FlashHTML)
		if data.ErrMsg != "" {
			<div class="msg msg-err">{ data.ErrMsg }</div>
		}
		@templ.Raw(data.NotFoundHTML)
		@templ.Raw(data.ApptBannerHTML)
		<div class="card">
			<h2>{ i18n.T(ctx, "workorder.new") }</h2>
			<p style="color:#64748b;font-size:12.5px;margin:0 0 14px">
				{ i18n.T(ctx, "workorder.new_hint") }
			</p>
			<form class="frm" method="POST" action="/work-orders" id="woForm">
				@components.CSRFInput()
				<input type="hidden" name="appointment_id" value={ strconv.FormatInt(data.PreAppointment, 10) }/>
				<label class="full">{ i18n.T(ctx, "workorder.form.vehicle") }
					<div class="vsearch" data-vsearch data-options={ data.VehicleOptionsJSON } if data.PreVehicle > 0 {
						data-picked="1"
					}>
						<input type="hidden" name="vehicle_id" id="vehicle_id" value={ strconv.FormatInt(data.PreVehicle, 10) } required/>
						<input class="vs-input" id="vsInput" autocomplete="off" autocapitalize="characters" inputmode="text"
							placeholder={ i18n.T(ctx, "workorder.form.vehicle_ph") }
							value={ data.PresetLabel }/>
						<div class="vs-list hidden"></div>
					</div>
					<noscript>
						<select name="vehicle_id_fallback" required style="margin-top:8px">
							<option value="">{ i18n.T(ctx, "workorder.form.vehicle_none") }</option>
							for _, v := range data.Vehicles {
								<option value={ strconv.FormatInt(v.ID, 10) } selected?={ v.ID == data.PreVehicle }>
									{ v.PlateNumber } / { v.BrandModel } / { v.CustomerName }
								</option>
							}
							if len(data.Vehicles) == 0 {
								<option value="0">{ i18n.T(ctx, "workorder.form.vehicle_no_results") }</option>
							}
						</select>
					</noscript>
					<button type="button" class="btn btn-s" style="margin-top:8px" onclick="openQuickModal()">{ i18n.T(ctx, "workorder.form.quick_vehicle") }</button>
				</label>
				<label>{ i18n.T(ctx, "workorder.col.mileage") }<input name="current_mileage" type="number" min="0" value={ data.Mileage } required/></label>
				<label>{ i18n.T(ctx, "workorder.col.technician") }<select name="technician_id"><option value="0">{ i18n.T(ctx, "workorder.form.unassigned") }</option>@templ.Raw(data.TechnicianOptions)</select></label>
				<label>{ i18n.T(ctx, "workorder.form.approval") }<select name="approval_status">
					<option value="not_required">{ i18n.T(ctx, "workorder.form.approval_none") }</option>
					<option value="pending">{ i18n.T(ctx, "workorder.form.approval_customer") }</option>
				</select></label>
				<label>{ i18n.T(ctx, "workorder.form.owner") } @templ.Raw(data.CustomerHintHTML)</label>
				<label class="full">{ i18n.T(ctx, "workorder.form.complaint") }<textarea name="customer_complaint" placeholder={ i18n.T(ctx, "workorder.form.complaint_ph") }>{ data.Complaint }</textarea></label>
				<div class="full" style="border-top:1px solid #263449;padding-top:16px;margin-top:4px">
					<p style="color:#64748b;font-size:12.5px;margin:0 0 12px">
						{ i18n.T(ctx, "workorder.claim.hint") }
					</p>
				</div>
				<label>{ i18n.T(ctx, "workorder.claim.category") }<select name="is_insurance" id="isInsurance">
					<option value="0">{ i18n.T(ctx, "workorder.claim.self_pay") }</option>
					<option value="1">{ i18n.T(ctx, "workorder.claim.insurance") }</option>
				</select></label>
				<label>{ i18n.T(ctx, "workorder.claim.company") }<select name="insurance_company_id" id="insuranceCompany">@templ.Raw(data.InsuranceOptions)</select>
					<input type="hidden" name="insurance_company_id_mirror" id="insuranceCompanyMirror" value=""/>
				</label>
				<label>{ i18n.T(ctx, "workorder.claim.no_label") }<input name="claim_no" placeholder={ i18n.T(ctx, "workorder.claim.no_ph") }/></label>
				<label>{ i18n.T(ctx, "workorder.claim.accident_date") }<input name="accident_date" type="date"/></label>
				<label>{ i18n.T(ctx, "workorder.claim.deductible") }<input name="deductible_amount" type="number" min="0" step="1" placeholder="0"/></label>
				<label>{ i18n.T(ctx, "workorder.claim.date") }<input name="claim_date" type="date"/></label>
				<label>{ i18n.T(ctx, "workorder.claim.amount") }<input name="claim_amount" type="number" min="0" step="0.01" value="0"/></label>
				<label class="full">{ i18n.T(ctx, "workorder.claim.note") }<textarea name="claim_note"></textarea></label>
				<div class="full">
					<button class="btn btn-p" type="submit">{ i18n.T(ctx, "workorder.create") }</button>
					<a class="btn btn-s" href="/work-orders">{ i18n.T(ctx, "workorder.cancel") }</a>
				</div>
			</form>
		</div>

		<script>
			// 未勾選保險件時把保險欄位停用，避免誤填。
			// 注意：disabled 的 input 不會隨表單送出，所以保險公司另以 hidden 鏡像保存 id，
			// 否則「選了保險件但沒改公司」時後端會收不到 insurance_company_id。
			(function () {
				var sel = document.getElementById('isInsurance');
				var mirror = document.getElementById('insuranceCompanyMirror');
				var company = document.querySelector('[name="insurance_company_id"]');
				var others = ['claim_no', 'accident_date', 'deductible_amount', 'claim_date', 'claim_amount', 'claim_note'];
				function sync() {
					var on = sel && sel.value === '1';
					others.forEach(function (n) {
						var el = document.querySelector('[name="' + n + '"]');
						if (el) el.disabled = !on;
					});
					if (company) company.disabled = !on;
					if (mirror) mirror.value = (on && company) ? company.value : '';
				}
				if (sel) {
					sel.addEventListener('change', sync);
					if (company) company.addEventListener('change', sync);
					sync();
				}
			})();
		</script>

		<link rel="stylesheet" href="/static/vehicle-search.css"/>
		<script src="/static/vehicle-search.js" defer></script>
		<div id="quickModal" class="modal-backdrop hidden">
			<div class="modal-card">
				<div class="modal-header">
					<h3>{ i18n.T(ctx, "workorder.quick.title") }</h3>
					<button type="button" class="close-btn" onclick="closeQuickModal()">✕</button>
				</div>
				<form id="quickForm" hx-post="/api/quick-vehicle" hx-target="#quickVehicleStatus" hx-swap="innerHTML">
					@components.CSRFInput()
					<div class="frm">
						<label>{ i18n.T(ctx, "workorder.quick.plate") }<input name="plate_number" id="quickPlate" required/></label>
						<label>{ i18n.T(ctx, "workorder.quick.model") }<input name="brand_model" placeholder={ i18n.T(ctx, "workorder.quick.model_ph") } required/></label>
						<label>{ i18n.T(ctx, "workorder.quick.owner") }<input name="customer_name" required/></label>
						<label>{ i18n.T(ctx, "workorder.quick.phone") }<input name="customer_phone" required/></label>
						<label>{ i18n.T(ctx, "workorder.quick.mileage") }<input name="current_mileage" type="number" min="0" required/></label>
					</div>
					<div class="modal-actions">
						<button type="submit" class="btn btn-p">{ i18n.T(ctx, "workorder.quick.create") }</button>
						<button type="button" class="btn btn-s" onclick="closeQuickModal()">{ i18n.T(ctx, "workorder.cancel") }</button>
					</div>
					<div id="quickVehicleStatus" role="status"></div>
				</form>
			</div>
		</div>
		<script>
			function openQuickModal() {
				document.getElementById('quickModal').classList.remove('hidden');
				document.getElementById('quickPlate').focus();
			}
			function closeQuickModal() {
				document.getElementById('quickModal').classList.add('hidden');
				document.getElementById('quickForm').reset();
			}
			document.addEventListener('htmx:afterRequest', function(e) {
				if (e.detail.elt !== document.getElementById('quickForm')) return;
				var parsed = new DOMParser().parseFromString(e.detail.xhr.responseText, 'text/html');
				var result = parsed.getElementById('quickVehicleResult');
				if (!result || result.dataset.ok !== 'true') return;
							// 車牌已存在時先問清楚再帶入。
							// 櫃檯可能只是打錯車牌，或這真的是同一台車回廠——但直接帶入等於
							// 默默把工單（含之後的收款）掛到現有車主身上，選錯車的代價很高。
							if (result.dataset.duplicate === 'true') {
								var who = (result.dataset.ownerName || '未知車主') +
									(result.dataset.ownerPhone ? '（' + result.dataset.ownerPhone + '）' : '');
								var msg = '車牌 ' + result.dataset.label.split(' / ')[0] + ' 已經有建檔紀錄。\n\n' +
									'現有車主：' + who + '\n\n' +
									'要使用這台既有車輛嗎？\n' +
									'按「取消」可留下來修改車牌，或改用上方的搜尋清單選車。';
								if (!confirm(msg)) {
									return;   // 不帶入，modal 保持開啟讓櫃檯修正
								}
							}
							closeQuickModal();
							var input = document.getElementById('vehicle_id');
							input.value = result.dataset.vehicleId;
							var vs = document.querySelector('.vs-input');
							if (vs) vs.value = result.dataset.label;
							var hint = document.querySelector('[name="current_mileage"]');
							if (hint) hint.value = result.dataset.mileage || '';
							var btn = document.querySelector('.btn-p');
							if (btn) btn.focus();
			});
			document.addEventListener('htmx:responseError', function(e) {
				if (e.detail.elt === document.getElementById('quickForm')) {
					alert(e.detail.xhr.responseText || '建立失敗');
				}
			});
			document.addEventListener('keydown', function(e){ if(e.key==='Escape') closeQuickModal(); });
		</script>
	}
}
