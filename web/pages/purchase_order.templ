package pages

import (
	"strconv"

	"autorepairos/internal/model"
	"autorepairos/web/components"
)

type PurchaseOrderRow struct {
	ID           int64
	SupplierID   int64
	SupplierName string
	OrderDate    string
	Status       string
	TotalAmount  float64
	Notes        string
	ItemCount    int
}

// ListPurchaseOrdersPage 進貨單列表（HTMX 即時搜尋）。
templ ListPurchaseOrdersPage(rows []PurchaseOrderRow, total, page, size int, q, status string, user model.User) {
	@components.Layout("進貨單", "/purchase-orders", user, AppName) {
		<div class="card">
			<h2>進貨單（符合條件 { strconv.Itoa(total) } 筆）</h2>
			<p style="color:#94a3b8;font-size:13.5px;margin:0 0 14px">
				記錄向供應商進貨的品項與金額。開單後加入品項，系統自動算出<b>總共要給廠商多少錢</b>；
				確認進貨後數量自動加回庫存。
			</p>
			<div style="margin-bottom:12px">
				<a class="btn btn-p" href="/purchase-orders/new">＋ 開立進貨單</a>
			</div>
			<input type="search" name="q" value={ q }
				placeholder="搜尋供應商 / 備註"
				hx-get="/api/purchase-orders/search"
				hx-trigger="keyup changed delay:300ms, search"
				hx-target="#po-rows"
				hx-swap="innerHTML"
				style="padding:8px 10px;border-radius:7px;border:1px solid #334155;background:#0f172a;color:#e2e8f0;width:280px;margin-bottom:12px">
			<table>
				<tr>
					<th>單號</th><th>供應商</th><th>進貨日</th><th class="num">品項數</th>
					<th class="num">應付總額</th><th>狀態</th><th>備註</th><th>操作</th>
				</tr>
				<tbody id="po-rows">
					for _, po := range rows {
						@PurchaseOrderRowContent(po)
					}
				</tbody>
			</table>
			if len(rows) == 0 {
				<div class="empty">尚無進貨單</div>
			}
			@components.Pager("/purchase-orders", page, calcPages(total, size), total)
		</div>
	}
}

templ PurchaseOrderRowContent(po PurchaseOrderRow) {
	<tr>
		<td><a href={ "/purchase-orders/" + strconv.FormatInt(po.ID, 10) }>#{ strconv.FormatInt(po.ID, 10) }</a></td>
		<td>{ po.SupplierName }</td>
		<td style="font-size:12.5px">{ po.OrderDate }</td>
		<td class="num">{ strconv.Itoa(po.ItemCount) }</td>
		<td class="num"><b>{ moneyFmt(po.TotalAmount) }</b></td>
		<td>
			if po.Status == "received" {
				<span class="pill p-completed">已進貨</span>
			}
			if po.Status != "received" {
				<span class="pill p-pending">草稿</span>
			}
		</td>
		<td style="font-size:12.5px;color:#94a3b8">{ orEmpty(po.Notes) }</td>
		<td>
			<a class="btn btn-s" href={ "/purchase-orders/" + strconv.FormatInt(po.ID, 10) }>查看</a>
			if po.Status != "received" {
				<a class="btn btn-d" href={ "/purchase-orders/" + strconv.FormatInt(po.ID, 10) + "/delete" }
					data-confirm="確定刪除此進貨單？">刪除</a>
			}
		</td>
	</tr>
}

// PurchaseOrderSearchRows 即時搜尋回傳純列。
templ PurchaseOrderSearchRows(rows []PurchaseOrderRow) {
	if len(rows) == 0 {
		<tr><td colspan="8" style="color:#64748b;text-align:center;padding:20px">查無進貨單</td></tr>
	}
	for _, po := range rows {
		@PurchaseOrderRowContent(po)
	}
}

// NewPurchaseOrderPage 開立進貨單。
templ NewPurchaseOrderPage(orderDate, supplierOpts, errMsg string, user model.User) {
	@components.Layout("開立進貨單", "/purchase-orders", user, AppName) {
		<div class="card">
			<h2>開立進貨單</h2>
			if errMsg != "" {
				<div class="msg msg-err">{ errMsg }</div>
			}
			<form class="frm" id="newPurchaseOrderForm" method="POST" action="/purchase-orders">
				@components.CSRFInput()
				<label>供應商（廠商）
					<select name="supplier_id" required>
						<option value="">請選擇供應商</option>
						@templ.Raw(supplierOpts)
					</select>
				</label>
				<label>進貨日期<input type="date" name="order_date" value={ orderDate }></label>
				<label>關聯工單（選填）<input name="work_order_id" type="number" min="0" placeholder="工單號碼，例：1153001；留空=一般進貨"></label>
				<label class="full">備註<textarea name="notes" placeholder="例：本月第二批機油進貨"></textarea></label>
				<div class="full">
					<button class="btn btn-p" type="submit">建立並加入品項</button>
					<a class="btn btn-s" href="/purchase-orders">取消</a>
				</div>
				</form>
				@components.InvoiceScanUI()
				<p style="color:#64748b;font-size:12.5px;margin-top:10px">
				若這批貨是為特定工單特別叫的（客戶指定零件、急件補料），填工單號碼；
				一般進貨留空即可（僅入庫）。
				</p>
		</div>
	}
}

// ShowPurchaseOrderPage 進貨單詳情：主檔 + 品項 + 應付總額。
// flashMsg 是 redirectMsg 留下的訊息（如「已進貨（自動建立 N 個新零件）」）；
// templ 頁面不像字串拼接頁面有全域 flash(user model.User)，必須由 handler 取值後傳進來顯示。
templ ShowPurchaseOrderPage(po model.PurchaseOrder, items []model.PurchaseOrderItem,
	total float64, locked bool, supplierOpts string, partCategoryOptions string, flashMsg string, user model.User) {
	@components.Layout("進貨單 #"+strconv.FormatInt(po.ID, 10), "/purchase-orders", user, AppName) {
		if flashMsg != "" {
			<div class="msg msg-ok">{ flashMsg }</div>
		}
		<div class="card">
			<h2>進貨單 #{ strconv.FormatInt(po.ID, 10) } — { po.SupplierName }</h2>
			<table>
				<tr>
					<th style="width:120px">供應商</th><td>{ po.SupplierName }</td>
					<th style="width:120px">進貨日</th><td>{ po.OrderDate }</td>
				</tr>
				<tr>
					<th>關聯工單</th>
					<td>
						if po.WorkOrderID > 0 {
							<a href={ "/work-orders/" + strconv.FormatInt(po.WorkOrderID, 10) }>#{ strconv.FormatInt(po.WorkOrderID, 10) }</a>
						}
						if po.WorkOrderID == 0 {
							<span style="color:#64748b">一般進貨（無特定工單）</span>
						}
					</td>
					<th>狀態</th>
					<td>
						if po.Status == "received" {
							<span class="pill p-completed">已進貨</span>
						}
						if po.Status != "received" {
							<span class="pill p-pending">草稿</span>
						}
					</td>
				</tr>
				<tr>
					<th>建立時間</th><td>{ po.CreatedAt }</td><th></th><td></td>
				</tr>
				if po.Notes != "" {
					<tr><th>備註</th><td colspan="3">{ po.Notes }</td></tr>
				}
			</table>
			<div style="margin-top:16px;padding:14px;background:#0f172a;border:1px solid #334155;border-radius:9px">
				<div style="color:#94a3b8;font-size:12.5px;margin-bottom:6px">應付總額（總共要給廠商多少錢）</div>
				<div style="font-size:28px;font-weight:700;color:#38bdf8" id="po-total">{ moneyFmt(total) }</div>
			</div>
			<div style="margin-top:16px">
				if !locked {
					<form hx-post={ "/purchase-orders/" + strconv.FormatInt(po.ID, 10) + "/items" }
						hx-target="#po-items"
						hx-swap="innerHTML"
						hx-on::after-request="if(event.detail.successful) this.reset();"
						style="display:inline">
						@components.CSRFInput()
						<button class="btn btn-p" type="submit">＋ 加入品項（於下方表單）</button>
					</form>
					<a class="btn btn-o" href={ "/purchase-orders/" + strconv.FormatInt(po.ID, 10) + "/receive" }
						hx-post={ "/purchase-orders/" + strconv.FormatInt(po.ID, 10) + "/receive" }
						data-confirm="確認進貨？將把品項數量加回庫存，之後不可修改。">✓ 確認進貨</a>
				}
				<a class="btn btn-s" href="/purchase-orders">回列表</a>
				if !locked {
					<a class="btn btn-d" href={ "/purchase-orders/" + strconv.FormatInt(po.ID, 10) + "/delete" }
						hx-post={ "/purchase-orders/" + strconv.FormatInt(po.ID, 10) + "/delete" }
						data-confirm="確定刪除此進貨單？">刪除</a>
				}
			</div>
		</div>

		<div class="card">
			<h2>進貨品項</h2>
			<div id="po-items">
				@PurchaseOrderItemsTable(po.ID, items, total, locked)
			</div>
			if !locked {
				@AddPurchaseItemForm(po.ID, partCategoryOptions)
			}
		</div>
	}
}

// PurchaseOrderItemsTable 品項表格（HTMX 局部更新目標）。
templ PurchaseOrderItemsTable(orderID int64, items []model.PurchaseOrderItem, total float64, locked bool) {
	if len(items) == 0 {
		<div class="empty">尚未加入品項</div>
	}
	if len(items) > 0 {
		<table>
			<tr>
				<th>品項</th><th>類別</th><th>料號</th><th class="num">數量</th>
				<th class="num">進貨單價</th><th class="num">小計</th><th>操作</th>
			</tr>
			for _, it := range items {
				<tr>
					<td>{ it.Description }</td>
					<td style="font-size:12px;color:#94a3b8">{ orEmpty(it.Category) }</td>
					<td><code style="font-size:12px">{ orEmpty(it.PartNumber) }</code></td>
					<td class="num">{ trimQtyF(it.Quantity) }</td>
					<td class="num">{ moneyFmt(it.UnitCost) }</td>
					<td class="num"><b>{ moneyFmt(it.Subtotal) }</b></td>
					<td>
						if !locked {
							<a class="btn btn-d"
								hx-delete={ "/purchase-orders/" + strconv.FormatInt(orderID, 10) + "/items/" + strconv.FormatInt(it.ID, 10) }
								hx-target="#po-items"
								hx-swap="innerHTML"
								hx-confirm="刪除此品項？">刪除</a>
						}
						if locked {
							<span style="color:#64748b">—</span>
						}
					</td>
				</tr>
			}
			<tr>
				<td colspan="5" style="text-align:right"><b>應付總額</b></td>
				<td class="num"><b style="color:#38bdf8;font-size:16px">{ moneyFmt(total) }</b></td>
				<td></td>
			</tr>
		</table>
	}
}

// AddPurchaseItemForm 加入品項表單（HTMX 無刷新送出）。
// 品項可選庫存零件（帶入名稱單價）或手動輸入（未建檔的新品項）。
// partCategoryOptions 是零件類別下拉選項（lookup 的 category 類型）——
// 手動新增的品項在這裡歸類，確認進貨時會帶到自動建檔的零件。
templ AddPurchaseItemForm(orderID int64, partCategoryOptions string) {
	<form class="frm" id="addItemForm"
		hx-post={ "/purchase-orders/" + strconv.FormatInt(orderID, 10) + "/items" }
		hx-target="#po-items"
		hx-swap="innerHTML"
		hx-on::after-request="if(event.detail.successful) this.reset();"
		style="margin-top:18px">
		@components.CSRFInput()
		<label class="full">品項名稱
			<input name="description" required placeholder="例：機油 5W-30 或 掃描/選擇下方零件帶入">
		</label>
		<label>數量<input name="quantity" type="number" step="0.01" min="0.01" value="1" required></label>
		<label>類別
			<select name="category">
				<option value="">未分類</option>
				@templ.Raw(partCategoryOptions)
			</select>
		</label>
		<label>進貨單價（給廠商的價）<input name="unit_price_f" id="unitPrice" type="number" min="0" step="1" value="0" required></label>
		<input type="hidden" name="unit_cost" id="unitCost" value="0">
		<input type="hidden" name="quantity_hidden" id="quantityHidden" value="1">
		<input type="hidden" name="inventory_item_id" id="inventoryItemId" value="0">
		<input type="hidden" name="part_number" id="partNumber" value="">
		<div class="full">
			<button class="btn btn-p" type="submit">加入品項</button>
		</div>
		</form>
	@PurchaseItemLookup(orderID)
	<script>
		// 數量與單價：使用者輸入的是 quantity 與 unit_price_f，
		// 送出前同步到 hidden 欄位（handler 讀 quantity / unit_cost）。
		document.addEventListener('submit', function(e){
			var form = document.getElementById('addItemForm');
			if (!form || !form.contains(e.target)) return;
			var q = form.querySelector('[name="quantity"]');
			var p = form.querySelector('[name="unit_price_f"]');
			if (q) document.getElementById('quantityHidden').value = q.value;
			if (p) document.getElementById('unitCost').value = p.value;
		}, true);
	</script>
}

// PurchaseItemLookup 品項即時搜尋（選庫存零件帶入）。
templ PurchaseItemLookup(orderID int64) {
	<input type="search" id="poPartSearch"
		placeholder="搜尋庫存零件帶入（例：機油）"
		hx-get="/api/parts"
		hx-trigger="keyup changed delay:300ms"
		hx-target="#po-part-results"
		hx-swap="innerHTML"
		style="padding:8px 10px;border-radius:7px;border:1px solid #334155;background:#0f172a;color:#e2e8f0;width:280px;margin-bottom:8px">
	<div id="po-part-results" style="font-size:13px"></div>
	<script>
		// 點零件項目帶入表單（parts API 回 JSON，這裡監聽點擊）。
		(function(){
			var box = document.getElementById('po-part-results');
			var search = document.getElementById('poPartSearch');
			if (!box || !search) return;
			var timer;
			search.addEventListener('input', function(){
				clearTimeout(timer);
				timer = setTimeout(function(){
					var q = search.value.trim();
					if (q.length < 1) { box.innerHTML = ''; return; }
					fetch('/api/parts?q=' + encodeURIComponent(q))
						.then(function(r){ return r.json(); })
						.then(function(list){
							box.innerHTML = '';
							if (!list || list.length === 0) {
								box.innerHTML = '<div style="color:#64748b;padding:6px">查無零件</div>';
								return;
							}
							list.forEach(function(p){
								var div = document.createElement('div');
								div.style.cssText = 'padding:6px 10px;cursor:pointer;border-bottom:1px solid #1e293b';
								div.innerHTML = '<b>' + p.name + '</b> <span style="color:#64748b">' + p.part_number + '</span>';
								div.addEventListener('click', function(){
									var form = document.getElementById('addItemForm');
									form.querySelector('[name="description"]').value = p.name;
									form.querySelector('[name="unit_price_f"]').value = p.price;
									document.getElementById('inventoryItemId').value = p.id;
									document.getElementById('partNumber').value = p.part_number;
									box.innerHTML = '';
									search.value = '';
								});
								box.appendChild(div);
							});
						});
				}, 300);
			});
		})();
	</script>
}

func trimQtyF(q float64) string {
	if q == float64(int64(q)) {
		return strconv.FormatInt(int64(q), 10)
	}
	return strconv.FormatFloat(q, 'f', 2, 64)
}
