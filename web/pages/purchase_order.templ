package pages

import (
	"fmt"
	"strconv"

	"autorepairos/internal/i18n"
	"autorepairos/internal/model"
	"autorepairos/web/components"
)

type PurchaseOrderRow struct {
	ID           int64
	SupplierID   int64
	SupplierName string
	OrderDate    string
	Status       string
	TotalAmount  float64
	Notes        string
	ItemCount    int
}

// ListPurchaseOrdersPage 進貨單列表（HTMX 即時搜尋）。
templ ListPurchaseOrdersPage(rows []PurchaseOrderRow, total, page, size int, q, status string, user model.User) {
	@components.Layout(i18n.T(ctx, "po.title"), "/purchase-orders", user, AppName) {
		<div class="card">
			<h2>{ fmt.Sprintf(i18n.T(ctx, "po.list_heading"), total) }</h2>
			<p style="color:var(--text-sub);font-size:13.5px;margin:0 0 14px">
				{ i18n.T(ctx, "po.intro_prefix") }<b>{ i18n.T(ctx, "po.intro_bold") }</b>；
				{ i18n.T(ctx, "po.intro_suffix") }
			</p>
			<div style="margin-bottom:12px">
				<a class="btn btn-p" href="/purchase-orders/new">{ i18n.T(ctx, "po.new") }</a>
			</div>
			<input type="search" name="q" value={ q }
				placeholder={ i18n.T(ctx, "po.search_ph") }
				hx-get="/api/purchase-orders/search"
				hx-trigger="keyup changed delay:300ms, search"
				hx-target="#po-rows"
				hx-swap="innerHTML"
				style="padding:8px 10px;border-radius:7px;border:1px solid var(--border);background:var(--surface);color:var(--text);width:280px;margin-bottom:12px">
			<table>
				<tr>
					<th>{ i18n.T(ctx, "po.field.id") }</th><th>{ i18n.T(ctx, "po.field.supplier") }</th><th>{ i18n.T(ctx, "po.field.date") }</th><th class="num">{ i18n.T(ctx, "po.field.item_count") }</th>
					<th class="num">{ i18n.T(ctx, "po.field.payable") }</th><th>{ i18n.T(ctx, "po.field.status") }</th><th>{ i18n.T(ctx, "common.notes") }</th><th>{ i18n.T(ctx, "po.field.actions") }</th>
				</tr>
				<tbody id="po-rows">
					for _, po := range rows {
						@PurchaseOrderRowContent(po)
					}
				</tbody>
			</table>
			if len(rows) == 0 {
				<div class="empty">{ i18n.T(ctx, "po.empty") }</div>
			}
			@components.Pager("/purchase-orders", page, calcPages(total, size), total)
		</div>
	}
}

templ PurchaseOrderRowContent(po PurchaseOrderRow) {
	<tr>
		<td><a href={ "/purchase-orders/" + strconv.FormatInt(po.ID, 10) }>#{ strconv.FormatInt(po.ID, 10) }</a></td>
		<td>{ po.SupplierName }</td>
		<td style="font-size:12.5px">{ po.OrderDate }</td>
		<td class="num">{ strconv.Itoa(po.ItemCount) }</td>
		<td class="num"><b>{ moneyFmt(po.TotalAmount) }</b></td>
		<td>
			if po.Status == "received" {
				<span class="pill p-completed">{ i18n.T(ctx, "po.status_received") }</span>
			}
			if po.Status != "received" {
				<span class="pill p-pending">{ i18n.T(ctx, "po.status_draft") }</span>
			}
		</td>
		<td style="font-size:12.5px;color:var(--text-sub)">{ orEmpty(po.Notes) }</td>
		<td>
			<a class="btn btn-s" href={ "/purchase-orders/" + strconv.FormatInt(po.ID, 10) }>{ i18n.T(ctx, "po.view") }</a>
			if po.Status != "received" {
				<a class="btn btn-d" href={ "/purchase-orders/" + strconv.FormatInt(po.ID, 10) + "/delete" }
					data-confirm={ i18n.T(ctx, "po.delete_confirm") }>{ i18n.T(ctx, "common.delete") }</a>
			}
		</td>
	</tr>
}

// PurchaseOrderSearchRows 即時搜尋回傳純列。
templ PurchaseOrderSearchRows(rows []PurchaseOrderRow) {
	if len(rows) == 0 {
		<tr><td colspan="8" style="color:var(--muted);text-align:center;padding:20px">{ i18n.T(ctx, "po.search_empty") }</td></tr>
	}
	for _, po := range rows {
		@PurchaseOrderRowContent(po)
	}
}

// NewPurchaseOrderPage 開立進貨單。
templ NewPurchaseOrderPage(orderDate, supplierOpts, errMsg string, user model.User) {
	@components.Layout(i18n.T(ctx, "po.new_title"), "/purchase-orders", user, AppName) {
		<div class="card">
			<h2>{ i18n.T(ctx, "po.new_title") }</h2>
			if errMsg != "" {
				<div class="msg msg-err">{ errMsg }</div>
			}
			<form class="frm" id="newPurchaseOrderForm" method="POST" action="/purchase-orders">
				@components.CSRFInput()
				<label>{ i18n.T(ctx, "po.field.supplier_label") }
					<select name="supplier_id" required>
						<option value="">{ i18n.T(ctx, "po.supplier_select") }</option>
						@templ.Raw(supplierOpts)
					</select>
				</label>
				<label>{ i18n.T(ctx, "po.field.order_date") }<input type="date" name="order_date" value={ orderDate }></label>
				<label>{ i18n.T(ctx, "po.field.workorder_label") }<input name="work_order_id" type="number" min="0" placeholder={ i18n.T(ctx, "po.workorder_ph") }></label>
				<label class="full">{ i18n.T(ctx, "common.notes") }<textarea name="notes" placeholder={ i18n.T(ctx, "po.notes_ph") }></textarea></label>
				<div class="full">
					<button class="btn btn-p" type="submit">{ i18n.T(ctx, "po.create_submit") }</button>
					<a class="btn btn-s" href="/purchase-orders">{ i18n.T(ctx, "common.cancel") }</a>
				</div>
				</form>
				@components.InvoiceScanUI()
				<p style="color:var(--muted);font-size:12.5px;margin-top:10px">
				{ i18n.T(ctx, "po.new_hint_prefix") }
				{ i18n.T(ctx, "po.new_hint_suffix") }
				</p>
		</div>
	}
}

// ShowPurchaseOrderPage 進貨單詳情：主檔 + 品項 + 應付總額。
// flashMsg 是 redirectMsg 留下的訊息（如「已進貨（自動建立 N 個新零件）」）；
// templ 頁面不像字串拼接頁面有全域 flash(user model.User)，必須由 handler 取值後傳進來顯示。
templ ShowPurchaseOrderPage(po model.PurchaseOrder, items []model.PurchaseOrderItem,
	total float64, locked bool, supplierOpts string, partCategoryOptions string, flashMsg string, user model.User) {
	@components.Layout(i18n.T(ctx, "po.detail_layout")+strconv.FormatInt(po.ID, 10), "/purchase-orders", user, AppName) {
		if flashMsg != "" {
			<div class="msg msg-ok">{ flashMsg }</div>
		}
		<div class="card">
			<h2>{ i18n.T(ctx, "po.detail_layout") }{ strconv.FormatInt(po.ID, 10) } — { po.SupplierName }</h2>
			<table>
				<tr>
					<th style="width:120px">{ i18n.T(ctx, "po.field.supplier") }</th><td>{ po.SupplierName }</td>
					<th style="width:120px">{ i18n.T(ctx, "po.field.date") }</th><td>{ po.OrderDate }</td>
				</tr>
				<tr>
					<th>{ i18n.T(ctx, "po.field.related_wo") }</th>
					<td>
						if po.WorkOrderID > 0 {
							<a href={ "/work-orders/" + strconv.FormatInt(po.WorkOrderID, 10) }>#{ strconv.FormatInt(po.WorkOrderID, 10) }</a>
						}
						if po.WorkOrderID == 0 {
							<span style="color:var(--muted)">{ i18n.T(ctx, "po.general_stockin") }</span>
						}
					</td>
					<th>{ i18n.T(ctx, "po.field.status") }</th>
					<td>
						if po.Status == "received" {
							<span class="pill p-completed">{ i18n.T(ctx, "po.status_received") }</span>
						}
						if po.Status != "received" {
							<span class="pill p-pending">{ i18n.T(ctx, "po.status_draft") }</span>
						}
					</td>
				</tr>
				<tr>
					<th>{ i18n.T(ctx, "po.field.created") }</th><td>{ po.CreatedAt }</td><th></th><td></td>
				</tr>
				if po.Notes != "" {
					<tr><th>{ i18n.T(ctx, "common.notes") }</th><td colspan="3">{ po.Notes }</td></tr>
				}
			</table>
			<div style="margin-top:16px;padding:14px;background:var(--surface);border:1px solid var(--border);border-radius:9px">
				<div style="color:var(--text-sub);font-size:12.5px;margin-bottom:6px">{ i18n.T(ctx, "po.payable_label") }</div>
				<div style="font-size:28px;font-weight:700;color:#38bdf8" id="po-total">{ moneyFmt(total) }</div>
			</div>
			<div style="margin-top:16px">
				if !locked {
					<form hx-post={ "/purchase-orders/" + strconv.FormatInt(po.ID, 10) + "/items" }
						hx-target="#po-items"
						hx-swap="innerHTML"
						hx-on::after-request="if(event.detail.successful) this.reset();"
hx-on::response-error="alert(event.detail.xhr.responseText || '操作失敗')"
						style="display:inline">
						@components.CSRFInput()
						<button class="btn btn-p" type="submit">{ i18n.T(ctx, "po.add_items_hint") }</button>
					</form>
					<a class="btn btn-o" href={ "/purchase-orders/" + strconv.FormatInt(po.ID, 10) + "/receive" }
						hx-post={ "/purchase-orders/" + strconv.FormatInt(po.ID, 10) + "/receive" }
						data-confirm={ i18n.T(ctx, "po.receive_confirm") }>{ i18n.T(ctx, "po.receive") }</a>
				}
				<a class="btn btn-s" href="/purchase-orders">{ i18n.T(ctx, "po.back") }</a>
				if !locked {
					<a class="btn btn-d" href={ "/purchase-orders/" + strconv.FormatInt(po.ID, 10) + "/delete" }
						hx-post={ "/purchase-orders/" + strconv.FormatInt(po.ID, 10) + "/delete" }
						data-confirm={ i18n.T(ctx, "po.delete_confirm") }>{ i18n.T(ctx, "common.delete") }</a>
				}
			</div>
		</div>

		<div class="card">
			<h2>{ i18n.T(ctx, "po.items_title") }</h2>
			<div id="po-items">
				@PurchaseOrderItemsTable(po.ID, items, total, locked)
			</div>
			if !locked {
				@AddPurchaseItemForm(po.ID, partCategoryOptions)
			}
		</div>
	}
}

// PurchaseOrderItemsTable 品項表格（HTMX 局部更新目標）。
templ PurchaseOrderItemsTable(orderID int64, items []model.PurchaseOrderItem, total float64, locked bool) {
	if len(items) == 0 {
		<div class="empty">{ i18n.T(ctx, "po.items_empty") }</div>
	}
	if len(items) > 0 {
		<table>
			<tr>
				<th>{ i18n.T(ctx, "po.field.item") }</th><th>{ i18n.T(ctx, "po.field.category") }</th><th>{ i18n.T(ctx, "po.field.part_number") }</th><th class="num">{ i18n.T(ctx, "po.field.quantity") }</th>
				<th class="num">{ i18n.T(ctx, "po.field.unit_cost") }</th><th class="num">{ i18n.T(ctx, "po.field.subtotal") }</th><th>{ i18n.T(ctx, "po.field.actions") }</th>
			</tr>
			for _, it := range items {
				<tr>
					<td>{ it.Description }</td>
					<td style="font-size:12px;color:var(--text-sub)">{ orEmpty(it.Category) }</td>
					<td><code style="font-size:12px">{ orEmpty(it.PartNumber) }</code></td>
					<td class="num">{ trimQtyF(it.Quantity) }</td>
					<td class="num">{ moneyFmt(it.UnitCost) }</td>
					<td class="num"><b>{ moneyFmt(it.Subtotal) }</b></td>
					<td>
						if !locked {
							<a class="btn btn-d"
								hx-delete={ "/purchase-orders/" + strconv.FormatInt(orderID, 10) + "/items/" + strconv.FormatInt(it.ID, 10) }
								hx-target="#po-items"
								hx-swap="innerHTML"
								hx-confirm={ i18n.T(ctx, "po.item_delete_confirm") }>{ i18n.T(ctx, "common.delete") }</a>
						}
						if locked {
							<span style="color:var(--muted)">—</span>
						}
					</td>
				</tr>
			}
			<tr>
				<td colspan="5" style="text-align:right"><b>{ i18n.T(ctx, "po.field.payable") }</b></td>
				<td class="num"><b style="color:#38bdf8;font-size:16px">{ moneyFmt(total) }</b></td>
				<td></td>
			</tr>
		</table>
	}
}

// AddPurchaseItemForm 加入品項表單（HTMX 無刷新送出）。
// 品項可選庫存零件（帶入名稱單價）或手動輸入（未建檔的新品項）。
// partCategoryOptions 是零件類別下拉選項（lookup 的 category 類型）——
// 手動新增的品項在這裡歸類，確認進貨時會帶到自動建檔的零件。
templ AddPurchaseItemForm(orderID int64, partCategoryOptions string) {
	<form class="frm" id="addItemForm"
		hx-post={ "/purchase-orders/" + strconv.FormatInt(orderID, 10) + "/items" }
		hx-target="#po-items"
		hx-swap="innerHTML"
		hx-on::after-request="if(event.detail.successful) this.reset();"
hx-on::response-error="alert(event.detail.xhr.responseText || '操作失敗')"
		style="margin-top:18px">
		@components.CSRFInput()
		<label class="full">{ i18n.T(ctx, "po.field.item_name") }
			<input name="description" required placeholder={ i18n.T(ctx, "po.item_name_ph") }>
		</label>
		<label>{ i18n.T(ctx, "po.field.quantity") }<input name="quantity" type="number" step="0.01" min="0.01" value="1" required></label>
		<label>{ i18n.T(ctx, "po.field.category") }
			<select name="category">
				<option value="">{ i18n.T(ctx, "po.uncategorized") }</option>
				@templ.Raw(partCategoryOptions)
			</select>
		</label>
		<label>{ i18n.T(ctx, "po.field.unit_price_label") }<input name="unit_price_f" id="unitPrice" type="number" min="0" step="1" value="0" required></label>
		<input type="hidden" name="unit_cost" id="unitCost" value="0">
		<input type="hidden" name="quantity_hidden" id="quantityHidden" value="1">
		<input type="hidden" name="inventory_item_id" id="inventoryItemId" value="0">
		<input type="hidden" name="part_number" id="partNumber" value="">
		<div class="full">
			<button class="btn btn-p" type="submit">{ i18n.T(ctx, "po.add_item") }</button>
		</div>
		</form>
	@PurchaseItemLookup(orderID)
	<script>
		// 數量與單價：使用者輸入的是 quantity 與 unit_price_f，
		// 送出前同步到 hidden 欄位（handler 讀 quantity / unit_cost）。
		document.addEventListener('submit', function(e){
			var form = document.getElementById('addItemForm');
			if (!form || !form.contains(e.target)) return;
			var q = form.querySelector('[name="quantity"]');
			var p = form.querySelector('[name="unit_price_f"]');
			if (q) document.getElementById('quantityHidden').value = q.value;
			if (p) document.getElementById('unitCost').value = p.value;
		}, true);
	</script>
}

// PurchaseItemLookup 品項即時搜尋（選庫存零件帶入）。
templ PurchaseItemLookup(orderID int64) {
	<input type="search" id="poPartSearch" name="q"
		placeholder={ i18n.T(ctx, "po.part_search_ph") }
		hx-get="/api/parts"
		hx-trigger="keyup changed delay:300ms"
		hx-target="#po-part-results"
		hx-swap="innerHTML"
		style="padding:8px 10px;border-radius:7px;border:1px solid var(--border);background:var(--surface);color:var(--text);width:280px;margin-bottom:8px">
	<div id="po-part-results" style="font-size:13px"></div>
	<script>
		// 查詢交給 HTMX；點選結果仍由小段 JS 將值帶回表單。
		(function(){
			var box = document.getElementById('po-part-results');
			var search = document.getElementById('poPartSearch');
			if (!box || !search) return;
			box.addEventListener('click', function(e){
				var item = e.target.closest('.part-result-item');
				if (!item) return;
				var form = document.getElementById('addItemForm');
				form.querySelector('[name="description"]').value = item.dataset.partName;
				form.querySelector('[name="unit_price_f"]').value = item.dataset.partPrice;
				document.getElementById('inventoryItemId').value = item.dataset.partId;
				document.getElementById('partNumber').value = item.dataset.partNumber;
				box.innerHTML = '';
				search.value = '';
			});
		})();
	</script>
}

func trimQtyF(q float64) string {
	if q == float64(int64(q)) {
		return strconv.FormatInt(int64(q), 10)
	}
	return strconv.FormatFloat(q, 'f', 2, 64)
}
