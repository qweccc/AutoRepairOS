package pages

import (
	"autorepairos/internal/i18n"
	"autorepairos/internal/model"
	"strconv"

	"autorepairos/web/components"
)

type InsuranceCompanyRow struct {
	ID            int64
	Code          string
	Name          string
	TaxID         string
	ClaimPhone    string
	ContactPerson string
	Active        int
}

// ListInsurancePage 保險公司列表頁（HTMX 即時搜尋）。
templ ListInsurancePage(rows []InsuranceCompanyRow, total, page, size int, q string, user model.User) {
	@components.Layout(i18n.T(ctx, "insurance.title"), "/insurance-companies", user, AppName) {
		<div class="card">
			<h2>{ i18n.T(ctx, "insurance.new_title") }</h2>
			<form class="frm" method="POST" action="/insurance-companies">
				@components.CSRFInput()
				<label>{ i18n.T(ctx, "insurance.field.code") }<input name="code" placeholder={ i18n.T(ctx, "insurance.code_ph") } required></label>
				<label>{ i18n.T(ctx, "insurance.field.name") }<input name="name" required></label>
				<label>{ i18n.T(ctx, "insurance.field.tax_id") }<input name="tax_id"></label>
				<label>{ i18n.T(ctx, "insurance.field.claim_phone") }<input name="claim_phone" placeholder={ i18n.T(ctx, "insurance.claim_phone_ph") }></label>
				<label>{ i18n.T(ctx, "insurance.field.contact") }<input name="contact_person"></label>
				<label>{ i18n.T(ctx, "common.address") }<input name="address"></label>
				<label>{ i18n.T(ctx, "insurance.field.postal") }<input name="postal_code"></label>
				<label>{ i18n.T(ctx, "common.notes") }<textarea name="notes"></textarea></label>
				<div class="full"><button class="btn btn-p" type="submit">{ i18n.T(ctx, "common.create") }</button></div>
			</form>
		</div>
		<div class="card">
			<h2>{ i18n.T(ctx, "insurance.list_prefix") } { strconv.Itoa(total) } { i18n.T(ctx, "insurance.list_suffix") }</h2>
			<p style="color:var(--muted);font-size:12.5px;margin:0 0 14px">
				{ i18n.T(ctx, "insurance.intro") }
			</p>
			<input type="search" name="q" value={ q }
				placeholder={ i18n.T(ctx, "insurance.search_ph") }
				hx-get="/api/insurance/search"
				hx-trigger="keyup changed delay:300ms, search"
				hx-target="#insurance-rows"
				hx-swap="innerHTML"
				style="padding:8px 10px;border-radius:7px;border:1px solid var(--border);background:var(--surface);color:var(--text);width:300px;margin-bottom:12px">
			<a class="btn btn-s" href="/insurance-companies">{ i18n.T(ctx, "common.clear") }</a>
			<table>
				<tr>
					<th>{ i18n.T(ctx, "insurance.field.code") }</th><th>{ i18n.T(ctx, "insurance.field.name") }</th><th>{ i18n.T(ctx, "insurance.field.tax_id_short") }</th><th>{ i18n.T(ctx, "insurance.field.claim_phone") }</th><th>{ i18n.T(ctx, "insurance.field.contact") }</th><th>{ i18n.T(ctx, "lookup.field.status") }</th><th>{ i18n.T(ctx, "lookup.field.actions") }</th>
				</tr>
				<tbody id="insurance-rows">
					for _, ic := range rows {
						@InsuranceCompanyRowContent(ic)
					}
				</tbody>
			</table>
			if len(rows) == 0 {
				<div class="empty">{ i18n.T(ctx, "insurance.empty") }</div>
			}
			@components.Pager("/insurance-companies", page, calcPages(total, size), total)
		</div>
	}
}

templ InsuranceCompanyRowContent(ic InsuranceCompanyRow) {
	<tr>
		<td><b>{ ic.Code }</b></td>
		<td>{ ic.Name }</td>
		<td>{ ic.TaxID }</td>
		<td>{ ic.ClaimPhone }</td>
		<td>{ ic.ContactPerson }</td>
		<td>
			if ic.Active == 0 {
				<span class="pill p-cancelled">{ i18n.T(ctx, "lookup.inactive") }</span>
			}
			if ic.Active != 0 {
				<span class="pill p-completed">{ i18n.T(ctx, "lookup.active") }</span>
			}
		</td>
		<td>
			<a class="btn btn-s" href={ "/insurance-companies/" + strconv.FormatInt(ic.ID, 10) + "/edit" }>{ i18n.T(ctx, "common.edit") }</a>
			if ic.Active != 0 {
				<a class="btn btn-d" href={ "/insurance-companies/" + strconv.FormatInt(ic.ID, 10) + "/delete" }
					hx-post={ "/insurance-companies/" + strconv.FormatInt(ic.ID, 10) + "/delete" }
					data-confirm={ i18n.T(ctx, "insurance.disable_confirm") }>{ i18n.T(ctx, "lookup.inactive") }</a>
			}
		</td>
	</tr>
}

// InsuranceSearchRows HTMX 即時搜尋回傳的純列。
templ InsuranceSearchRows(rows []InsuranceCompanyRow) {
	if len(rows) == 0 {
		<tr><td colspan="7" style="color:var(--muted);text-align:center;padding:20px">{ i18n.T(ctx, "insurance.search_empty") }</td></tr>
	}
	for _, ic := range rows {
		@InsuranceCompanyRowContent(ic)
	}
}
