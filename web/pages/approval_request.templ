package pages

import (
	"fmt"
	"strconv"

	"autorepairos/internal/i18n"

	"autorepairos/web/components"
)

// PendingApproval 一筆「還在等客戶回覆」的追加維修授權（已解析成可顯示的欄位）。
//
// 為什麼在 pages 再宣告一次而不是直接用 model.ApprovalRequest：model 的
// ItemSummary 是原始 JSON 字串，頁面不該自己解析 JSON（解析規則必須與
// handler 的驗證共用，否則兩邊對「合法項目」的認知會分岔）。
type PendingApproval struct {
	ID          int64
	Description string
	Quantity    int
	UnitPrice   float64
	ItemType    string
	ExpiresAt   string
}

// ApprovalRequestBlock 工單詳情頁的「追加維修授權」區塊。
//
// 為什麼放在工單詳情頁而不是另開一頁：追加維修是維修過程中發現的動作，
// 技師回報要追加時櫃檯就在同一張工單上操作，多一次跳頁只會讓人漏做。
//
// canCreate 由 handler 依角色決定（POST 端點是 CounterUp），技師看得到區塊
// 但沒有表單——顯示一個送不出去的表單只會讓人以為系統壞了。
templ ApprovalRequestBlock(woID int64, canCreate bool, pending []PendingApproval) {
	// 未決授權一律跳提醒：這是會擋住完工的狀態，放在頁面深處等於沒提醒。
	// 用紅色 msg-err 而不是低調的卡片說明——櫃檯必須立刻看到。
	if len(pending) > 0 {
		<div class="msg msg-err" style="margin-bottom:14px">
			<strong>{ fmt.Sprintf(i18n.T(ctx, "approval_request.pending_warning"), strconv.Itoa(len(pending))) }</strong>
			{ i18n.T(ctx, "approval_request.warning_note") }<br/>
			{ i18n.T(ctx, "approval_request.warning_phone") }
		</div>
	}
	<div class="card">
		<h2>{ i18n.T(ctx, "approval_request.title") }</h2>
		if len(pending) > 0 {
			<table>
				<tr><th>{ i18n.T(ctx, "approval_request.col_item") }</th><th>{ i18n.T(ctx, "approval_request.col_qty") }</th><th class="num">{ i18n.T(ctx, "approval_request.col_unit") }</th><th>{ i18n.T(ctx, "approval_request.col_expires") }</th><th>{ i18n.T(ctx, "approval_request.col_action") }</th></tr>
				for _, p := range pending {
					<tr>
						<td>{ p.Description }<span style="color:#64748b;font-size:12px">（{ itemTypeLabel(ctx, p.ItemType) }）</span></td>
						<td>{ strconv.Itoa(p.Quantity) }</td>
						<td class="num">{ money(p.UnitPrice) }</td>
						<td>{ p.ExpiresAt }</td>
						<td>
							if canCreate {
								<form method="POST" style="display:inline"
									action={ "/work-orders/" + strconv.FormatInt(woID, 10) + "/approval-requests/" + strconv.FormatInt(p.ID, 10) + "/approve-phone" }>
									@components.CSRFInput()
									<input name="note" required placeholder={ i18n.T(ctx, "approval_request.note_placeholder") }
										style="width:170px;padding:5px 8px;border-radius:6px;border:1px solid #334155;background:#0f172a;color:#e2e8f0;font-size:12.5px"/>
									<button class="btn btn-p" type="submit">{ i18n.T(ctx, "approval_request.approve_phone") }</button>
								</form>
								<form method="POST" style="display:inline"
									action={ "/work-orders/" + strconv.FormatInt(woID, 10) + "/approval-requests/" + strconv.FormatInt(p.ID, 10) + "/cancel" }>
									@components.CSRFInput()
									<button class="btn btn-d" type="submit">{ i18n.T(ctx, "common.cancel") }</button>
								</form>
							}
							if canCreate == false {
								<span style="color:#64748b">{ i18n.T(ctx, "approval_request.waiting") }</span>
							}
						</td>
					</tr>
				}
			</table>
		}
		if len(pending) == 0 {
			<div class="empty">{ i18n.T(ctx, "approval_request.empty_pending") }</div>
		}
		if canCreate == false {
			<div class="empty">{ i18n.T(ctx, "approval_request.empty_no_perm") }</div>
		}
		if canCreate {
			<p style="color:#94a3b8;font-size:12.5px;line-height:1.7;margin:12px 0">
				{ i18n.T(ctx, "approval_request.help_line1") }
				{ i18n.T(ctx, "approval_request.help_line2") }<br/>
				{ i18n.T(ctx, "approval_request.help_line3") }<br/>
				<strong>{ i18n.T(ctx, "approval_request.help_phone_line") }</strong>{ i18n.T(ctx, "approval_request.help_phone_rest") }
			</p>
			<form class="frm" method="POST"
				action={ "/work-orders/" + strconv.FormatInt(woID, 10) + "/approval-request" }>
				@components.CSRFInput()
				<label class="full">{ i18n.T(ctx, "approval_request.field_name") }
					<input name="description" required placeholder={ i18n.T(ctx, "approval_request.name_placeholder") }/>
				</label>
				<label>{ i18n.T(ctx, "approval_request.field_qty") }
					<input name="quantity" type="number" min="1" value="1" required/>
				</label>
				<label>{ i18n.T(ctx, "approval_request.field_unit") }
					<input name="unit_price" type="number" min="0" step="1" value="0" required/>
				</label>
				<label>{ i18n.T(ctx, "approval_request.field_type") }
					<select name="item_type">
						<option value="labor">{ i18n.T(ctx, "approval_request.type_labor") }</option>
						<option value="part">{ i18n.T(ctx, "approval_request.type_part") }</option>
						<option value="subcontract">{ i18n.T(ctx, "approval_request.type_sub") }</option>
					</select>
				</label>
				<div class="full">
					<button class="btn btn-p" type="submit">{ i18n.T(ctx, "approval_request.create_action") }</button>
				</div>
			</form>
		}
	</div>
}
