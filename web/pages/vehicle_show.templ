package pages

import (
	"strconv"

	"autorepairos/internal/i18n"
	"autorepairos/internal/model"
	"autorepairos/web/components"
)

// ShowVehiclePage 車輛履歷頁。
// ordersTable、mileageTable、partsTable 為預先產生的 HTML 片段（保留原有複雜邏輯）。
templ ShowVehiclePage(v model.Vehicle,
	orderCount int, totalSpent, unpaid float64, curKm int,
	dateCell, kmCell string,
	mileageTable, ordersTable, partsTable string, user model.User) {

	@components.Layout(i18n.T(ctx, "vehicle.history_title")+" "+v.PlateNumber, "/vehicles", user, AppName) {
		<div class="card">
			<h2>{ v.PlateNumber } — { v.BrandModel }</h2>
			<div style="margin-bottom:14px">
				<div class="stat"><b>{ strconv.Itoa(orderCount) }</b><span>{ i18n.T(ctx, "vehicle.repair_count") }</span></div>
				<div class="stat"><b>{ moneyFmt(totalSpent) }</b><span>{ i18n.T(ctx, "vehicle.total_spent") }</span></div>
				<div class="stat"><b>{ moneyFmt(unpaid) }</b><span>{ i18n.T(ctx, "vehicle.unpaid") }</span></div>
				<div class="stat"><b>{ strconv.Itoa(curKm) }</b><span>{ i18n.T(ctx, "vehicle.recent_km") }</span></div>
			</div>
			<table>
				<tr>
					<th>{ i18n.T(ctx, "vehicle.col_owner") }</th>
					<td>
						{ v.CustomerName }
						<a href={ "/customers/" + strconv.FormatInt(v.CustomerID, 10) + "/edit" } style="font-size:12.5px">{ i18n.T(ctx, "vehicle.edit_customer") }</a>
					</td>
				</tr>
				if v.VehicleTypeLabel != "" {
					<tr><th>{ i18n.T(ctx, "vehicle.vehicle_type") }</th><td>{ v.VehicleTypeLabel }</td></tr>
				}
				if v.FuelTypeLabel != "" {
					<tr><th>{ i18n.T(ctx, "vehicle.fuel_type") }</th><td>{ v.FuelTypeLabel }</td></tr>
				}
				if v.BodyStyleLabel != "" {
					<tr><th>{ i18n.T(ctx, "vehicle.body_style") }</th><td>{ v.BodyStyleLabel }</td></tr>
				}
				if v.OwnerName != "" {
					<tr><th>{ i18n.T(ctx, "vehicle.owner") }</th><td>{ v.OwnerName }</td></tr>
				}
				if v.DriverName != "" {
					<tr><th>{ i18n.T(ctx, "vehicle.driver") }</th><td>{ v.DriverName } { v.DriverPhone }</td></tr>
				}
				if v.ContactName != "" {
					<tr><th>{ i18n.T(ctx, "vehicle.contact") }</th><td>{ v.ContactName } { v.ContactPhone }</td></tr>
				}
				if v.Color != "" {
					<tr><th>{ i18n.T(ctx, "vehicle.color") }</th><td>{ v.Color }</td></tr>
				}
				<tr><th>{ i18n.T(ctx, "vehicle.manufacture_year") }</th><td>{ intOrBlank(v.ManufactureYear) }</td></tr>
				if v.ManufactureDate != "" {
					<tr><th>{ i18n.T(ctx, "vehicle.manufacture_date") }</th><td>{ v.ManufactureDate }</td></tr>
				}
				if v.Displacement > 0 {
					<tr><th>{ i18n.T(ctx, "vehicle.displacement") }</th><td>{ strconv.Itoa(v.Displacement) } c.c.</td></tr>
				}
				<tr><th>VIN</th><td>{ orEmpty(v.VIN) }</td></tr>
				<tr><th>{ i18n.T(ctx, "vehicle.engine_number") }</th><td>{ orEmpty(v.EngineNumber) }</td></tr>
				if v.SeatingCapacity > 0 {
					<tr><th>{ i18n.T(ctx, "vehicle.seating") }</th><td>{ strconv.Itoa(v.SeatingCapacity) }</td></tr>
				}
				<tr><th>{ i18n.T(ctx, "vehicle.inspection_due") }</th><td>{ v.InspectionDueDate }</td></tr>
				<tr>
					<th>{ i18n.T(ctx, "vehicle.last_maintenance") }</th>
					<td>{ v.LastMaintenanceDate }</td>
				</tr>
				<tr>
					<th>{ i18n.T(ctx, "vehicle.maint_interval") }</th>
					<td>{ i18n.T(ctx, "vehicle.every") } { strconv.Itoa(v.MaintIntervalMonths) } { i18n.T(ctx, "vehicle.months_or") } { strconv.Itoa(v.MaintIntervalKm) } { i18n.T(ctx, "vehicle.km_unit") }</td>
				</tr>
			</table>
			<div style="margin-top:14px;padding:12px;background:var(--surface);border:1px solid var(--border);border-radius:9px">
				<div style="color:var(--text-sub);font-size:12.5px;margin-bottom:8px">
					{ i18n.T(ctx, "vehicle.next_maint") }
				</div>
				<table style="margin:0">
					<tr><th style="width:110px">{ i18n.T(ctx, "vehicle.by_date") }</th><td>@templ.Raw(dateCell)</td></tr>
					<tr><th>{ i18n.T(ctx, "vehicle.by_km") }</th><td>@templ.Raw(kmCell)</td></tr>
				</table>
			</div>
			<div style="margin-top:16px">
				<a class="btn btn-p" href={ "/work-orders/new?vehicle=" + strconv.FormatInt(v.ID, 10) }>{ i18n.T(ctx, "vehicle.new_workorder") }</a>
				<a class="btn btn-s" href={ "/vehicles/" + strconv.FormatInt(v.ID, 10) + "/edit" }>{ i18n.T(ctx, "vehicle.edit_vehicle") }</a>
				<a class="btn btn-s" href="/work-orders">{ i18n.T(ctx, "vehicle.view_in_workorders") }</a>
				<a class="btn btn-p" href={ "/vehicles/" + strconv.FormatInt(v.ID, 10) + "/mileage/new" }>{ i18n.T(ctx, "vehicle.record_mileage") }</a>
				<a class="btn btn-s" href="/vehicles">{ i18n.T(ctx, "vehicle.back_to_list") }</a>
			</div>
		</div>
		<div class="card">
			<h2>{ i18n.T(ctx, "vehicle.mileage_history") }</h2>
			<p style="color:var(--muted);font-size:12.5px;margin:0 0 12px">
				{ i18n.T(ctx, "vehicle.mileage_note") }
			</p>
			@templ.Raw(mileageTable)
		</div>
		<div class="card">
			<h2>{ i18n.T(ctx, "vehicle.recent_repairs") }</h2>
			@templ.Raw(ordersTable)
		</div>
		@templ.Raw(partsTable)
	}
}

func moneyFmt(f float64) string {
	return "$" + strconv.FormatFloat(f, 'f', 0, 64)
}

func orEmpty(s string) string {
	if s == "" {
		return "-"
	}
	return s
}
