package pages

import (
	"fmt"
	"strconv"

	"autorepairos/internal/i18n"
	"autorepairos/internal/model"
	"autorepairos/web/components"
)

type APPayableRow struct {
	ID           int64
	SourceLabel  string
	SupplierName string
	Amount       float64
	PaidAmount   float64
	Balance      float64
	DueDate      string
	CreatedAt    string
	PaidAt       string
	Status       string
	StatusLabel  string
	StatusPill   string
	Aging        string
	AgeDays      int
	Payments     []APPaymentRow
}

type APPaymentRow struct {
	Amount float64
	PaidAt string
}

type APAgingSummary struct {
	Name  string
	Count int
	Total float64
}

type APSupplierOption struct {
	ID   int64
	Name string
}

templ APHomePage(rows []APPayableRow, aging []APAgingSummary, suppliers []APSupplierOption,
	supplierID int64, status, today string, user model.User) {
	@components.Layout(i18n.T(ctx, "ap.title"), "/ap", user, AppName) {
		<div class="card">
			<h2>{ i18n.T(ctx, "ap.heading") }</h2>
			<p style="color:var(--text-sub)">{ i18n.T(ctx, "ap.intro") }</p>
			<form class="frm" method="GET" action="/ap">
				<label>{ i18n.T(ctx, "ap.filter_supplier") }
					<select name="supplier_id">
						<option value="0">{ i18n.T(ctx, "ap.all_suppliers") }</option>
						for _, supplier := range suppliers {
							<option value={ strconv.FormatInt(supplier.ID, 10) } selected?={ supplier.ID == supplierID }>{ supplier.Name }</option>
						}
					</select>
				</label>
				<label>{ i18n.T(ctx, "ap.filter_status") }
					<select name="status">
						<option value="" selected?={ status == "" }>{ i18n.T(ctx, "ap.status_open_balance") }</option>
						<option value="all" selected?={ status == "all" }>{ i18n.T(ctx, "ap.status_all") }</option>
						<option value="open" selected?={ status == "open" }>{ i18n.T(ctx, "ap.status_open") }</option>
						<option value="partial" selected?={ status == "partial" }>{ i18n.T(ctx, "ap.status_partial") }</option>
						<option value="paid" selected?={ status == "paid" }>{ i18n.T(ctx, "ap.status_paid") }</option>
						<option value="void" selected?={ status == "void" }>{ i18n.T(ctx, "ap.status_void") }</option>
					</select>
				</label>
				<div class="full">
					<button class="btn btn-p" type="submit">{ i18n.T(ctx, "ap.filter_action") }</button>
					<a class="btn btn-s" href="/ap/statement">{ i18n.T(ctx, "ap.statement_link") }</a>
				</div>
			</form>
		</div>
		<div class="card">
			<h3>{ fmt.Sprintf(i18n.T(ctx, "ap.aging_title"), today) }</h3>
			<p style="color:var(--text-sub);font-size:13px">{ i18n.T(ctx, "ap.aging_note") }</p>
			for _, bucket := range aging {
				<div class="stat"><b>{ moneyFmt(bucket.Total) }</b><span>{ fmt.Sprintf(i18n.T(ctx, "ap.aging_bucket"), bucket.Name, strconv.Itoa(bucket.Count)) }</span></div>
			}
		</div>
		<div class="card">
			<h3>{ i18n.T(ctx, "ap.detail_title") }</h3>
			if len(rows) == 0 {
				<div class="empty">{ i18n.T(ctx, "ap.empty") }</div>
			}
			if len(rows) > 0 {
				<table>
					<thead><tr><th>{ i18n.T(ctx, "ap.col_created_source") }</th><th>{ i18n.T(ctx, "ap.col_supplier") }</th><th class="num">{ i18n.T(ctx, "ap.col_payable") }</th><th class="num">{ i18n.T(ctx, "ap.col_paid") }</th><th class="num">{ i18n.T(ctx, "ap.col_balance") }</th><th>{ i18n.T(ctx, "ap.col_due") }</th><th>{ i18n.T(ctx, "ap.col_aging") }</th><th>{ i18n.T(ctx, "ap.col_status") }</th><th>{ i18n.T(ctx, "ap.col_payment") }</th></tr></thead>
					<tbody>
						for _, row := range rows {
						@APPayableRowContent(row, today, user.Role)
						}
					</tbody>
				</table>
			}
		</div>
	}
}

templ APPayableRowContent(row APPayableRow, today, role string) {
	<tr>
		<td>{ row.CreatedAt }<br/><small>{ row.SourceLabel }</small></td>
		<td>{ row.SupplierName }</td>
		<td class="num">{ moneyFmt(row.Amount) }</td>
		<td class="num">{ moneyFmt(row.PaidAmount) }</td>
		<td class="num"><b>{ moneyFmt(row.Balance) }</b></td>
		<td>{ row.DueDate }</td>
		<td>
			if row.Status == "open" || row.Status == "partial" {
				{ fmt.Sprintf(i18n.T(ctx, "ap.aging_days"), row.Aging, strconv.Itoa(row.AgeDays)) }
			}
		</td>
		<td><span class={ "pill " + row.StatusPill }>{ row.StatusLabel }</span></td>
		<td>
			if row.Status == "open" || row.Status == "partial" {
				<form class="frm" method="POST" action={ "/ap/" + strconv.FormatInt(row.ID, 10) + "/payments" }>
					@components.CSRFInput()
					<label>{ i18n.T(ctx, "ap.pay_now") }
						<input type="number" name="amount" min="0.01" max={ strconv.FormatFloat(row.Balance, 'f', 2, 64) } step="0.01" required/>
					</label>
					<label>{ i18n.T(ctx, "ap.pay_date") }<input type="date" name="paid_at" value={ today } required/></label>
					<button class="btn btn-p" type="submit">{ i18n.T(ctx, "ap.pay_submit") }</button>
				</form>
			}
			if role == "owner" && row.Status != "paid" && row.Status != "void" && row.PaidAmount == 0 {
				<form method="POST" action={ "/ap/" + strconv.FormatInt(row.ID, 10) + "/void" } data-confirm={ i18n.T(ctx, "ap.void_confirm") }>
					@components.CSRFInput()
					<button class="btn btn-d" type="submit">{ i18n.T(ctx, "ap.void_action") }</button>
				</form>
			}
			if len(row.Payments) > 0 {
				<details>
					<summary>{ fmt.Sprintf(i18n.T(ctx, "ap.payments_summary"), strconv.Itoa(len(row.Payments))) }</summary>
					for _, payment := range row.Payments {
						<div>{ payment.PaidAt }・{ moneyFmt(payment.Amount) }</div>
					}
				</details>
			}
		</td>
	</tr>
}

templ APStatementPage(rows []APPayableRow, supplierName, from, to string, amount, paid, balance float64,
	suppliers []APSupplierOption, supplierID int64, csvURL string, user model.User) {
	@components.Layout(i18n.T(ctx, "ap.statement_title"), "/ap", user, AppName) {
		<style>
			@templ.Raw(`@media print {
				nav, header, .no-print { display: none !important; }
				body, .card { background: white !important; color: black !important; box-shadow: none !important; }
				table th, table td { color: black !important; border-color: #999 !important; }
			}`)
		</style>
		<div class="card no-print">
			<h2>{ i18n.T(ctx, "ap.statement_title") }</h2>
			<form class="frm" method="GET" action="/ap/statement">
				<label>{ i18n.T(ctx, "ap.filter_supplier") }
					<select name="supplier_id" required>
						<option value="">{ i18n.T(ctx, "ap.select_supplier") }</option>
						for _, supplier := range suppliers {
							<option value={ strconv.FormatInt(supplier.ID, 10) } selected?={ supplier.ID == supplierID }>{ supplier.Name }</option>
						}
					</select>
				</label>
				<label>{ i18n.T(ctx, "ap.period_from") }<input type="date" name="from" value={ from } required/></label>
				<label>{ i18n.T(ctx, "ap.period_to") }<input type="date" name="to" value={ to } required/></label>
				<div class="full">
					<button class="btn btn-p" type="submit">{ i18n.T(ctx, "ap.query") }</button>
					<a class="btn btn-s" href="/ap">{ i18n.T(ctx, "ap.back_to_ap") }</a>
					if csvURL != "" {
						<a class="btn btn-s" href={ csvURL }>{ i18n.T(ctx, "ap.export_csv") }</a>
						<button class="btn btn-s" type="button" onclick="window.print()">{ i18n.T(ctx, "ap.print_pdf") }</button>
					}
				</div>
			</form>
		</div>
		if supplierName != "" {
			<div class="card">
				<h2>{ fmt.Sprintf(i18n.T(ctx, "ap.statement_heading"), supplierName) }</h2>
				<p>{ fmt.Sprintf(i18n.T(ctx, "ap.period_line"), from, to) }</p>
				<div class="stat"><b>{ moneyFmt(amount) }</b><span>{ i18n.T(ctx, "ap.stat_amount_total") }</span></div>
				<div class="stat"><b>{ moneyFmt(paid) }</b><span>{ i18n.T(ctx, "ap.stat_paid_in_period") }</span></div>
				<div class="stat"><b>{ moneyFmt(balance) }</b><span>{ i18n.T(ctx, "ap.stat_balance_total") }</span></div>
				if len(rows) == 0 {
					<div class="empty">{ i18n.T(ctx, "ap.statement_empty") }</div>
				}
				if len(rows) > 0 {
					<table>
						<thead><tr><th>{ i18n.T(ctx, "ap.col_created") }</th><th>{ i18n.T(ctx, "ap.col_source_doc") }</th><th>{ i18n.T(ctx, "ap.col_due") }</th><th class="num">{ i18n.T(ctx, "ap.col_amount") }</th><th class="num">{ i18n.T(ctx, "ap.col_paid_amount") }</th><th class="num">{ i18n.T(ctx, "ap.col_balance_amount") }</th><th>{ i18n.T(ctx, "ap.col_status") }</th></tr></thead>
						<tbody>
							for _, row := range rows {
								<tr>
									<td>{ row.CreatedAt }</td><td>{ row.SourceLabel }</td><td>{ row.DueDate }</td>
									<td class="num">{ moneyFmt(row.Amount) }</td><td class="num">{ moneyFmt(row.PaidAmount) }</td>
									<td class="num">{ moneyFmt(row.Balance) }</td>
									<td><span class={ "pill " + row.StatusPill }>{ row.StatusLabel }</span></td>
								</tr>
							}
						</tbody>
						<tfoot><tr><th colspan="3">{ i18n.T(ctx, "ap.total") }</th><th class="num">{ moneyFmt(amount) }</th><th class="num">{ moneyFmt(paid) }</th><th class="num">{ moneyFmt(balance) }</th><th></th></tr></tfoot>
					</table>
				}
				<p class="no-print" style="color:var(--text-sub)">{ i18n.T(ctx, "ap.print_note") }</p>
			</div>
		}
	}
}
