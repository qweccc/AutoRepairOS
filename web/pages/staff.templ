package pages

import (
	"autorepairos/internal/i18n"
	"autorepairos/internal/model"
	"strconv"

	"autorepairos/web/components"
)

type StaffRow struct {
	ID           int64
	Username     string
	Name         string
	Role         string
	Branch       string
	Kind         string
	KindLabel    string
	KindCls      string
	NationalID   string
	Birthday     string
	InsStart     string
	InsEnd       string
	InsEndLabel  string
	InsEndRed    bool
	DepOf        int64
	DepOfName    string
	Active       int
	CanEdit      bool
}

type StaffPickerRow struct {
	ID     int64
	Name   string
	Branch string
}

templ StaffPickerResults(rows []StaffPickerRow) {
	if len(rows) == 0 {
		<div class="picker-empty">{ i18n.T(ctx, "staff.picker_empty") }</div>
	}
	for _, s := range rows {
		<button type="button" class="picker-option"
			data-id={ strconv.FormatInt(s.ID, 10) }
			data-name={ s.Name }
			hx-on:click="this.closest('.staff-picker').querySelector('input[type=hidden]').value=this.dataset.id; this.closest('.staff-picker').querySelector('.staff-picker-input').value=this.dataset.name; this.closest('.staff-picker-results').innerHTML=''">
			<strong>{ s.Name }</strong><span>{ s.Branch }</span>
		</button>
	}
}

// ListStaffPage 員工與健保頁（HTMX 即時搜尋）。
templ ListStaffPage(rows []StaffRow, total, page, size int, q, kind string,
	empCount, depCount, insuredCount int, showAddForm bool, roleOpts, branchOpts string, user model.User) {
	@components.Layout(i18n.T(ctx, "staff.title"), "/staff", user, AppName) {
		if showAddForm {
			<div class="card">
				<h2>{ i18n.T(ctx, "staff.new") }</h2>
				<form class="frm" method="POST" action="/staff">
					@components.CSRFInput()
					<label>{ i18n.T(ctx, "staff.field.name") }<input name="name" required></label>
					<label>{ i18n.T(ctx, "staff.field.username") }<input name="username" required></label>
					<label>{ i18n.T(ctx, "staff.field.password") }<input name="password" type="password" required placeholder={ i18n.T(ctx, "staff.password_ph") }></label>
					<label>{ i18n.T(ctx, "staff.field.role") }<select name="role">@templ.Raw(roleOpts)</select></label>
					<label>{ i18n.T(ctx, "staff.field.kind") }<select name="staff_kind">
						<option value="employee">{ i18n.T(ctx, "staff.kind_employee") }</option>
						<option value="dependent">{ i18n.T(ctx, "staff.kind_dependent") }</option>
					</select></label>
					<label>{ i18n.T(ctx, "staff.field.branch") }<select name="staff_branch">@templ.Raw(branchOpts)</select></label>
					<div class="full"><button class="btn btn-p" type="submit">{ i18n.T(ctx, "common.create") }</button></div>
				</form>
				<p style="color:#64748b;font-size:12.5px;margin:10px 0 0">
					{ i18n.T(ctx, "staff.new_hint") }
				</p>
			</div>
		}
		<div class="card">
			<h2>{ i18n.T(ctx, "staff.list_title") }</h2>
			<div style="margin-bottom:14px">
				<div class="stat"><b>{ strconv.Itoa(empCount) }</b><span>{ i18n.T(ctx, "staff.kind_employee") }</span></div>
				<div class="stat"><b>{ strconv.Itoa(depCount) }</b><span>{ i18n.T(ctx, "staff.kind_dependent") }</span></div>
				<div class="stat"><b>{ strconv.Itoa(insuredCount) }</b><span>{ i18n.T(ctx, "staff.insured") }</span></div>
			</div>
			<div style="margin-bottom:12px;display:flex;gap:6px;flex-wrap:wrap">
				<a class={ "btn " + btnCls(kind == "") } href="/staff">{ i18n.T(ctx, "staff.filter_all") } { strconv.Itoa(empCount+depCount) }</a>
				<a class={ "btn " + btnCls(kind == "employee") } href="/staff?kind=employee">{ i18n.T(ctx, "staff.kind_employee") } { strconv.Itoa(empCount) }</a>
				<a class={ "btn " + btnCls(kind == "dependent") } href="/staff?kind=dependent">{ i18n.T(ctx, "staff.kind_dependent") } { strconv.Itoa(depCount) }</a>
			</div>
			<input type="search" name="q" value={ q }
				placeholder={ i18n.T(ctx, "staff.search_ph") }
				hx-get="/api/staff/search"
				hx-trigger="keyup changed delay:300ms, search"
				hx-target="#staff-rows"
				hx-swap="innerHTML"
				style="padding:8px 10px;border-radius:7px;border:1px solid #334155;background:#0f172a;color:#e2e8f0;width:280px;margin-bottom:12px">
			<a class="btn btn-s" href="/staff">{ i18n.T(ctx, "common.clear") }</a>
			<a class="btn btn-s" href="/technicians/commissions">{ i18n.T(ctx, "staff.commissions") }</a>
			<table>
				<tr>
					<th>{ i18n.T(ctx, "staff.field.name") }</th><th>{ i18n.T(ctx, "staff.field.id") }</th><th>{ i18n.T(ctx, "equipment.field.status") }</th><th>{ i18n.T(ctx, "staff.field.kind") }</th><th>{ i18n.T(ctx, "staff.field.branch") }</th>
					<th>{ i18n.T(ctx, "staff.field.dependent_of") }</th><th>{ i18n.T(ctx, "staff.field.national_id") }</th><th>{ i18n.T(ctx, "staff.field.birthday") }</th><th>{ i18n.T(ctx, "staff.field.ins_start") }</th><th>{ i18n.T(ctx, "staff.field.ins_end") }</th><th>{ i18n.T(ctx, "equipmaint.field.actions") }</th>
				</tr>
				<tbody id="staff-rows">
					for _, s := range rows {
						@StaffRowContent(s)
					}
				</tbody>
			</table>
			if len(rows) == 0 {
				<div class="empty">{ i18n.T(ctx, "staff.empty") }</div>
			}
			@components.Pager("/staff", page, calcPages(total, size), total)
		</div>
	}
}

templ StaffRowContent(s StaffRow) {
	<tr>
		<td><b>{ s.Name }</b></td>
		<td><code>{ s.Username }</code></td>
		<td>
			if s.Active == 0 {
				<span class="pill" style="background:#7f1d1d;color:#fca5a5">{ i18n.T(ctx, "staff.inactive") }</span>
			}
			if s.Active != 0 {
				<span class="pill" style="background:#14532d;color:#86efac">{ i18n.T(ctx, "staff.active") }</span>
			}
		</td>
		<td><span class="pill" style={ s.KindCls }>{ s.KindLabel }</span></td>
		<td style="font-size:12.5px;color:#94a3b8">{ s.Branch }</td>
		<td style="font-size:12.5px">
			if s.DepOf > 0 {
				{ s.DepOfName }
			}
			if s.DepOf == 0 {
				<span style="color:#64748b">{ i18n.T(ctx, "staff.self") }</span>
			}
		</td>
		<td><code style="font-size:12px">{ s.NationalID }</code></td>
		<td style="font-size:12.5px">{ s.Birthday }</td>
		<td style="font-size:12.5px">{ s.InsStart }</td>
		<td style="font-size:12.5px">
			if s.InsEndRed {
				<span style="color:#f87171">{ s.InsEndLabel }</span>
			}
			if !s.InsEndRed {
				{ s.InsEndLabel }
			}
		</td>
		<td>
			if s.CanEdit {
				<a class="btn btn-s" href={ "/staff/" + strconv.FormatInt(s.ID, 10) + "/edit" }>{ i18n.T(ctx, "common.edit") }</a>
			}
		</td>
	</tr>
}

// StaffSearchRows HTMX 即時搜尋回傳的純列。
templ StaffSearchRows(rows []StaffRow) {
	if len(rows) == 0 {
		<tr><td colspan="11" style="color:#64748b;text-align:center;padding:20px">{ i18n.T(ctx, "staff.search_empty") }</td></tr>
	}
	for _, s := range rows {
		@StaffRowContent(s)
	}
}
