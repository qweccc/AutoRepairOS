package pages

import (
	"fmt"
	"strconv"

	"autorepairos/internal/i18n"
	"autorepairos/internal/model"
	"autorepairos/web/components"
)

type EquipmentRow struct {
	ID           int64
	Name         string
	Model        string
	SerialNumber string
	Location     string
	Status       string
	StatusLabel  string
	StatusPill   string
}

// ListEquipmentPage 設備管理頁（HTMX 即時搜尋）。
templ ListEquipmentPage(rows []EquipmentRow, total, page, size int, q, status string, user model.User) {
	@components.Layout(i18n.T(ctx, "equipment.title"), "/equipment", user, AppName) {
		<div class="card">
			<h2>{ i18n.T(ctx, "equipment.new") }</h2>
			<form class="frm" method="POST" action="/equipment">
				@components.CSRFInput()
				<label>{ i18n.T(ctx, "equipment.field.name") }<input name="name" required></label>
				<label>{ i18n.T(ctx, "equipment.field.model") }<input name="model"></label>
				<label>{ i18n.T(ctx, "equipment.field.serial") }<input name="serial_number"></label>
				<label>{ i18n.T(ctx, "equipment.field.location") }<input name="location"></label>
				<label>{ i18n.T(ctx, "equipment.field.purchase_date") }<input type="date" name="purchase_date"></label>
				<label>{ i18n.T(ctx, "equipment.field.warranty_expiry") }<input type="date" name="warranty_expiry"></label>
				<label>{ i18n.T(ctx, "equipment.field.status") }
					<select name="status">
						<option value="active">{ i18n.T(ctx, "lookup.active") }</option>
						<option value="maintenance">{ i18n.T(ctx, "equipment.status_maintenance") }</option>
						<option value="retired">{ i18n.T(ctx, "equipment.status_retired") }</option>
					</select>
				</label>
				<label class="full">{ i18n.T(ctx, "common.notes") }<textarea name="notes"></textarea></label>
				<div class="full"><button class="btn btn-p" type="submit">{ i18n.T(ctx, "equipment.new") }</button></div>
			</form>
		</div>
		<div class="card">
			<h2>{ fmt.Sprintf(i18n.T(ctx, "equipment.list_heading"), total) }</h2>
			<input type="search" name="q" value={ q }
				placeholder={ i18n.T(ctx, "equipment.search_ph") }
				hx-get="/api/equipment/search"
				hx-trigger="keyup changed delay:300ms, search"
				hx-target="#equipment-rows"
				hx-swap="innerHTML"
				style="padding:8px 10px;border-radius:7px;border:1px solid #334155;background:#0f172a;color:#e2e8f0;width:260px;margin-bottom:12px">
			<table>
				<tr>
					<th>ID</th><th>{ i18n.T(ctx, "equipment.field.name") }</th><th>{ i18n.T(ctx, "equipment.field.model") }</th><th>{ i18n.T(ctx, "equipment.field.serial") }</th><th>{ i18n.T(ctx, "equipment.field.location") }</th><th>{ i18n.T(ctx, "lookup.field.status") }</th><th>{ i18n.T(ctx, "lookup.field.actions") }</th>
				</tr>
				<tbody id="equipment-rows">
					for _, e := range rows {
						@EquipmentRowContent(e)
					}
				</tbody>
			</table>
			if len(rows) == 0 {
				<div class="empty">{ i18n.T(ctx, "equipment.empty") }</div>
			}
			@components.Pager("/equipment", page, calcPages(total, size), total)
		</div>
	}
}

templ EquipmentRowContent(e EquipmentRow) {
	<tr>
		<td>{ strconv.FormatInt(e.ID, 10) }</td>
		<td><b>{ e.Name }</b></td>
		<td>{ e.Model }</td>
		<td>{ e.SerialNumber }</td>
		<td>{ e.Location }</td>
		<td><span class={ "pill " + e.StatusPill }>{ e.StatusLabel }</span></td>
		<td>
			<a class="btn btn-s" href={ "/equipment/" + strconv.FormatInt(e.ID, 10) + "/edit" }>{ i18n.T(ctx, "common.edit") }</a>
			<a class="btn btn-o" href={ "/equipment/" + strconv.FormatInt(e.ID, 10) + "/maintenance" }>{ i18n.T(ctx, "equipment.maintenance") }</a>
			<a class="btn btn-d" href={ "/equipment/" + strconv.FormatInt(e.ID, 10) + "/delete" }
				hx-post={ "/equipment/" + strconv.FormatInt(e.ID, 10) + "/delete" }
				data-confirm={ i18n.T(ctx, "equipment.delete_confirm") }>{ i18n.T(ctx, "common.delete") }</a>
		</td>
	</tr>
}

// EquipmentSearchRows HTMX 即時搜尋回傳的純列。
templ EquipmentSearchRows(rows []EquipmentRow) {
	if len(rows) == 0 {
		<tr><td colspan="7" style="color:#64748b;text-align:center;padding:20px">{ i18n.T(ctx, "equipment.search_empty") }</td></tr>
	}
	for _, e := range rows {
		@EquipmentRowContent(e)
	}
}

var _ = model.Equipment{}
