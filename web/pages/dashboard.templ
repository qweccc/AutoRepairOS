package pages

import (
	"strconv"

	"autorepairos/internal/i18n"
	"autorepairos/internal/model"
	"autorepairos/web/components"
)

type DashboardStat struct {
	Label string
	Href  string
	Count int
}

type DashboardRecentWorkOrder struct {
	ID           int64
	PlateNumber  string
	BrandModel   string
	CustomerName string
	StatusLabel  string
	StatusPill   string
}

type DashboardIssue struct {
	Label  string
	Detail string
	Href   string
	Query  string
	Count  int
}

templ DashboardPage(stats []DashboardStat, issues []DashboardIssue, recent []DashboardRecentWorkOrder, user model.User) {
	@components.Layout(i18n.T(ctx, "dashboard.title"), "/", user, AppName) {
		@components.Card(i18n.T(ctx, "dashboard.title")) {
			<div>
				for _, stat := range stats {
					<a class="stat" href={ templ.SafeURL(stat.Href) }>
						<b>{ strconv.Itoa(stat.Count) }</b>
						<span>{ stat.Label }</span>
					</a>
				}
			</div>
		}
			@components.Card(i18n.T(ctx, "dashboard.recent")) {
				if len(recent) == 0 {
					@components.Empty(i18n.T(ctx, "dashboard.empty_recent"))
				} else {
					<table>
						<tr><th>#</th><th>{ i18n.T(ctx, "dashboard.col_plate") }</th><th>{ i18n.T(ctx, "dashboard.col_model") }</th><th>{ i18n.T(ctx, "dashboard.col_customer") }</th><th>{ i18n.T(ctx, "dashboard.col_status") }</th></tr>
						for _, wo := range recent {
							<tr>
								<td><a href={ templ.SafeURL("/work-orders/" + strconv.FormatInt(wo.ID, 10)) }>{ strconv.FormatInt(wo.ID, 10) }</a></td>
								<td>{ wo.PlateNumber }</td>
								<td>{ wo.BrandModel }</td>
								<td>{ wo.CustomerName }</td>
								<td><span class={ "pill " + wo.StatusPill }>{ wo.StatusLabel }</span></td>
							</tr>
						}
					</table>
				}
			}
			@components.Card(i18n.T(ctx, "dashboard.fix_needed")) {
				if len(issues) == 0 {
					@components.Empty(i18n.T(ctx, "dashboard.empty_issues"))
				} else {
					<table>
						<tr><th>{ i18n.T(ctx, "dashboard.col_data") }</th><th>{ i18n.T(ctx, "dashboard.col_count") }</th><th>{ i18n.T(ctx, "dashboard.col_desc") }</th><th>{ i18n.T(ctx, "dashboard.col_action") }</th></tr>
						for _, issue := range issues {
							<tr>
								<td>{ issue.Label }</td>
								<td class="num"><b>{ strconv.Itoa(issue.Count) }</b></td>
								<td>{ issue.Detail }</td>
								<td><a class="btn btn-s" href={ templ.SafeURL(issue.Href) }>{ i18n.T(ctx, "dashboard.go_fix") }</a></td>
							</tr>
						}
					</table>
				}
			}
		@components.Card(i18n.T(ctx, "dashboard.modules")) {
			<p style="color:#94a3b8;font-size:13.5px">{ i18n.T(ctx, "dashboard.modules_note") }</p>
		}
	}
}
