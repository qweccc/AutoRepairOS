package pages

import (
	"strconv"

	"autorepairos/web/components"
)

// PhotoMarkerOverlay 照片 Canvas 標記疊加層。
templ PhotoMarkerOverlay(photoURL string, photoID int64) {
	<div data-photo-marker-wrap style="position:relative;display:inline-block;max-width:100%;">
		<img data-photo-marker-img src={ photoURL } style="max-width:100%;max-height:480px;display:block;" />
		<canvas data-photo-marker-canvas
			style="position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;"
			data-photo-id={ strconv.FormatInt(photoID, 10) }></canvas>
	</div>
	<button class="btn btn-s" type="button" data-photo-marker-toggle>標記</button>
	<div data-photo-marker-controls style="display:none;margin-top:8px">
		@PhotoAnnotationForm(photoID)
	</div>
	<div data-photo-annotation-list style="margin-top:8px;font-size:12px;color:#94a3b8"></div>
}

// WalkaroundCanvas 車身舊傷預檢圖（Canvas 點arker）。
templ WalkaroundCanvas(woID int64, marks []struct {
	ID       int64
	MarkType string
	X        float64
	Y        float64
	Note     string
}) {
	<div id="walkaround-wrap" style="position:relative;width:100%;max-width:600px;aspect-ratio:600/240;">
		<svg id="walkaround-svg"
			viewBox="0 0 600 240"
			style="width:100%;height:100%;display:block;"
			data-wo-id={ strconv.FormatInt(woID, 10) }>
			// 車身示意圖（簡化的車體輪廓）
			<rect x="120" y="60" width="360" height="120" rx="20" fill="#1e293b" stroke="#334155" stroke-width="2"/>
			<circle cx="180" cy="190" r="35" fill="#1e293b" stroke="#334155" stroke-width="2"/>
			<circle cx="420" cy="190" r="35" fill="#1e293b" stroke="#334155" stroke-width="2"/>
			<rect x="200" y="75" width="200" height="30" rx="5" fill="#0f172a" stroke="#334155" stroke-width="1"/>
			<rect x="200" y="115" width="200" height="30" rx="5" fill="#0f172a" stroke="#334155" stroke-width="1"/>
		</svg>
		<canvas id="walkaround-canvas"
			style="position:absolute;top:0;left:0;width:100%;height:100%;cursor:crosshair;"
			data-wo-id={ strconv.FormatInt(woID, 10) }></canvas>
	</div>
	<div id="walkaround-mark-list" style="margin-top:10px"></div>
}

// WalkaroundMarkTypeSelect 舊傷類型 select（HTMX 載入表單用）。
templ WalkaroundMarkTypeSelect(selected string) {
	<select name="mark_type" required style="...">
		<option value="">選擇舊傷類型</option>
		<option value="scratch" selected?={ selected == "scratch" }>刮痕</option>
		<option value="dent" selected?={ selected == "dent" }>凹痕</option>
		<option value="crack" selected?={ selected == "crack" }>裂紋</option>
		<option value="rust" selected?={ selected == "rust" }>鏽蝕</option>
		<option value="light_damage" selected?={ selected == "light_damage" }>燈具損壞</option>
		<option value="panel_repair" selected?={ selected == "panel_repair" }>鈑金修復</option>
	</select>
}

// PhotoAnnotationForm 照片標記表單（JSON POST）。
templ PhotoAnnotationForm(photoID int64) {
	<form id="annotation-form"
		data-photo-annotation-form
		data-photo-id={ strconv.FormatInt(photoID, 10) }
		style="margin-top:12px;">
		<input type="hidden" name="type" id="annotation-type" value="line">
		<input type="hidden" name="x1" id="annotation-x1" value="0">
		<input type="hidden" name="y1" id="annotation-y1" value="0">
		<input type="hidden" name="x2" id="annotation-x2" value="0">
		<input type="hidden" name="y2" id="annotation-y2" value="0">
		@components.CSRFInput()
		<label>工具
			<select name="tool">
				<option value="line">畫線</option>
				<option value="rect">方框</option>
				<option value="arrow">箭頭</option>
				<option value="text">文字</option>
			</select>
		</label>
		<label>顏色<input type="color" name="color" value="#ff0000"></label>
		<label class="full">備註<input type="text" name="note" placeholder="選填"></label>
		<div class="full"><button class="btn btn-s" type="submit">儲存標記</button></div>
	</form>
}
