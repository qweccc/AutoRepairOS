package pages

import (
	"strconv"

	"autorepairos/internal/model"
	"autorepairos/web/components"
)

type PhotoCard struct {
	WorkOrderID int64
	ID          int64
	TypeLabel   string
	OriginalName string
	Uploader    string
	CreatedAt   string
	Size        string
	Note        string
	Marker      templ.Component
}

templ WorkOrderPhotosPage(workOrderID int64, photos []PhotoCard, photoDir string, user model.User, flashMessage string) {
	@components.Layout("工單照片", "/work-orders", user, AppName) {
		@components.FlashMsg(flashMessage)
		<div class="card">
			<h2>工單照片（{ strconv.Itoa(len(photos)) } 張）</h2>
			<p style="color:#64748b;font-size:12.5px;margin:0 0 14px">
				離線優先：照片存在本機 <code>{ photoDir }</code>，不依賴外部網路。單檔上限 8MB。
			</p>
			if len(photos) == 0 {
				<div class="empty">尚未上傳任何照片</div>
			} else {
				<div class="pgrid">
					for _, photo := range photos {
						<figure class="pcard" data-work-order-id={ strconv.FormatInt(photo.WorkOrderID, 10) }>
							@photo.Marker
							<figcaption>
								<span class="pill p-progress">{ photo.TypeLabel }</span>
								<div class="pname">{ photo.OriginalName }</div>
								<div class="pmeta">{ photo.Uploader } · { photo.CreatedAt } · { photo.Size }</div>
								if photo.Note != "" {
									<div class="pnote">{ photo.Note }</div>
								}
								<form method="POST"
									action={ "/work-orders/" + strconv.FormatInt(workOrderID, 10) + "/photos/" + strconv.FormatInt(photo.ID, 10) + "/delete" }
									style="display:inline" onsubmit="return confirm('刪除這張照片？')">
									@components.CSRFInput()
									<button class="btn btn-d" type="submit">刪除</button>
								</form>
							</figcaption>
						</figure>
					}
				</div>
			}
		</div>
		<div class="card">
			<h2>上傳照片</h2>
			<form class="frm" method="POST" action={ "/work-orders/" + strconv.FormatInt(workOrderID, 10) + "/photos" } enctype="multipart/form-data">
				@components.CSRFInput()
				<label class="full">選擇照片<input name="photo" type="file" accept="image/*" required></label>
				<label>照片類型<select name="photo_type">
					<option value="damage">車損</option>
					<option value="repair">維修</option>
					<option value="part">零件</option>
					<option value="other">其他</option>
				</select></label>
				<label>備註<input name="note"></label>
				<div class="full"><button class="btn btn-p" type="submit">上傳</button>
					<a class="btn btn-s" href={ "/work-orders/" + strconv.FormatInt(workOrderID, 10) }>返回工單</a></div>
			</form>
		</div>
		<script src="/static/photo-markup.js"></script>
	}
}
