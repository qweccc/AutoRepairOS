package pages

import (
	"fmt"
	"strconv"

	"autorepairos/internal/i18n"
	"autorepairos/internal/model"
	"autorepairos/web/components"
)

type PhotoCard struct {
	WorkOrderID int64
	ID          int64
	TypeLabel   string
	OriginalName string
	Uploader    string
	CreatedAt   string
	Size        string
	Note        string
	Marker      templ.Component
}

templ WorkOrderPhotosPage(workOrderID int64, photos []PhotoCard, photoDir string, user model.User, flashMessage string) {
	@components.Layout(i18n.T(ctx, "photos.title"), "/work-orders", user, AppName) {
		@components.FlashMsg(flashMessage)
		<div class="card">
			<h2>{ fmt.Sprintf(i18n.T(ctx, "photos.list_heading"), len(photos)) }</h2>
			<p style="color:#64748b;font-size:12.5px;margin:0 0 14px">
				{ i18n.T(ctx, "photos.offline_prefix") } <code>{ photoDir }</code>{ i18n.T(ctx, "photos.offline_suffix") }
			</p>
			if len(photos) == 0 {
				<div class="empty">{ i18n.T(ctx, "photos.empty") }</div>
			} else {
				<div class="pgrid">
					for _, photo := range photos {
						<figure class="pcard" data-work-order-id={ strconv.FormatInt(photo.WorkOrderID, 10) }>
							@photo.Marker
							<figcaption>
								<span class="pill p-progress">{ photo.TypeLabel }</span>
								<div class="pname">{ photo.OriginalName }</div>
								<div class="pmeta">{ photo.Uploader } · { photo.CreatedAt } · { photo.Size }</div>
								if photo.Note != "" {
									<div class="pnote">{ photo.Note }</div>
								}
								<form method="POST"
									action={ "/work-orders/" + strconv.FormatInt(workOrderID, 10) + "/photos/" + strconv.FormatInt(photo.ID, 10) + "/delete" }
									style="display:inline" onsubmit="return confirm('刪除這張照片？')">
									@components.CSRFInput()
									<button class="btn btn-d" type="submit">{ i18n.T(ctx, "common.delete") }</button>
								</form>
							</figcaption>
						</figure>
					}
				</div>
			}
		</div>
		<div class="card">
			<h2>{ i18n.T(ctx, "photos.upload_title") }</h2>
			<form class="frm" method="POST" action={ "/work-orders/" + strconv.FormatInt(workOrderID, 10) + "/photos" } enctype="multipart/form-data">
				@components.CSRFInput()
				<label class="full">{ i18n.T(ctx, "photos.select") }<input name="photo" type="file" accept="image/*" required></label>
				<label>{ i18n.T(ctx, "photos.type") }<select name="photo_type">
					<option value="damage">{ i18n.T(ctx, "photos.type_damage") }</option>
					<option value="repair">{ i18n.T(ctx, "photos.type_repair") }</option>
					<option value="part">{ i18n.T(ctx, "photos.type_part") }</option>
					<option value="other">{ i18n.T(ctx, "photos.type_other") }</option>
				</select></label>
				<label>{ i18n.T(ctx, "common.notes") }<input name="note"></label>
				<div class="full"><button class="btn btn-p" type="submit">{ i18n.T(ctx, "photos.upload") }</button>
					<a class="btn btn-s" href={ "/work-orders/" + strconv.FormatInt(workOrderID, 10) }>{ i18n.T(ctx, "photos.back") }</a></div>
			</form>
		</div>
		<script src="/static/photo-markup.js"></script>
	}
}
