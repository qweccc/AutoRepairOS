package pages

import (
	"strconv"

	"autorepairos/internal/i18n"
	"autorepairos/internal/model"
	"autorepairos/web/components"
)

// EditVehiclePage 車輛編輯頁（對齊台灣行車執照格式）。
templ EditVehiclePage(v model.Vehicle, modelOptions, vehicleTypeOptions, fuelTypeOptions, bodyStyleOptions string, user model.User) {
	@components.Layout(i18n.T(ctx, "vehicle.edit_title")+" "+v.PlateNumber, "/vehicles", user, AppName) {
		<div class="card">
			<h2>{ i18n.T(ctx, "vehicle.edit_title") } { v.PlateNumber }</h2>
			<form class="frm" method="POST" action={ "/vehicles/" + strconv.FormatInt(v.ID, 10) }>
				@components.CSRFInput()
				@components.PlateScanUI(`{"plate_number":"plate_number","vin":"vin","engine_number":"engine_number","owner_name":"owner_name","owner_address":"owner_address","owner_id_number":"owner_id_number","displacement":"displacement","manufacture_date":"manufacture_date","license_issue_date":"license_issue_date","seating_capacity":"seating_capacity"}`)
				<label>{ i18n.T(ctx, "vehicle.customer") }<input name="customer_query" value={ v.CustomerName } required></label>
				<label>{ i18n.T(ctx, "vehicle.plate") }<input name="plate_number" value={ v.PlateNumber } required autocapitalize="characters" autocomplete="off"/></label>
				<label>{ i18n.T(ctx, "vehicle.brand_model") }
					<select name="brand_model" id="brandModelSel" required onchange="toggleModelOther()">
						@templ.Raw(modelOptions)
					</select>
				</label>
				<label id="brandModelOtherWrap" style="display:none">{ i18n.T(ctx, "vehicle.other_model") }
					<input name="brand_model_other" id="brandModelOther" placeholder={i18n.T(ctx, "vehicle.other_model_ph")}>
				</label>
				<label>{ i18n.T(ctx, "vehicle.vehicle_type") }<select name="vehicle_type">@templ.Raw(vehicleTypeOptions)</select></label>
				<label>{ i18n.T(ctx, "vehicle.fuel_type") }<select name="fuel_type">@templ.Raw(fuelTypeOptions)</select></label>
				<label>{ i18n.T(ctx, "vehicle.body_style") }<select name="body_style">@templ.Raw(bodyStyleOptions)</select></label>
				<label>{ i18n.T(ctx, "vehicle.driver") }<input name="driver_name" value={ v.DriverName } placeholder={i18n.T(ctx, "vehicle.driver_ph")}></label>
				<label>{ i18n.T(ctx, "vehicle.driver_phone") }<input name="driver_phone" value={ v.DriverPhone } placeholder={i18n.T(ctx, "vehicle.driver_phone_ph")}></label>
				<label>{ i18n.T(ctx, "vehicle.contact") }<input name="contact_name" value={ v.ContactName } placeholder={i18n.T(ctx, "vehicle.contact_ph")}></label>
				<label>{ i18n.T(ctx, "vehicle.contact_phone") }<input name="contact_phone" value={ v.ContactPhone } placeholder={i18n.T(ctx, "vehicle.contact_phone_ph")}></label>
				<label>{ i18n.T(ctx, "vehicle.owner") }<input name="owner_name" value={ v.OwnerName } placeholder={i18n.T(ctx, "vehicle.owner_ph")}></label>
				<label>{ i18n.T(ctx, "vehicle.owner_address") }<input name="owner_address" value={ v.OwnerAddress } placeholder={i18n.T(ctx, "vehicle.owner_address_ph")}></label>
				<label>{ i18n.T(ctx, "vehicle.owner_id") }<input name="owner_id_number" value={ v.OwnerIDNumber } placeholder={i18n.T(ctx, "vehicle.owner_id_ph")}></label>
				<label>{ i18n.T(ctx, "vehicle.license_expiry") }<input name="license_expiry_date" type="date" value={ v.LicenseExpiryDate }></label>
				<label>{ i18n.T(ctx, "vehicle.color") }<input name="color" value={ v.Color } placeholder={i18n.T(ctx, "vehicle.color_ph")}></label>
				<label>{ i18n.T(ctx, "vehicle.door_count") }<input name="door_count" type="number" min="0" max="10" value={ intOrBlank(v.DoorCount) }></label>
				<label>{ i18n.T(ctx, "vehicle.manufacture_date") }<input name="manufacture_date" placeholder={i18n.T(ctx, "vehicle.manufacture_date_ph")} value={ v.ManufactureDate }></label>
				<label>{ i18n.T(ctx, "vehicle.license_issue_date") }<input name="license_issue_date" placeholder={i18n.T(ctx, "vehicle.license_issue_date_ph")} value={ v.LicenseIssueDate }></label>
				<label>{ i18n.T(ctx, "vehicle.manufacture_year") }<input name="manufacture_year" type="number" min="0" max="9999" value={ intOrBlank(v.ManufactureYear) }></label>
				<label>{ i18n.T(ctx, "vehicle.displacement") }<input name="displacement" type="number" min="0" placeholder="c.c." value={ intOrBlank(v.Displacement) }></label>
				<label>{ i18n.T(ctx, "vehicle.seating") }<input name="seating_capacity" type="number" min="0" max="99" value={ intOrBlank(v.SeatingCapacity) }></label>
				<label>{ i18n.T(ctx, "vehicle.curb_weight") }<input name="curb_weight" type="number" min="0" placeholder="kg" value={ intOrBlank(v.CurbWeight) }></label>
				<label>{ i18n.T(ctx, "vehicle.gross_weight") }<input name="gross_weight" type="number" min="0" placeholder="kg" value={ intOrBlank(v.GrossWeight) }></label>
				<label>{ i18n.T(ctx, "vehicle.tire_size") }<input name="tire_size" placeholder={i18n.T(ctx, "vehicle.tire_size_ph")} value={ v.TireSize }></label>
				<label>{ i18n.T(ctx, "vehicle.wheelbase") }<input name="wheelbase" type="number" min="0" placeholder="mm" value={ intOrBlank(v.Wheelbase) }></label>
				<label>{ i18n.T(ctx, "vehicle.vin") }<input name="vin" value={ v.VIN }></label>
				<label>{ i18n.T(ctx, "vehicle.engine_number") }<input name="engine_number" value={ v.EngineNumber }></label>
				<label>{ i18n.T(ctx, "vehicle.inspection_due") }<input name="inspection_due_date" type="date" value={ v.InspectionDueDate }></label>
				<label>{ i18n.T(ctx, "vehicle.last_maintenance_date") }<input name="last_maintenance_date" type="date" value={ v.LastMaintenanceDate }></label>
				<label>{ i18n.T(ctx, "vehicle.last_maintenance_mileage") }<input name="last_maintenance_mileage" type="number" min="0" value={ intOrBlank(v.LastMaintenanceMileage) }></label>
				<label>{ i18n.T(ctx, "vehicle.maint_interval_months") }<input name="maint_interval_months" type="number" min="1" max="60" value={ strconv.Itoa(v.MaintIntervalMonths) }></label>
				<label>{ i18n.T(ctx, "vehicle.maint_interval_km") }<input name="maint_interval_km" type="number" min="500" value={ strconv.Itoa(v.MaintIntervalKm) }></label>
				<div class="full"><button class="btn btn-p" type="submit">{ i18n.T(ctx, "vehicle.save") }</button> <a class="btn btn-s" href="/vehicles">{ i18n.T(ctx, "vehicle.cancel") }</a></div>
			</form>
			<script>
				function toggleModelOther(){
					var sel = document.getElementById('brandModelSel');
					var wrap = document.getElementById('brandModelOtherWrap');
					var other = document.getElementById('brandModelOther');
					if (!sel || !wrap) return;
					var isOther = sel.value === '__OTHER__';
					wrap.style.display = isOther ? '' : 'none';
					if (other) other.disabled = !isOther;
					if (isOther) {
						sel.removeAttribute('name');
						if (other) { other.setAttribute('name','brand_model'); other.required = true; }
					} else {
						sel.setAttribute('name','brand_model');
						if (other) { other.removeAttribute('name'); other.required = false; }
					}
				}
			</script>
		</div>
	}
}

// NewVehiclePage 車輛新增頁（對齊台灣行車執照格式）。
templ NewVehiclePage(customerName string, modelOptions, vehicleTypeOptions, fuelTypeOptions, bodyStyleOptions string, user model.User) {
	@components.Layout(i18n.T(ctx, "vehicle.new_title"), "/vehicles", user, AppName) {
		<div class="card">
			<h2>{ i18n.T(ctx, "vehicle.new_title") }</h2>
			<form class="frm" method="POST" action="/vehicles">
				@components.CSRFInput()
				@components.PlateScanUI(`{"plate_number":"plate_number","vin":"vin","engine_number":"engine_number","owner_name":"owner_name","owner_address":"owner_address","owner_id_number":"owner_id_number","displacement":"displacement","manufacture_date":"manufacture_date","license_issue_date":"license_issue_date","seating_capacity":"seating_capacity"}`)
				<label>{ i18n.T(ctx, "vehicle.customer") }<input name="customer_query" required></label>
				<label>{ i18n.T(ctx, "vehicle.plate") }<input name="plate_number" required autocapitalize="characters" autocomplete="off"/></label>
				<label>{ i18n.T(ctx, "vehicle.brand_model") }
					<select name="brand_model" id="brandModelSel" required onchange="toggleModelOther()">
						@templ.Raw(modelOptions)
					</select>
				</label>
				<label id="brandModelOtherWrap" style="display:none">{ i18n.T(ctx, "vehicle.other_model") }
					<input name="brand_model_other" id="brandModelOther" placeholder={i18n.T(ctx, "vehicle.other_model_ph")}>
				</label>
				<label>{ i18n.T(ctx, "vehicle.vehicle_type") }<select name="vehicle_type">@templ.Raw(vehicleTypeOptions)</select></label>
				<label>{ i18n.T(ctx, "vehicle.fuel_type") }<select name="fuel_type">@templ.Raw(fuelTypeOptions)</select></label>
				<label>{ i18n.T(ctx, "vehicle.body_style") }<select name="body_style">@templ.Raw(bodyStyleOptions)</select></label>
				<label>{ i18n.T(ctx, "vehicle.driver") }<input name="driver_name" placeholder={i18n.T(ctx, "vehicle.driver_ph")}></label>
				<label>{ i18n.T(ctx, "vehicle.driver_phone") }<input name="driver_phone" placeholder={i18n.T(ctx, "vehicle.driver_phone_ph")}></label>
				<label>{ i18n.T(ctx, "vehicle.contact") }<input name="contact_name" placeholder={i18n.T(ctx, "vehicle.contact_ph")}></label>
				<label>{ i18n.T(ctx, "vehicle.contact_phone") }<input name="contact_phone" placeholder={i18n.T(ctx, "vehicle.contact_phone_ph")}></label>
				<label>{ i18n.T(ctx, "vehicle.owner") }<input name="owner_name" placeholder={i18n.T(ctx, "vehicle.owner_ph")}></label>
				<label>{ i18n.T(ctx, "vehicle.owner_address") }<input name="owner_address" placeholder={i18n.T(ctx, "vehicle.owner_address_ph")}></label>
				<label>{ i18n.T(ctx, "vehicle.owner_id") }<input name="owner_id_number" placeholder={i18n.T(ctx, "vehicle.owner_id_ph")}></label>
				<label>{ i18n.T(ctx, "vehicle.license_expiry") }<input name="license_expiry_date" type="date"></label>
				<label>{ i18n.T(ctx, "vehicle.color") }<input name="color" placeholder={i18n.T(ctx, "vehicle.color_ph")}></label>
				<label>{ i18n.T(ctx, "vehicle.door_count") }<input name="door_count" type="number" min="0" max="10" placeholder={i18n.T(ctx, "vehicle.door_count_ph")}></label>
				<label>{ i18n.T(ctx, "vehicle.manufacture_date") }<input name="manufacture_date" placeholder={i18n.T(ctx, "vehicle.manufacture_date_ph")}></label>
				<label>{ i18n.T(ctx, "vehicle.license_issue_date") }<input name="license_issue_date" placeholder={i18n.T(ctx, "vehicle.license_issue_date_ph")}></label>
				<label>{ i18n.T(ctx, "vehicle.manufacture_year") }<input name="manufacture_year" type="number" min="0" max="9999" placeholder={i18n.T(ctx, "vehicle.manufacture_year_ph")}></label>
				<label>{ i18n.T(ctx, "vehicle.displacement") }<input name="displacement" type="number" min="0" placeholder="c.c."></label>
				<label>{ i18n.T(ctx, "vehicle.seating") }<input name="seating_capacity" type="number" min="0" max="99" placeholder={i18n.T(ctx, "vehicle.seating_ph")}></label>
				<label>{ i18n.T(ctx, "vehicle.curb_weight") }<input name="curb_weight" type="number" min="0" placeholder="kg"></label>
				<label>{ i18n.T(ctx, "vehicle.gross_weight") }<input name="gross_weight" type="number" min="0" placeholder="kg"></label>
				<label>{ i18n.T(ctx, "vehicle.tire_size") }<input name="tire_size" placeholder={i18n.T(ctx, "vehicle.tire_size_ph")}></label>
				<label>{ i18n.T(ctx, "vehicle.wheelbase") }<input name="wheelbase" type="number" min="0" placeholder="mm"></label>
				<label>{ i18n.T(ctx, "vehicle.vin") }<input name="vin" placeholder={i18n.T(ctx, "vehicle.vin_ph")}></label>
				<label>{ i18n.T(ctx, "vehicle.engine_number") }<input name="engine_number"></label>
				<label>{ i18n.T(ctx, "vehicle.inspection_due") }<input name="inspection_due_date" type="date"></label>
				<label>{ i18n.T(ctx, "vehicle.maint_interval_months") }<input name="maint_interval_months" type="number" min="1" max="60" value="6"></label>
				<label>{ i18n.T(ctx, "vehicle.maint_interval_km") }<input name="maint_interval_km" type="number" min="500" value="5000"></label>
				<div class="full"><button class="btn btn-p" type="submit">{ i18n.T(ctx, "vehicle.create") }</button> <a class="btn btn-s" href="/vehicles">{ i18n.T(ctx, "vehicle.cancel") }</a></div>
			</form>
			<script>
				function toggleModelOther(){
					var sel = document.getElementById('brandModelSel');
					var wrap = document.getElementById('brandModelOtherWrap');
					var other = document.getElementById('brandModelOther');
					if (!sel || !wrap) return;
					var isOther = sel.value === '__OTHER__';
					wrap.style.display = isOther ? '' : 'none';
					if (other) other.disabled = !isOther;
					if (isOther) {
						sel.removeAttribute('name');
						if (other) { other.setAttribute('name','brand_model'); other.required = true; }
					} else {
						sel.setAttribute('name','brand_model');
						if (other) { other.removeAttribute('name'); other.required = false; }
					}
				}
			</script>
		</div>
	}
}

func intOrBlank(n int) string {
	if n == 0 {
		return ""
	}
	return strconv.Itoa(n)
}
