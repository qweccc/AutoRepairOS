package pages

import (
	"fmt"
	"strconv"

	"autorepairos/internal/i18n"
	"autorepairos/internal/model"
	"autorepairos/web/components"
)

type SubcontractRow struct {
	ID           int64
	WorkOrderID  int64
	SupplierName string
	Description  string
	CostAmount   float64
	ChargeAmount float64
	Status       string
	StatusLabel  string
	StatusPill   string
}

// ListSubcontractsPage 外包加工列表頁（HTMX 即時搜尋）。
templ ListSubcontractsPage(rows []SubcontractRow, total, page, size int, q, status string,
	supplierOpts string, user model.User) {
	@components.Layout(i18n.T(ctx, "subcontract.title"), "/subcontracts", user, AppName) {
		<div class="card">
			<h2>{ i18n.T(ctx, "subcontract.new") }</h2>
			<form class="frm" method="POST" action="/subcontracts">
				@components.CSRFInput()
				<label>{ i18n.T(ctx, "subcontract.field.workorder") }<input type="number" name="work_order_id" required></label>
				<label>{ i18n.T(ctx, "subcontract.field.supplier") }
					<select name="supplier_id">
						<option value="">{ i18n.T(ctx, "subcontract.unspecified") }</option>
						@templ.Raw(supplierOpts)
					</select>
				</label>
				<label class="full">{ i18n.T(ctx, "subcontract.field.description") }<input name="description" required></label>
				<label>{ i18n.T(ctx, "subcontract.field.cost") }<input type="number" step="0.01" name="cost_amount" value="0"></label>
				<label>{ i18n.T(ctx, "subcontract.field.charge") }<input type="number" step="0.01" name="charge_amount" value="0"></label>
				<label>{ i18n.T(ctx, "subcontract.field.expected") }<input type="date" name="expected_date"></label>
				<label>{ i18n.T(ctx, "estimates.field.status") }
					<select name="status">
						<option value="pending">{ i18n.T(ctx, "subcontract.status_pending") }</option>
						<option value="in_progress">{ i18n.T(ctx, "subcontract.status_in_progress") }</option>
						<option value="completed">{ i18n.T(ctx, "subcontract.status_completed") }</option>
					</select>
				</label>
				<label class="full">{ i18n.T(ctx, "common.notes") }<textarea name="notes"></textarea></label>
				<div class="full"><button class="btn btn-p" type="submit">{ i18n.T(ctx, "subcontract.create") }</button></div>
			</form>
		</div>
		<div class="card">
			<h2>{ fmt.Sprintf(i18n.T(ctx, "subcontract.list_heading"), total) }</h2>
			<input type="search" name="q" value={ q }
				placeholder={ i18n.T(ctx, "subcontract.search_ph") }
				hx-get="/api/subcontracts/search"
				hx-trigger="keyup changed delay:300ms, search"
				hx-target="#subcontract-rows"
				hx-swap="innerHTML"
				style="padding:8px 10px;border-radius:7px;border:1px solid var(--border);background:var(--surface);color:var(--text);width:260px;margin-bottom:12px">
			<table>
				<tr>
					<th>ID</th><th>{ i18n.T(ctx, "subcontract.field.workorder_th") }</th><th>{ i18n.T(ctx, "subcontract.field.vendor_th") }</th><th>{ i18n.T(ctx, "subcontract.field.content_th") }</th><th class="num">{ i18n.T(ctx, "subcontract.field.cost_th") }</th>
					<th class="num">{ i18n.T(ctx, "subcontract.field.charge_th") }</th><th class="num">{ i18n.T(ctx, "subcontract.field.margin_th") }</th><th>{ i18n.T(ctx, "estimates.field.status") }</th><th>{ i18n.T(ctx, "insurancelist.field.actions") }</th>
				</tr>
				<tbody id="subcontract-rows">
					for _, s := range rows {
						@SubcontractRowContent(s)
					}
				</tbody>
			</table>
			if len(rows) == 0 {
				<div class="empty">{ i18n.T(ctx, "subcontract.empty") }</div>
			}
			@components.Pager("/subcontracts", page, calcPages(total, size), total)
		</div>
	}
}

templ SubcontractRowContent(s SubcontractRow) {
	{{ margin := s.ChargeAmount - s.CostAmount }}
	<tr>
		<td>{ strconv.FormatInt(s.ID, 10) }</td>
		<td>#{ strconv.FormatInt(s.WorkOrderID, 10) }</td>
		<td>{ s.SupplierName }</td>
		<td>{ s.Description }</td>
		<td class="num">{ moneyFmt(s.CostAmount) }</td>
		<td class="num">{ moneyFmt(s.ChargeAmount) }</td>
		<td class="num">{ moneyFmt(margin) }</td>
		<td><span class={ "pill " + s.StatusPill }>{ s.StatusLabel }</span></td>
		<td>
			<a class="btn btn-s" href={ "/subcontracts/" + strconv.FormatInt(s.ID, 10) + "/edit" }>{ i18n.T(ctx, "common.edit") }</a>
			<a class="btn btn-d" href={ "/subcontracts/" + strconv.FormatInt(s.ID, 10) + "/delete" }
				hx-post={ "/subcontracts/" + strconv.FormatInt(s.ID, 10) + "/delete" }
				data-confirm={ i18n.T(ctx, "subcontract.delete_confirm") }>{ i18n.T(ctx, "common.delete") }</a>
		</td>
	</tr>
}

// SubcontractSearchRows HTMX 即時搜尋回傳的純列。
templ SubcontractSearchRows(rows []SubcontractRow) {
	if len(rows) == 0 {
		<tr><td colspan="9" style="color:var(--muted);text-align:center;padding:20px">{ i18n.T(ctx, "subcontract.search_empty") }</td></tr>
	}
	for _, s := range rows {
		@SubcontractRowContent(s)
	}
}

var _ = model.Subcontract{}
