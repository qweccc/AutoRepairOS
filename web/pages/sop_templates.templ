package pages

import (
	"fmt"
	"strconv"

	"autorepairos/internal/i18n"
	"autorepairos/internal/model"
	"autorepairos/web/components"
)

type SOPTemplateEditItem struct {
	ID          int64
	Description string
	Required    bool
	SortOrder   int
}

type SOPTemplateEditData struct {
	ID         int64
	Name       string
	RepairType string
	Items      []SOPTemplateEditItem
	User       model.User
}

type SOPTemplateListRow struct {
	ID         int64
	Name       string
	RepairType string
	ItemCount  int
}

type SOPTemplateListData struct {
	Rows  []SOPTemplateListRow
	Query string
	User  model.User
	Flash string
}

templ ListSOPTemplatesPage(data SOPTemplateListData) {
	{{ user := data.User }}
	@components.Layout(i18n.T(ctx, "sop.title"), "/sop-templates", user, AppName) {
		@components.FlashMsg(data.Flash)
		<div class="card">
			<h2>{ fmt.Sprintf(i18n.T(ctx, "sop.list_heading"), len(data.Rows)) }</h2>
			<p style="color:var(--text-sub);font-size:13.5px;margin:0 0 14px">
				{ i18n.T(ctx, "sop.intro") }
			</p>
			<form method="GET" action="/sop-templates" style="margin-bottom:12px">
				<input name="q" value={ data.Query } placeholder={ i18n.T(ctx, "sop.search_ph") } style="padding:8px 10px;border-radius:7px;border:1px solid var(--border);background:var(--surface);color:var(--text);width:280px">
				<button class="btn btn-p" type="submit">{ i18n.T(ctx, "common.search") }</button>
				<a class="btn btn-s" href="/sop-templates">{ i18n.T(ctx, "common.clear") }</a>
				<a class="btn btn-p" href="/sop-templates/new">{ i18n.T(ctx, "sop.new") }</a>
			</form>
			if len(data.Rows) == 0 {
				<div class="empty">{ i18n.T(ctx, "sop.empty") }</div>
			} else {
				<table><tr><th>{ i18n.T(ctx, "sop.field.name") }</th><th>{ i18n.T(ctx, "sop.field.repair_type") }</th><th class="num">{ i18n.T(ctx, "sop.field.item_count") }</th><th>{ i18n.T(ctx, "equipmaint.field.actions") }</th></tr>
					for _, row := range data.Rows {
						<tr>
							<td><b>{ row.Name }</b></td>
							<td>{ row.RepairType }</td>
							<td class="num">{ strconv.Itoa(row.ItemCount) }</td>
							<td>
								<a class="btn btn-p" href={ "/sop-templates/" + strconv.FormatInt(row.ID, 10) + "/edit" }>{ i18n.T(ctx, "common.edit") }</a>
								<form method="POST" action={ "/sop-templates/" + strconv.FormatInt(row.ID, 10) + "/delete" } style="display:inline" onsubmit="return confirm('確定刪除？')">
									@components.CSRFInput()
									<button class="btn btn-d" type="submit">{ i18n.T(ctx, "common.delete") }</button>
								</form>
							</td>
						</tr>
					}
				</table>
			}
		</div>
	}
}

templ NewSOPTemplatePage(user model.User) {
	@components.Layout(i18n.T(ctx, "sop.new_title"), "/sop-templates", user, AppName) {
		<div class="card">
			<h2>{ i18n.T(ctx, "sop.new_title") }</h2>
			<form class="frm" method="POST" action="/sop-templates">
				@components.CSRFInput()
				<label>{ i18n.T(ctx, "sop.field.template_name") }<input name="name" required placeholder={ i18n.T(ctx, "sop.name_ph") }></label>
				<label>{ i18n.T(ctx, "sop.field.repair_type") }<input name="repair_type" placeholder={ i18n.T(ctx, "sop.repair_type_ph") }></label>
				<div class="full">
					<button class="btn btn-p" type="submit">{ i18n.T(ctx, "sop.create") }</button>
					<a class="btn btn-s" href="/sop-templates">{ i18n.T(ctx, "common.cancel") }</a>
				</div>
			</form>
		</div>
	}
}

templ EditSOPTemplatePage(data SOPTemplateEditData) {
	{{ user := data.User }}
	{{ items := data.Items }}
	@components.Layout(i18n.T(ctx, "sop.edit_title"), "/sop-templates", user, AppName) {
		<div class="card">
			<h2>{ data.Name }</h2>
			<form class="frm" method="POST" action={ "/sop-templates/" + strconv.FormatInt(data.ID, 10) }>
				@components.CSRFInput()
				<label>{ i18n.T(ctx, "sop.field.template_name") }<input name="name" value={ data.Name } required></label>
				<label>{ i18n.T(ctx, "sop.field.repair_type") }<input name="repair_type" value={ data.RepairType }></label>
				<div class="full">
					<button class="btn btn-p" type="submit">{ i18n.T(ctx, "common.save") }</button>
					<a class="btn btn-s" href="/sop-templates">{ i18n.T(ctx, "common.cancel") }</a>
				</div>
			</form>
		</div>
		<div class="card">
			<h2>{ fmt.Sprintf(i18n.T(ctx, "sop.items_heading"), len(items)) }</h2>
			<form class="frm" method="POST" action={ "/sop-templates/" + strconv.FormatInt(data.ID, 10) + "/items" }>
				@components.CSRFInput()
				<table>
					<tr><th>{ i18n.T(ctx, "sop.field.required") }</th><th>{ i18n.T(ctx, "sop.items_title") }</th></tr>
					for _, item := range items {
						<tr>
							<td style="text-align:center">
								<input type="hidden" name="item_id" value={ strconv.FormatInt(item.ID, 10) }>
								<input type="checkbox" name="required" value="1" checked?={ item.Required }>
							</td>
							<td><input name="item_desc" value={ item.Description } placeholder={ i18n.T(ctx, "sop.item_desc_ph") }></td>
						</tr>
					}
					<tr>
						<td style="text-align:center"><input type="checkbox" name="required" value="1"></td>
						<td><input name="item_desc" placeholder={ i18n.T(ctx, "sop.new_item_ph") }></td>
					</tr>
				</table>
				<div class="full">
					<button class="btn btn-p" type="submit">{ i18n.T(ctx, "sop.save_items") }</button>
				</div>
			</form>
		</div>
	}
}
