# ===== AutoRepairOS 安裝設定 =====
# 每家車廠請使用不同的 COMPOSE_PROJECT_NAME，讓 Docker 建立隔離的服務與資料 volume。
COMPOSE_PROJECT_NAME=autorepairos
HOST_PORT=8090
# APP_NAME 在下面「軟體名稱」區塊設定（原本這裡有一份重複的，已移除）。

# 第一次啟動需設定管理員密碼並啟用 RUN_SEED=true。
# 管理員帳號只在資料庫尚未建立該帳號時建立；請勿使用公開範例密碼。
RUN_SEED=true
DEFAULT_OWNER_USERNAME=owner
DEFAULT_OWNER_PASSWORD=
# 櫃檯/技師帳號為選填；未設定密碼時不會建立。
DEFAULT_COUNTER_USERNAME=counter
DEFAULT_COUNTER_PASSWORD=
DEFAULT_TECH_USERNAME=tech
DEFAULT_TECH_PASSWORD=

# ===== LINE Messaging API =====
# 複製成 .env 後填入實際值。.env 已被 .gitignore 排除，不會進版控。
#
# Channel ID 與 secret 在 LINE Developers → 你的頻道 → Messaging API Channel
# → 基本設定。Access token 在同一頁的「Messaging API」區塊，選 long-lived。
#
# 取得客戶的 LINE user ID：讓客戶加好友後，在 webhook 收到 from.id，
# 或用「傳送訊息給我」的訊息記錄。三者缺一不可。

LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_TOKEN=

# LINE_BASE_URL 可覆寫，無公開 IP 但有內網穿透時指向自己的網址
# LINE_BASE_URL=https://api.line.me

# LINE_WEBHOOK_PUBLIC_URL：這個服務對外的完整 webhook 網址（含路徑）。
# 填了之後啟動 log 會印出來，方便確認 LINE Developers 後台的設定是否一致。
# 注意：trycloudflare.com 之類的臨時網址在 cloudflared 重啟後會改變，
# 正式營運請改用自有網域並更新這裡。
# LINE_WEBHOOK_PUBLIC_URL=https://<hostname>/webhook/line

# 推播失敗時是否記錄到 log。true = 只記錄不重試（預設）
# LINE_STRICT_DELIVERY=false

# ===== Telegram Bot（內部通知，預設通道）=====
# 為什麼用 Telegram 當內部通知預設：
#   1. 設定最輕 —— 跟 @BotFather 對話 2 分鐘拿 token，不需商業驗證、
#      不需專用電話號碼、不需訊息範本審核
#   2. 免費無則數上限（LINE 免費方案只有 200 則/月主動推播）
#   3. 適合系統告警、每日營收、待辦提醒給老闆與員工看
# 客戶通知仍以 LINE 為主（台灣車行客戶 LINE 覆蓋率 >90%），
# Telegram 是「發給自己人」用的。
#
# 取得方式：
#   1. Telegram 搜尋 @BotFather → 傳 /newbot → 取名字
#   2. 拿到 token（格式 123456789:AAH...）填到 TELEGRAM_BOT_TOKEN
#   3. 對你的 bot 傳任意一句話（例如 hi），讓它能看到你
#   4. 瀏覽器開：https://api.telegram.org/bot<你的TOKEN>/getUpdates
#      在回傳 JSON 找 "chat":{"id":123456789} → 填到 TELEGRAM_CHAT_ID
#
# 留空 = MOCK 模式：只寫 log 不外送，服務照常運作。

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 預設官方端點，有自架 proxy 才需要覆寫
# TELEGRAM_BASE_URL=https://api.telegram.org

# ===== 軟體名稱 =====
# 顯示在頁面標題、登入頁、收據、Telegram 每日摘要等處。
# 部署時可改為客戶品牌名稱（例如「XX車行維修管理系統」）。
APP_NAME=AutoRepair OS

# ===== 資料庫 =====
# DB_PATH 可覆寫資料庫位置。Docker 部署時建議用絕對路徑。
# DB_PATH=file:data/autorepair.db?_busy_timeout=5000

# ===== WAL 模式 =====
# 預設開啟。WAL 讓讀寫不互斥（SQLite 單寫者限制下讀取不被寫入阻塞），
# 車廠同時有櫃檯開單、技師記工時、報表查詢時特別有感。
#
# 本檔是 Docker 與本機 exe 共用的唯一設定來源：
#   - Docker：compose 解析 ${VAR} 時會先讀這個檔
#   - 本機 exe：config.Load() 現在也會載入它（程式開頭）
# 兩邊讀同一份，不會出現「改了沒生效」。
#
# 已存在的環境變數優先，不會被本檔覆蓋 —— Docker 注入的或 shell 設定的都贏。
#
# 曾經預設關閉，理由是「Windows bind-mount 下 WAL 會 disk I/O error (4618)」。
# 該理由已不成立：掛載早就改成 named volume，且實測一般 Windows 目錄下
# PRAGMA journal_mode=WAL 正常。真要關掉（例如放在網路磁碟上）設為 false。
# DB_ENABLE_WAL=true
# ===== 視覺辨識（行照/車牌拍照自動填入）=====
# 分層混合策略：VISION_MODE=cloud 走外部 AI Vision API（準確率最高，需連網）；
# VISION_MODE=local 走區網本地 API（完全離線，車廠自架 AI 伺服器）。
# 兩者皆未設定 → 功能停用（車輛表單不出現拍照鈕）。

# --- 模式切換 ---
# cloud = 外部 API（預設）；local = 區網本地 API
VISION_MODE=cloud

# --- cloud 模式：外部 AI Vision API（OpenAI 相容 /v1/chat/completions 端點）---
# Gemini OpenAI 相容端點範例：
#   VISION_API_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   VISION_API_KEY=<你的 Gemini API key>
#   VISION_MODEL=gemini-2.0-flash
VISION_API_URL=
VISION_API_KEY=
VISION_MODEL=

# --- local 模式：區網本地視覺 API（完全離線）---
# 車廠在區網架一台 AI 伺服器（Ollama+LLaVA、PaddleOCR 等），
# 包成 POST {image_base64} → 回傳 JSON（欄位見 internal/integration/vision）。
# 指向該服務的 base URL（程式會自動加 /recognize）：
VISION_LOCAL_URL=

# --- local 模式：llama.cpp 自動開關（Qwen2.5-VL-3B，winget 裝的 llama-server）---
# VISION_AUTOSTART=true 時：辨識時若服務沒開，後端自動背景啟動 llama-server，
# 載入完成（CPU 上約 10-60 秒）才回傳；用完閒置 VISION_IDLE_MINUTES 分鐘自動關掉程序。
# 車行人員不必手動開 LLM。false 時服務沒開只回錯誤（使用者須自己跑 start-qwen-vision.bat）。
VISION_AUTOSTART=true

# 閒置幾分鐘後自動關閉 llama-server（預設 10）。連續辨識會自動延後關閉時間。
VISION_IDLE_MINUTES=10

# 自動啟動時載入的模型（llama-server -hf 規格）。已下載至 llama.cpp cache 的：
#   unsloth/Qwen2.5-VL-3B-Instruct-GGUF:Q4_K_M
VISION_HF_MODEL=unsloth/Qwen2.5-VL-3B-Instruct-GGUF:Q4_K_M

# --- 離線優先：直接吃本機已下載的 GGUF（有值就優先於上面的 -hf 規格）---
# 用 -hf 規格開機時會連 HuggingFace 驗證，防火牆/離線環境會卡住；
# 指定本機已下載的 .gguf 就完全不碰網路。
#
# 支援三種寫法（HuggingFace 快取的 snapshots/<hash> 每台機器都不一樣，
# 硬寫完整路徑沒辦法跨機器複製，所以建議用下面第 2 或第 3 種）：
#   1. 完整檔案路徑：
#      VISION_MODEL_PATH=C:\Users\<你>\.cache\huggingface\hub\models--unsloth--Qwen2.5-VL-3B-Instruct-GGUF\snapshots\<hash>\Qwen2.5-VL-3B-Instruct-Q4_K_M.gguf
#   2. 萬用字元（hash 用 * 取代，最推薦）：
#      VISION_MODEL_PATH=C:\Users\<你>\.cache\huggingface\hub\models--unsloth--Qwen2.5-VL-3B-Instruct-GGUF\snapshots\*\Qwen2.5-VL-3B-Instruct-Q4_K_M.gguf
#   3. 只給目錄（自動挑裡面最大的 .gguf 當主模型）：
#      VISION_MODEL_PATH=C:\Users\<你>\.cache\huggingface\hub\models--unsloth--Qwen2.5-VL-3B-Instruct-GGUF\snapshots\<hash>
#
# 視覺模型還要有 mmproj 投影檔，否則只會被當文字模型用（回傳空 JSON）。
# 留空即可：會自動在主模型所在目錄找 mmproj*.gguf（HF 快取兩者一定並存）。
# 只有投影檔不在同一目錄時才需要手動指定：
# VISION_MMPROJ_PATH=C:\Users\<你>\.cache\huggingface\hub\models--unsloth--Qwen2.5-VL-3B-Instruct-GGUF\snapshots\<hash>\mmproj-BF16.gguf

# ===== Docker 模式專用（exe 模式不用設，上面區塊就是 exe 用的）=====
# 雙模式分工：上面的 VISION_* 給 Windows exe 用（127.0.0.1:8092 本機 llama-server）；
# Docker 容器裡由 docker-compose.yml 用這組 _DOCKER 變數覆寫，預設指向 compose 內的
# ollama 服務（http://ollama:11434）與模型 qwen2.5vl:3b。
# 首次使用 Docker 視覺辨識要先拉模型（約 3GB）：
#   docker exec -it ollama_local ollama pull qwen2.5vl:3b
# 或直接互動執行：docker exec -it ollama_local ollama run qwen2.5vl:3b
# 只有想改預設值時才需要取消註解：
# VISION_LOCAL_URL_DOCKER=http://ollama:11434
# VISION_AUTOSTART_DOCKER=false
# VISION_MODEL_DOCKER=qwen2.5vl:3b
